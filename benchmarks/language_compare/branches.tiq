// BENCH_ITERATIONS=5000000 BENCH_EXPECTED=37816615
state <- 1
checksum <- 0
[i <- 0..5000000] {
    state <- (state * 48271) % 2147483647
    state % 7 < 3 ? { checksum <- (checksum + state % 1000) % 1000000007 }
    state % 7 >= 3 && state % 11 < 5 ? { checksum <- (checksum * 3 + state % 97) % 1000000007 }
    state % 7 >= 3 && state % 11 >= 5 ? { checksum <- (checksum + i % 31) % 1000000007 }
}
print(checksum)
