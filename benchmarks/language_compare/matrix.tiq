// BENCH_ITERATIONS=20 BENCH_EXPECTED=362194569
a <- [0; 4096]
b <- [0; 4096]
[i <- 0..4096] {
    a[i] <- (i * 17 + 3) % 101
    b[i] <- (i * 29 + 7) % 103
}
checksum <- 0
[rep <- 0..20, i <- 0..64, j <- 0..64] {
    cell <- 0
    [k <- 0..64] { cell += a[i * 64 + k] * b[k * 64 + j] }
    checksum <- (checksum + cell % 1000003) % 1000000007
}
print(checksum)
