// std/math.tiq: core numeric library written in Tiq
//
// Import:
//   import "std/math.tiq"
//
// The module wraps no compiler builtins, so it is not gated: nothing has to be
// imported before a name becomes reachable (LANGUAGE_SPEC §17.7). It uses no
// extern "C", so nothing links against libm.
//
// Only `enum` and function definitions may appear at top level — a top-level
// binding in an imported module is emitted into the caller's main, so a
// constant written that way would not be visible to these functions.
//
// Two rules hold every function down to a bounded, trap-free execution:
//   - each loop carries an explicit iteration cap, because with NaN and
//     infinity a comparison-only exit can spin forever;
//   - each f64 -> i64 conversion is range-guarded, because out-of-range
//     conversion is undefined on some hosts and traps on wasm.

// --- i64 magnitude and bounds ---

// INT64_MIN has no positive i64 representative, so it maps to itself. The
// guard also keeps `0 - x` out of signed overflow. The literal is spelled with
// arithmetic because a bare 9223372036854775808 is out of i64 range.
math_abs x:i64 : i64 -> { x < 0 ? (x == 0 - 9223372036854775807 - 1 ? x : 0 - x) : x }

math_sign x:i64 : i64 -> { x < 0 ? 0 - 1 : x > 0 ? 1 : 0 }

math_min a:i64 b:i64 : i64 -> { a < b ? a : b }

math_max a:i64 b:i64 : i64 -> { a > b ? a : b }

// Out-of-range lo/hi is not an error: the upper bound wins.
math_clamp x:i64 lo:i64 hi:i64 : i64 -> { math_min(math_max(x, lo), hi) }

// --- i64 division ---

// Euclidean remainder: always in [0, |b|). Returns 0 when b == 0 and -1 when
// |b| is not representable, i.e. b == INT64_MIN.
math_mod a:i64 b:i64 : i64 -> {
    d = math_abs(b)
    r <- 0 - 1
    d == 0 ? { r <- 0 }
    d > 0 ? {
        m <- a % d
        r <- m < 0 ? m + d : m
    }
    r
}

// Quotient paired with math_mod so that math_div(a, b) * b + math_mod(a, b)
// == a: the remainder is non-negative, so for a negative divisor the quotient
// is the negated floor rather than the floor itself. Returns 0 when b == 0 and
// -1 when the true quotient or |b| is not representable.
math_div a:i64 b:i64 : i64 -> {
    d = math_abs(b)
    q <- 0 - 1
    b == 0 ? { q <- 0 }
    d > 0 ? {
        t <- a / d
        r <- a - t * d
        t <- r < 0 ? t - 1 : t
        b > 0 ? { q <- t }
        b < 0 ? { q <- t == 0 - 9223372036854775807 - 1 ? 0 - 1 : 0 - t }
    }
    q
}

math_gcd a:i64 b:i64 : i64 -> {
    x <- math_abs(a)
    y <- math_abs(b)
    s <- 0
    (x == 0 - 9223372036854775807 - 1 || y == 0 - 9223372036854775807 - 1) ? {
        x <- 0 - 1
        y <- 0
    }
    [y != 0 && s < 92] {
        t <- x % y
        x <- y
        y <- t
        s <- s + 1
    }
    x
}

// -1 when either argument is INT64_MIN, or when the true lcm does not fit.
math_lcm a:i64 b:i64 : i64 -> {
    m = 0 - 9223372036854775807 - 1
    r <- 0 - 1
    a != m && b != m ? {
        x = math_abs(a)
        y = math_abs(b)
        (x == 0 || y == 0) ? { r <- 0 }
        x > 0 && y > 0 ? {
            g = math_gcd(x, y)
            q = x / g
            r <- q > 9223372036854775807 / y ? 0 - 1 : q * y
        }
    }
    r
}

// --- i64 powers, bit width, and primality ---

// Floor of the exact square root, or -1 for a negative argument. The search
// ceiling is floor(sqrt(INT64_MAX)) so `mid * mid` always stays in range.
math_isqrt x:i64 : i64 -> {
    r <- 0 - 1
    x >= 0 ? {
        lo <- 0
        hi <- x < 3037000499 ? x : 3037000499
        best <- 0
        s <- 0
        [lo <= hi && s < 64] {
            mid <- lo + (hi - lo) / 2
            mid * mid <= x ? {
                best <- mid
                lo <- mid + 1
            }
            mid * mid > x ? { hi <- mid - 1 }
            s <- s + 1
        }
        r <- best
    }
    r
}

// Internal: product of two non-negative magnitudes, or -1 when the product
// does not fit in i64.
math_mul_pos a:i64 b:i64 : i64 -> { a > 0 && b > 9223372036854775807 / a ? 0 - 1 : a * b }

// base raised to a non-negative exponent, with 0 ** 0 == 1. Returns -1 for a
// negative exponent, a base of INT64_MIN, or overflow. -1 is also a legitimate
// result (pow(-1, 3)) and the module has no second channel to tell them apart.
math_pow base:i64 exp:i64 : i64 -> {
    m = 0 - 9223372036854775807 - 1
    r <- 0 - 1
    exp >= 0 && base != m ? {
        acc <- 1
        b <- math_abs(base)
        e <- exp
        neg <- exp > 0 && base < 0 && exp % 2 != 0 ? 1 : 0
        s <- 0
        [e > 0 && acc != 0 - 1 && s < 64] {
            e % 2 != 0 ? { acc <- math_mul_pos(acc, b) }
            e <- e / 2
            e > 0 ? { b <- math_mul_pos(b, b) }
            s <- s + 1
        }
        r <- acc == 0 - 1 ? 0 - 1 : (neg == 1 ? 0 - acc : acc)
    }
    r
}

// Floor of the base-2 logarithm, or -1 for x <= 0.
math_log2 x:i64 : i64 -> {
    r <- 0 - 1
    x > 0 ? {
        k <- 0
        v <- x
        [v > 1 && k < 64] {
            v <- v / 2
            k <- k + 1
        }
        r <- k
    }
    r
}

// Set bits in the two's-complement representation, so a negative argument
// counts its sign bits too and math_popcount(-1) is 64.
math_popcount x:i64 : i64 -> {
    c <- 0
    k <- 0
    [k < 64] {
        c <- c + ((x >> k) & 1)
        k <- k + 1
    }
    c
}

// Trial division by every divisor up to sqrt(x), compared as `d <= x / d` so
// no product can overflow. Deliberately uncapped: d strictly increases and the
// exit test is monotone in i64, so no argument can spin. A cap here would
// return a wrong verdict instead of preventing a hang.
math_is_prime x:i64 : i64 -> {
    r <- 0
    x >= 2 ? {
        r <- 1
        d <- 2
        [r == 1 && d <= x / d] {
            x % d == 0 ? { r <- 0 }
            d <- d + 1
        }
    }
    r
}
