// std/math.tiq: core numeric library written in Tiq
//
// Import:
//   import "std/math.tiq"
//
// The module wraps no compiler builtins, so it is not gated: nothing has to be
// imported before a name becomes reachable (LANGUAGE_SPEC §17.7). It uses no
// extern "C", so nothing links against libm.
//
// Only `enum` and function definitions may appear at top level — a top-level
// binding in an imported module is emitted into the caller's main, so a
// constant written that way would not be visible to these functions.
//
// Two rules hold every function down to a bounded, trap-free execution:
//   - each loop carries an explicit iteration cap, because with NaN and
//     infinity a comparison-only exit can spin forever;
//   - each f64 -> i64 conversion is range-guarded, because out-of-range
//     conversion is undefined on some hosts and traps on wasm.

// --- Constants ---

// A zero-parameter function cannot be defined and a top-level binding in an
// imported module is emitted into the caller's main, so constants are reached
// through an enum tag instead.
enum MathConst {
    Pi,
    Tau,
    E
}

math_const c:i64 : f64 -> match c {
    MathConst.Pi => 3.141592653589793,
    MathConst.Tau => 6.283185307179586,
    MathConst.E => 2.718281828459045,
    _ => 0.0
}

// --- i64 magnitude and bounds ---

// INT64_MIN has no positive i64 representative, so it maps to itself. The
// guard also keeps `0 - x` out of signed overflow. The literal is spelled with
// arithmetic because a bare 9223372036854775808 is out of i64 range.
math_abs x:i64 : i64 -> { x < 0 ? (x == 0 - 9223372036854775807 - 1 ? x : 0 - x) : x }

math_sign x:i64 : i64 -> { x < 0 ? 0 - 1 : x > 0 ? 1 : 0 }

math_min a:i64 b:i64 : i64 -> { a < b ? a : b }

math_max a:i64 b:i64 : i64 -> { a > b ? a : b }

// Out-of-range lo/hi is not an error: the upper bound wins.
math_clamp x:i64 lo:i64 hi:i64 : i64 -> { math_min(math_max(x, lo), hi) }

// --- i64 division ---

// Euclidean remainder: always in [0, |b|). Returns 0 when b == 0 and -1 when
// |b| is not representable, i.e. b == INT64_MIN.
math_mod a:i64 b:i64 : i64 -> {
    d = math_abs(b)
    r <- 0 - 1
    d == 0 ? { r <- 0 }
    d > 0 ? {
        m <- a % d
        r <- m < 0 ? m + d : m
    }
    r
}

// Quotient paired with math_mod so that math_div(a, b) * b + math_mod(a, b)
// == a: the remainder is non-negative, so for a negative divisor the quotient
// is the negated floor rather than the floor itself. Returns 0 when b == 0 and
// -1 when the true quotient or |b| is not representable.
math_div a:i64 b:i64 : i64 -> {
    d = math_abs(b)
    q <- 0 - 1
    b == 0 ? { q <- 0 }
    d > 0 ? {
        t <- a / d
        r <- a - t * d
        t <- r < 0 ? t - 1 : t
        b > 0 ? { q <- t }
        b < 0 ? { q <- t == 0 - 9223372036854775807 - 1 ? 0 - 1 : 0 - t }
    }
    q
}

math_gcd a:i64 b:i64 : i64 -> {
    x <- math_abs(a)
    y <- math_abs(b)
    s <- 0
    (x == 0 - 9223372036854775807 - 1 || y == 0 - 9223372036854775807 - 1) ? {
        x <- 0 - 1
        y <- 0
    }
    [y != 0 && s < 92] {
        t <- x % y
        x <- y
        y <- t
        s <- s + 1
    }
    x
}

// -1 when either argument is INT64_MIN, or when the true lcm does not fit.
math_lcm a:i64 b:i64 : i64 -> {
    m = 0 - 9223372036854775807 - 1
    r <- 0 - 1
    a != m && b != m ? {
        x = math_abs(a)
        y = math_abs(b)
        (x == 0 || y == 0) ? { r <- 0 }
        x > 0 && y > 0 ? {
            g = math_gcd(x, y)
            q = x / g
            r <- q > 9223372036854775807 / y ? 0 - 1 : q * y
        }
    }
    r
}

// --- i64 powers, bit width, and primality ---

// Floor of the exact square root, or -1 for a negative argument. The search
// ceiling is floor(sqrt(INT64_MAX)) so `mid * mid` always stays in range.
math_isqrt x:i64 : i64 -> {
    r <- 0 - 1
    x >= 0 ? {
        lo <- 0
        hi <- x < 3037000499 ? x : 3037000499
        best <- 0
        s <- 0
        [lo <= hi && s < 64] {
            mid <- lo + (hi - lo) / 2
            mid * mid <= x ? {
                best <- mid
                lo <- mid + 1
            }
            mid * mid > x ? { hi <- mid - 1 }
            s <- s + 1
        }
        r <- best
    }
    r
}

// Internal: product of two non-negative magnitudes, or -1 when the product
// does not fit in i64.
math_mul_pos a:i64 b:i64 : i64 -> { a > 0 && b > 9223372036854775807 / a ? 0 - 1 : a * b }

// base raised to a non-negative exponent, with 0 ** 0 == 1. Returns -1 for a
// negative exponent, a base of INT64_MIN, or overflow. -1 is also a legitimate
// result (pow(-1, 3)) and the module has no second channel to tell them apart.
math_pow base:i64 exp:i64 : i64 -> {
    m = 0 - 9223372036854775807 - 1
    r <- 0 - 1
    exp >= 0 && base != m ? {
        acc <- 1
        b <- math_abs(base)
        e <- exp
        neg <- exp > 0 && base < 0 && exp % 2 != 0 ? 1 : 0
        s <- 0
        [e > 0 && acc != 0 - 1 && s < 64] {
            e % 2 != 0 ? { acc <- math_mul_pos(acc, b) }
            e <- e / 2
            e > 0 ? { b <- math_mul_pos(b, b) }
            s <- s + 1
        }
        r <- acc == 0 - 1 ? 0 - 1 : (neg == 1 ? 0 - acc : acc)
    }
    r
}

// Floor of the base-2 logarithm, or -1 for x <= 0.
math_log2 x:i64 : i64 -> {
    r <- 0 - 1
    x > 0 ? {
        k <- 0
        v <- x
        [v > 1 && k < 64] {
            v <- v / 2
            k <- k + 1
        }
        r <- k
    }
    r
}

// Set bits in the two's-complement representation, so a negative argument
// counts its sign bits too and math_popcount(-1) is 64.
math_popcount x:i64 : i64 -> {
    c <- 0
    k <- 0
    [k < 64] {
        c <- c + ((x >> k) & 1)
        k <- k + 1
    }
    c
}

// Trial division by every divisor up to sqrt(x), compared as `d <= x / d` so
// no product can overflow. Deliberately uncapped: d strictly increases and the
// exit test is monotone in i64, so no argument can spin. A cap here would
// return a wrong verdict instead of preventing a hang.
math_is_prime x:i64 : i64 -> {
    r <- 0
    x >= 2 ? {
        r <- 1
        d <- 2
        [r == 1 && d <= x / d] {
            x % d == 0 ? { r <- 0 }
            d <- d + 1
        }
    }
    r
}

// --- f64 predicates ---

// The zero test comes first so that a negative zero argument returns positive
// zero rather than reproducing its sign.
math_fabs x:f64 : f64 -> { x == 0.0 ? 0.0 : x < 0.0 ? 0.0 - x : x }

math_is_nan x:f64 : bool -> { x != x }

// x - x is zero exactly when x is neither NaN nor infinite, which removes the
// need for an infinity literal that Tiq cannot spell.
math_is_finite x:f64 : bool -> { x == x && x - x == 0.0 }

// Relative test with the same magnitude as an absolute floor, so values near
// zero stay comparable. A non-finite operand degrades to plain equality rather
// than reporting an infinite difference as close.
math_close a:f64 b:f64 : bool -> {
    tol = 0.000000000001
    fa = math_fabs(a)
    fb = math_fabs(b)
    m = fa > fb ? fa : fb
    d = math_fabs(a - b)
    math_is_finite(a) && math_is_finite(b) ? (d <= tol * m || d <= tol) : a == b
}

// --- f64 scaling and rounding ---

// Exact power of two, or 0.0 outside [-1074, 1023] where 2 ** k is not
// representable. Built by repeated scaling because Tiq has no float exponent
// operator, and multiplying or dividing by two is exact in binary floating
// point, so no step introduces an error.
math_two_pow k:i64 : f64 -> {
    v <- 0.0
    k >= 0 - 1074 && k <= 1023 ? {
        a <- 1.0
        n = math_abs(k)
        s <- 0
        [s < n] {
            a <- k < 0 ? a / 2.0 : a * 2.0
            s <- s + 1
        }
        v <- a
    }
    v
}

// Round toward zero. Past 2 ** 63 every double is already an integer, so
// returning the argument unchanged also keeps the conversion inside the i64
// range and lets infinity through. The NaN test must come first: converting a
// NaN to i64 yields a host-dependent integer, not a NaN.
math_trunc x:f64 : f64 -> {
    b = math_two_pow(63)
    x != x ? x : x >= b || x < 0.0 - b ? x : f64(i64(x))
}

// Floor and ceil adjust only when the truncated value is strictly above or
// below the argument, which is what leaves an exact integer unchanged.
math_floor x:f64 : f64 -> {
    t = math_trunc(x)
    t > x ? t - 1.0 : t
}

math_ceil x:f64 : f64 -> {
    t = math_trunc(x)
    t < x ? t + 1.0 : t
}

// Half away from zero. The fractional part is compared rather than adding 0.5
// first, because an argument just below a boundary becomes an exact tie under
// the pre-addition and rounds the wrong way.
math_round x:f64 : f64 -> {
    f = math_floor(x)
    r = x - f
    r > 0.5 ? f + 1.0 : (r == 0.5 && x > 0.0 ? f + 1.0 : f)
}

// --- f64 kernels ---

// Principal square root. The argument is first scaled by powers of four into
// [1, 4), which is exact and leaves the root in [1, 2). Bisection there is
// monotone, and sixty halvings land within 2 ** -60 of the root, below one ulp
// of a double.
// Negative and NaN arguments return the 0.0 sentinel, +infinity passes through.
// The 600-step caps sit above the reachable worst case: DBL_MAX needs 512
// steps down and the smallest subnormal needs 538 steps up.
math_sqrt x:f64 : f64 -> {
    r <- 0.0
    x > 0.0 && !math_is_finite(x) ? { r <- x }
    x > 0.0 && math_is_finite(x) ? {
        v <- x
        s <- 0
        i <- 0
        [v >= 4.0 && i < 600] {
            v <- v / 4.0
            s <- s + 1
            i <- i + 1
        }
        j <- 0
        [v < 1.0 && j < 600] {
            v <- v * 4.0
            s <- s - 1
            j <- j + 1
        }
        lo <- 1.0
        hi <- 2.0
        b <- 0
        [b < 60] {
            mid <- (lo + hi) / 2.0
            mid * mid <= v ? { lo <- mid }
            mid * mid > v ? { hi <- mid }
            b <- b + 1
        }
        r <- lo
        n = math_abs(s)
        t <- 0
        [t < n] {
            r <- s > 0 ? r * 2.0 : r / 2.0
            t <- t + 1
        }
    }
    r
}

// Remainder x - n * d for the integer n with |result| < |d|, carrying the sign
// of x. The divisor is doubled up to the dividend and then halved back down,
// subtracting wherever it fits. Each subtraction is exact by Sterbenz because
// the invariant v < 2 * p is maintained throughout, so this matches the host
// fmod bit for bit. A zero divisor, a non-finite operand, or a cap trip
// returns the 0.0 sentinel.
math_fmod x:f64 d:f64 : f64 -> {
    r <- 0.0
    d != 0.0 && math_is_finite(x) && math_is_finite(d) ? {
        a = math_fabs(x)
        b = math_fabs(d)
        v <- a
        p <- b
        i <- 0
        [p * 2.0 <= v && i < 1100] {
            p <- p * 2.0
            i <- i + 1
        }
        k <- 0
        [p >= b && k < 1100] {
            v >= p ? { v <- v - p }
            p <- p / 2.0
            k <- k + 1
        }
        r <- x < 0.0 ? 0.0 - v : v
    }
    r
}

// --- f64 exponentials and logarithms ---

// Natural logarithm. The argument is reduced by exact powers of two into
// [0.5, 2] and the count is added back as k * ln 2, so the series only ever
// sees z = (v - 1) / (v + 1) with |z| <= 1/3. The odd-power series loses a
// factor of z ** 2 <= 1/9 per term, which leaves a residual near 1e-26 after
// 25 terms. A non-positive or non-finite argument returns the 0.0 sentinel.
math_ln x:f64 : f64 -> {
    r <- 0.0
    x > 0.0 && math_is_finite(x) ? {
        v <- x
        k <- 0
        i <- 0
        [v > 2.0 && i < 1100] {
            v <- v / 2.0
            k <- k + 1
            i <- i + 1
        }
        [v < 0.5 && i < 2200] {
            v <- v * 2.0
            k <- k - 1
            i <- i + 1
        }
        z <- (v - 1.0) / (v + 1.0)
        t <- z * z
        p <- z
        acc <- z
        n <- 1
        j <- 0
        [j < 25] {
            p <- p * t
            n <- n + 2
            acc <- acc + p / f64(n)
            j <- j + 1
        }
        r <- 2.0 * acc + f64(k) * 0.6931471805599453
    }
    r
}

// e ** x. The argument is reduced by ln 2 into [-0.35, 0.35], evaluated with a
// twenty-term Taylor series in running-term form, then scaled by the exact
// power of two the reduction counted. Below -745 or above 709 the true result
// is not representable, so those arguments and infinity return the 0.0
// sentinel.
math_exp x:f64 : f64 -> {
    r <- 0.0
    x > 0.0 - 745.0 && x < 709.0 ? {
        k <- math_round(x / 0.6931471805599453)
        y <- x - f64(k) * 0.6931471805599453
        term <- 1.0
        acc <- 1.0
        i <- 0
        [i < 20] {
            i <- i + 1
            term <- term * y / f64(i)
            acc <- acc + term
        }
        r <- acc * math_two_pow(k)
    }
    r
}

// base ** ex for a positive finite base, as exp(ex * ln base). A zero or
// negative base is outside the domain and returns the 0.0 sentinel.
math_powf base:f64 ex:f64 : f64 -> {
    r <- 0.0
    base > 0.0 && math_is_finite(base) && math_is_finite(ex) ? { r <- math_exp(ex * math_ln(base)) }
    r
}

// --- f64 trigonometry and geometry ---

// Internal: sin and cos of an argument already reduced to [-pi/4, pi/4], as a
// running-term Taylor series. Each term is produced from the previous one by
// one multiply and one divide, so no factorial is ever formed and none of the
// intermediate values can overflow i64. With |y| <= pi/4 the terms shrink by
// more than a factor of six each step, so 25 of them are far past the
// precision of a double.
math_sin_kernel y:f64 : f64 -> {
    t <- y
    acc <- y
    i <- 0
    [i < 25] {
        t <- 0.0 - t * y * y / (f64(2 * i + 2) * f64(2 * i + 3))
        acc <- acc + t
        i <- i + 1
    }
    acc
}

math_cos_kernel y:f64 : f64 -> {
    t <- 1.0
    acc <- 1.0
    i <- 0
    [i < 25] {
        t <- 0.0 - t * y * y / (f64(2 * i + 1) * f64(2 * i + 2))
        acc <- acc + t
        i <- i + 1
    }
    acc
}

// Internal: whether the pi/2 reduction below is defined for x. The count of
// quarter-turns is handed to math_mod as an i64, so the guard is what keeps
// that conversion inside the integer range, and past 2 ** 52 a double has no
// fractional bits left for the reduced argument to be more than noise.
math_reducible x:f64 : bool -> { math_fabs(x) <= 4503599627370496.0 }

// Reduction by a rounded count of pi/2, then a quadrant fixup. math_mod is
// Euclidean, so a negative count lands in the same four slots. The reduction
// is naive rather than extended-precision, so the error grows with |x| and the
// documented accuracy holds up to roughly 1e4; arguments outside the reducible
// range return the 0.0 sentinel.
math_sin x:f64 : f64 -> {
    r <- 0.0
    math_reducible(x) ? {
        q = math_const(MathConst.Pi) / 2.0
        k <- math_round(x / q)
        y <- x - f64(k) * q
        m <- math_mod(k, 4)
        s = math_sin_kernel(y)
        c = math_cos_kernel(y)
        m == 0 ? { r <- s }
        m == 1 ? { r <- c }
        m == 2 ? { r <- 0.0 - s }
        m == 3 ? { r <- 0.0 - c }
    }
    r
}

math_cos x:f64 : f64 -> {
    r <- 0.0
    math_reducible(x) ? {
        q = math_const(MathConst.Pi) / 2.0
        k <- math_round(x / q)
        y <- x - f64(k) * q
        m <- math_mod(k, 4)
        s = math_sin_kernel(y)
        c = math_cos_kernel(y)
        m == 0 ? { r <- c }
        m == 1 ? { r <- 0.0 - s }
        m == 2 ? { r <- 0.0 - c }
        m == 3 ? { r <- s }
    }
    r
}

// sin over cos. The cosine of a reduced argument is never exactly zero, so the
// guard exists to keep a pole at an unrepresentable angle from producing an
// infinity the module otherwise never returns. The domain is the same
// reducible range as sin and cos, stated here rather than inherited from their
// sentinel.
math_tan x:f64 : f64 -> {
    r <- 0.0
    math_reducible(x) ? {
        c = math_cos(x)
        c != 0.0 ? { r <- math_sin(x) / c }
    }
    r
}

// atan. A magnitude above one is inverted through atan(t) = pi/2 - atan(1/t),
// which keeps the series argument below one; then half-angle shrinking
// (v / (1 + sqrt(1 + v * v)) halves the angle exactly) brings it below 0.5,
// where the alternating series loses a factor of four per term. The sign of the
// argument is reapplied at the end because atan is odd.
math_atan x:f64 : f64 -> {
    r <- 0.0
    math_is_finite(x) ? {
        a <- math_fabs(x)
        flip <- 0
        a > 1.0 ? {
            a <- 1.0 / a
            flip <- 1
        }
        v <- a
        i <- 0
        [v > 0.5 && i < 60] {
            v <- v / (1.0 + math_sqrt(1.0 + v * v))
            i <- i + 1
        }
        t <- v
        acc <- v
        s <- 0
        [s < 25] {
            t <- 0.0 - t * v * v
            acc <- acc + t / f64(2 * s + 3)
            s <- s + 1
        }
        r <- acc * math_two_pow(i)
        flip == 1 ? { r <- math_const(MathConst.Pi) / 2.0 - r }
        x < 0.0 ? { r <- 0.0 - r }
    }
    r
}

// Angle of the point (x, y) from the positive x axis, in [-pi, pi]. Every
// branch is chosen before the division, so a zero abscissa never divides. The
// origin itself is outside the domain and returns the 0.0 sentinel.
math_atan2 y:f64 x:f64 : f64 -> {
    r <- 0.0
    math_is_finite(y) && math_is_finite(x) ? {
        pi = math_const(MathConst.Pi)
        x > 0.0 ? { r <- math_atan(y / x) }
        x < 0.0 && y >= 0.0 ? { r <- math_atan(y / x) + pi }
        x < 0.0 && y < 0.0 ? { r <- math_atan(y / x) - pi }
        x == 0.0 && y > 0.0 ? { r <- pi / 2.0 }
        x == 0.0 && y < 0.0 ? { r <- 0.0 - pi / 2.0 }
    }
    r
}

// sqrt(a * a + b * b) without overflowing on large legs: the smaller leg is
// scaled by the larger one, which keeps every product at or below one, and the
// result is scaled back afterwards.
math_hypot a:f64 b:f64 : f64 -> {
    r <- 0.0
    math_is_finite(a) && math_is_finite(b) ? {
        x = math_fabs(a)
        y = math_fabs(b)
        big <- x > y ? x : y
        small <- x > y ? y : x
        u <- small == 0.0 ? 0.0 : small / big
        r <- big * math_sqrt(1.0 + u * u)
    }
    r
}

math_deg x:f64 : f64 -> { x * 180.0 / math_const(MathConst.Pi) }

math_rad x:f64 : f64 -> { x * math_const(MathConst.Pi) / 180.0 }
