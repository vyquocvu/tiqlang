// M15: JSON parsing, inspection, and encoding (LANGUAGE_SPEC §19.1).
// Import this module to use json_* functions:
//   import "std/json.tiq"
//
// These are thin wrappers over the compiler's JSON builtins. Inside this
// std/ module the builtins are recognized directly; user code accesses
// them only through these imported function definitions.
//
// json_view is not wrapped: it returns a zero-copy str view whose slice
// type cannot be expressed as a function return, so it stays a core
// builtin available without this import.

json_parse_int s:str : i64 -> { json_parse_int(s) }
json_encode_str s:str : str -> { json_encode_str(s) }
json_get json:str key:str : str -> { json_get(json, key) }
json_arr_len arr:str : i64 -> { json_arr_len(arr) }
json_arr_get arr:str idx:i64 : str -> { json_arr_get(arr, idx) }
json_has json:str key:str : bool -> { json_has(json, key) }
json_set json:str key:str val:str : str -> { json_set(json, key, val) }
json_del json:str key:str : str -> { json_del(json, key) }
