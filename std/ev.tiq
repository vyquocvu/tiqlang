// M15: Event loop abstractions (LANGUAGE_SPEC §19.4).
// Import this module to use ev_* functions:
//   import "std/ev.tiq"
//
// These are thin wrappers over the compiler's kqueue-based event builtins.
//
// ev_loop is not wrapped: it takes no parameters and Tiq has no
// zero-parameter function syntax, so it stays a core builtin available
// without this import.

ev_add loop:i64 fd:i64 : i64 -> { ev_add(loop, fd) }
ev_wait loop:i64 timeout:i64 : i64 -> { ev_wait(loop, timeout) }
ev_ready loop:i64 idx:i64 : i64 -> { ev_ready(loop, idx) }
