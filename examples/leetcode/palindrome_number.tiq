// LeetCode #9: Palindrome Number
// Given an integer x, return true if x is a palindrome, and false otherwise.

is_palindrome x -> {
    is_pal <- x >= 0
    [(is_pal) |
        rev <- 0,
        tmp <- x,
        [tmp > 0 |
            rev <- rev * 10 + tmp % 10,
            tmp <- tmp / 10
        ],
        is_pal <- rev == x,
        break
    ]
    is_pal
}

// Test 1: 121 -> true (1)
print(is_palindrome(121))

// Test 2: -121 -> false (0)
print(is_palindrome(-121))

// Test 3: 10 -> false (0)
print(is_palindrome(10))

// Test 4: 1221 -> true (1)
print(is_palindrome(1221))
