// LeetCode #53: Maximum Subarray
// Given an integer array nums, find the contiguous subarray with the largest sum.
// Strategy: Kadane's algorithm — O(n) single pass.

max_sub_array nums -> {
    n = len(nums)
    best <- nums[0]
    cur  <- nums[0]
    [1..n |
        cur  <- cur + nums[i] > nums[i] ? cur + nums[i] : nums[i],
        best <- cur > best ? cur : best
    ]
    best
}

// Test 1: [-2, 1, -3, 4, -1, 2, 1, -5, 4] -> max subarray sum is 6 ([4, -1, 2, 1])
nums1 = [-2, 1, -3, 4, -1, 2, 1, -5, 4]
!max_sub_array(nums1)

// Test 2: [5, 4, -1, 7, 8] -> max subarray sum is 23
nums2 = [5, 4, -1, 7, 8]
!max_sub_array(nums2)

// Test 3: [1; 1] -> single element array of 1 (max sum is 1)
nums3 = [1; 1]
!max_sub_array(nums3)
