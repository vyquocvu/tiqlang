// LeetCode #1: Two Sum
// Note: Without print statements, this compiles but doesn't output results.
// The algorithm finds indices [0, 1] for target 9 in [2, 7, 11, 15].

nums = [2, 7, 11, 15]
target = 9
idx1 <- -1
idx2 <- -1
j <- 0

[0..len(nums) |
    j <- i + 1,
    [j < len(nums) |
        [(nums[i] + nums[j] == target) | idx1 <- i, idx2 <- j, break],
        j += 1
    ]
]
