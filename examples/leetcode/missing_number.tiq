// LeetCode #268: Missing Number
// Given an array nums of n distinct integers in the range [0, n],
// return the one number missing from the range.

missing_number nums -> {
    n = len(nums)
    expected = n * (n + 1) / 2
    actual <- 0
    [0..n] {
        actual += nums[i]
    }
    expected - actual
}

// Test 1: [3, 0, 1] -> missing 2
nums1 = [3, 0, 1]
print(missing_number(nums1))

// Test 2: [0, 1] -> missing 2
nums2 = [0, 1]
print(missing_number(nums2))

// Test 3: [9, 6, 4, 2, 3, 5, 7, 0, 1] -> missing 8
nums3 = [9, 6, 4, 2, 3, 5, 7, 0, 1]
print(missing_number(nums3))
