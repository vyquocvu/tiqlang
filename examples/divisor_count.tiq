// Fibonacci differences reveal pattern
fib = [0, 1, ... a + b]

// fib[n] - fib[n-1]: 1, 1, 2, 3, 5, 8...
// This is also Fibonacci shifted!

// Double Fibonacci
dbl_fib = [0, 2, ... a + b]

// Negafibonacci (some elements)
negafib = [0, 1, ... a - b]

// Print sequences
[0..10 | print(fib[i])]
[0..10 | print(dbl_fib[i])]
[0..10 | print(negafib[i])]
