// Fibonacci differences reveal pattern
fib = [0, 1, ... (a, b) -> a + b]

// fib[n] - fib[n-1]: 1, 1, 2, 3, 5, 8...
// This is also Fibonacci shifted!

// Double Fibonacci
dbl_fib = [0, 2, ... (a, b) -> a + b]

// Negafibonacci (some elements)
negafib = [0, 1, ... (a, b) -> a - b]

// Print sequences
[i <- 0..10] {
    print(fib[i])
}
[i <- 0..10] {
    print(dbl_fib[i])
}
[i <- 0..10] {
    print(negafib[i])
}
