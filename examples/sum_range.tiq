// Sum of first n natural numbers

// 1. Recursive approach: O(n) call stack
sum_rec n -> n <= 0 ? 0 : n + sum_rec(n - 1)

// 2. Closed-form formula approach: O(1) time & space
sum_formula n -> n <= 0 ? 0 : n * (n + 1) / 2

// 3. Stream generator approach: sum_seq[n] computes sum of 0..n
sum_seq = [0, ... (x; i) -> x + i]

// --- Tests ---
print(sum_rec(10)) // 55
print(sum_formula(10)) // 55
print(sum_seq[10]) // 55

print(sum_rec(100)) // 5050
print(sum_formula(100)) // 5050
print(sum_seq[100]) // 5050

print(sum_rec(0)) // 0
print(sum_formula(0)) // 0
print(sum_seq[0]) // 0

print(sum_rec(1)) // 1
print(sum_formula(1)) // 1
print(sum_seq[1]) // 1
