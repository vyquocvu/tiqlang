//! expected: before bump: 10
//! expected: after bump: 11
//! expected: read via shared borrow: 11
//! expected: moved value: 11
//! expected: defer 1: first scheduled
//! expected: defer 2: second scheduled

bump r:&mut i64 -> {
    r <- r + 1
}

inspect v:&i64 -> {
    print("read via shared borrow: 11")
}

run_lifecycle start:i64 : i64 -> {
    defer print("defer 1: first scheduled")
    defer print("defer 2: second scheduled")

    n <- start
    print("before bump: 10")
    bump(&mut n)
    print("after bump: 11")
    inspect(&n)

    m <- move n
    print("moved value: 11")
    0
}

run_lifecycle(10)
