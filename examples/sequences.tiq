// Multiple sequences
fib = [0, 1, ... (a, b) -> a + b]
fact = [1, ... (x; i) -> i * x]
square = [0, 1, ... (a, b; i) -> i * i]
pow2 = [1, ... (x) -> x * 2]

// Fibonacci: 0, 1, 1, 2, 3, 5, 8...
[i <- 0..7] {
    print(fib[i])
}
// Factorial: 1, 1, 2, 6, 24, 120...
[i <- 0..6] {
    print(fact[i])
}
// Squares: 0, 1, 4, 9, 16, 25...
[i <- 0..7] {
    print(square[i])
}
// Powers of 2: 1, 2, 4, 8, 16, 32...
[i <- 0..7] {
    print(pow2[i])
}
