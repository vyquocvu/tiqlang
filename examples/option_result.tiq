// Option and Result types demonstration

// Option: some(x) wraps a value, none is absent
x = some(42)
y = x ?? 0
print(y)

z = none
w = z ?? -1
print(w)

// Result: ok(x) wraps success, err(e) wraps error
r = ok(100)
s = r ?? 0
print(s)

e = err(99)
f = e ?? 0
print(f)

// Propagation operator unwraps Option/Result
get_opt o: Option : Option -> {
  v = ?o
  some(v)
}
a = some(7)
b = get_opt(a) ?? 0
print(b)

get_res res: Result : Result -> {
  v = ?res
  ok(v)
}
c = ok(13)
d = get_res(c) ?? 0
print(d)
