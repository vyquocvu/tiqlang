// M13.2-S1: self-hosted Tiq lexer — a faithful port of src/lexer.c.
//
// The C lexer walks the source with a char pointer; here the cursor is a
// byte offset `pos` and single characters are read from a str_view slice
// (`sv = source[0..n]`), so every read is an O(1) bounds-checked byte
// access against the slice's carried length — no per-character strlen.
// Reads past the end are guarded (`pos < n ? sv[pos] : 0`) so the 0 plays
// the role of C's '\0' sentinel, mapping every peek/peek_next comparison
// 1:1. Character classes (is_alpha / is_digit) are arithmetic code-point
// comparisons (identical to the C lexer's byte ranges; non-ASCII bytes
// never match), and the keyword table (identifier_type's first-letter
// dispatch: exact whole-word matches only, near-misses like `enums` stay
// IDENT) is a literal-keyed map because vec and map element types do not
// cross function boundaries in the bootstrap. All lexing state lives in
// this single function (there is also no early return, so alternatives
// are `?[guard] { ... }` blocks sequenced on a `k == -1` "kind not
// decided yet" sentinel, mirroring C's switch).
//
// lex_scan fills `toks` with the whole token stream and returns has_error
// (0/1). It stops after the first EOF token, exactly where the C parser
// stops pulling from the lexer: a lexical error also produces an EOF
// token, so the stream ends there. Diagnostics go to stderr in
// diag_error's format as they are discovered.
//
// lex_dump prints that stream exactly like `tiq dump-tokens`
// (dump_tokens in src/main.c): the kind name, plus the raw lexeme for
// IDENT/INT/FLOAT/STRING; NEWLINE tokens are skipped and the EOF token is
// not printed. M13.3-S2 split scanning from printing so the self-hosted
// parser can consume the same token vector.

import "ast.tiq"

// diag_error's stderr format (src/diag.c): "%s:%d: error[E%02d]: %s".
diag_line path:str ln:i64 code:i64 msg:str : str -> {
    a = str_cat(path, ":")
    b = str_cat(a, int_str(ln))
    c = str_cat(b, ": error[E")
    d = str_cat(c, code < 10 ? str_cat("0", int_str(code)) : int_str(code))
    e = str_cat(d, "]: ")
    str_cat(e, msg)
}

lex_scan source:str path:str toks:vec[Token] : i64 -> {
    // Reserved words (identifier_type in src/lexer.c). Exact-match lookup
    // is equivalent to the C first-letter dispatch + memcmp of the rest.
    kw = map_new()
    map_set(kw, "break", TokenKind.Break)
    map_set(kw, "chan", TokenKind.Chan)
    map_set(kw, "defer", TokenKind.Defer)
    map_set(kw, "enum", TokenKind.Enum)
    map_set(kw, "extern", TokenKind.Extern)
    map_set(kw, "import", TokenKind.Import)
    map_set(kw, "false", TokenKind.False)
    map_set(kw, "match", TokenKind.Match)
    map_set(kw, "move", TokenKind.Move)
    map_set(kw, "mut", TokenKind.Mut)
    map_set(kw, "none", TokenKind.None)
    map_set(kw, "skip", TokenKind.Skip)
    map_set(kw, "spawn", TokenKind.Spawn)
    map_set(kw, "struct", TokenKind.Struct)
    map_set(kw, "true", TokenKind.True)
    map_set(kw, "until", TokenKind.Until)
    map_set(kw, "while", TokenKind.While)

    // Character classes (src/lexer.c is_alpha / is_digit), as code-point
    // ranges so no per-character allocation or map lookup is needed:
    //   is_digit(c): '0'..'9' -> 48..57
    //   is_alpha(c): 'a'..'z' (97..122), 'A'..'Z' (65..90), '_' (95)

    n = len(source)
    // A non-owning view carrying the byte length: `sv[pos]` is an O(1)
    // bounds-checked byte read (the length comes from the slice, not a
    // per-read strlen). All reads are guarded with `pos < n ?` so an
    // out-of-range probe yields 0 instead of the slice's abort path.
    sv = source[0..n]
    pos <- 0
    line <- 1
    pend_c <- -1
    pend_l <- 0
    has_err <- 0
    eof <- false
    [!eof] {
        // skip_whitespace(): spaces/CRs/tabs; a // comment is consumed and
        // kept as pending trivia for the next token (only the last comment
        // before a token survives, exactly like the C lexer's overwrite).
        ws <- true
        [ws] {
            wc <- pos < n ? sv[pos] : 0
            hit <- false
            wc == 32 || wc == 13 || wc == 9 ? {
                pos += 1
                hit <- true
            }
            !hit && wc == 47 && pos + 1 < n && sv[pos + 1] == 47 ? {
                pend_c <- pos
                [pos < n && sv[pos] != 10] { pos += 1 }
                pend_l <- pos - pend_c
                hit <- true
            }
            !hit ? { ws <- false }
        }

        start = pos
        pos >= n ? {
            // is_at_end: emit the EOF token and stop, printing nothing
            // (dump_tokens breaks on EOF before printing).
            vec_push(toks, Token { kind: TokenKind.Eof, start: start, length: 0, line: line, comment_start: pend_c, comment_length: pend_l })
            pend_c <- -1
            pend_l <- 0
            eof <- true
        }
        !eof ? {
            c0 <- sv[pos]
            pos += 1
            k <- -1

            // '\n' produces a NEWLINE token; line increments afterwards.
            k == -1 && c0 == 10 ? { k <- TokenKind.Newline }
            // identifier(): [A-Za-z_][A-Za-z0-9_]*. A BARE '_' (length 1)
            // is TOK_UNDERSCORE; longer identifiers starting with '_' are
            // TOK_IDENT (Pre-M13 S1: reserved for compiler temporaries).
            k == -1 && ((c0 >= 97 && c0 <= 122) || (c0 >= 65 && c0 <= 90) || c0 == 95) ? {
                nxt <- pos < n ? sv[pos] : 0
                [((nxt >= 97 && nxt <= 122) || (nxt >= 65 && nxt <= 90) || nxt == 95) || (nxt >= 48 && nxt <= 57)] {
                    pos += 1
                    nxt <- pos < n ? sv[pos] : 0
                }
                c0 == 95 && pos - start == 1 ? { k <- TokenKind.Underscore }
                k == -1 ? {
                    kk = map_get(kw, str_sub(source, start, pos))
                    k <- kk == -1 ? TokenKind.Ident : kk
                }
            }

            // number(): digits/underscores; '.' starts a FLOAT only when
            // followed by a digit (peek_next), fraction also allows '_'.
            k == -1 && c0 >= 48 && c0 <= 57 ? {
                nxt <- pos < n ? sv[pos] : 0
                [(nxt >= 48 && nxt <= 57) || nxt == 95] {
                    pos += 1
                    nxt <- pos < n ? sv[pos] : 0
                }
                nxt == 46 && pos + 1 < n && sv[pos + 1] >= 48 && sv[pos + 1] <= 57 ? {
                    pos += 1
                    nxt <- pos < n ? sv[pos] : 0
                    [(nxt >= 48 && nxt <= 57) || nxt == 95] {
                        pos += 1
                        nxt <- pos < n ? sv[pos] : 0
                    }
                    k <- TokenKind.Float
                }
                k == -1 ? { k <- TokenKind.Int }
            }

            // string(): scan to the closing quote. A raw newline inside is
            // E03 (line still counts up); '\' consumes the next char, and
            // only \\ \" \n \r \t \0 are valid escapes — anything else is
            // E01 at lex time. Running off the end is E02 + an EOF token.
            k == -1 && c0 == 34 ? {
                scanning <- true
                [scanning] {
                    sc <- pos < n ? sv[pos] : 0
                    pos >= n || sc == 34 ? { scanning <- false }
                    scanning ? {
                        sc == 10 ? {
                            has_err <- 1
                            eprint(diag_line(path, line, 3, "newline in string literal"))
                            line += 1
                        }
                        sc == 92 && pos + 1 < n ? {
                            pos += 1
                            ec <- sv[pos]
                            valid_esc = ec == 92 || ec == 34 || ec == 110 || ec == 114 || ec == 116 || ec == 48
                            !valid_esc ? {
                                has_err <- 1
                                eprint(diag_line(path, line, 1, str_cat(str_cat("unsupported escape sequence '\\", str_sub(source, pos, pos + 1)), "'")))
                            }
                        }
                        pos += 1
                    }
                }
                pos >= n ? {
                    has_err <- 1
                    eprint(diag_line(path, line, 2, "unterminated string literal"))
                    k <- TokenKind.Eof
                }
                k == -1 ? { pos += 1; k <- TokenKind.String }
            }

            // Single-character punctuation.
            k == -1 && c0 == 123 ? { k <- TokenKind.Lbrace }
            k == -1 && c0 == 125 ? { k <- TokenKind.Rbrace }
            k == -1 && c0 == 40 ? { k <- TokenKind.Lparen }
            k == -1 && c0 == 41 ? { k <- TokenKind.Rparen }
            k == -1 && c0 == 91 ? { k <- TokenKind.Lbracket }
            k == -1 && c0 == 93 ? { k <- TokenKind.Rbracket }
            k == -1 && c0 == 44 ? { k <- TokenKind.Comma }
            k == -1 && c0 == 59 ? { k <- TokenKind.Semicolon }
            k == -1 && c0 == 94 ? { k <- TokenKind.Caret }
            // Multi-character operators: each match() consumes on success.
            k == -1 && c0 == 63 ? {
                (pos < n ? sv[pos] : 0) == 63 ? { pos += 1; k <- TokenKind.QuestionQuestion }
                k == -1 ? { k <- TokenKind.Question }
            }
            k == -1 && c0 == 46 ? {
                (pos < n ? sv[pos] : 0) == 46 ? {
                    pos += 1
                    (pos < n ? sv[pos] : 0) == 46 ? { pos += 1; k <- TokenKind.DotDotDot }
                    k == -1 ? { k <- TokenKind.DotDot }
                }
                k == -1 ? { k <- TokenKind.Dot }
            }
            k == -1 && c0 == 43 ? {
                (pos < n ? sv[pos] : 0) == 61 ? { pos += 1; k <- TokenKind.PlusEq }
                k == -1 ? { k <- TokenKind.Plus }
            }
            k == -1 && c0 == 45 ? {
                (pos < n ? sv[pos] : 0) == 61 ? { pos += 1; k <- TokenKind.MinusEq }
                k == -1 && (pos < n ? sv[pos] : 0) == 62 ? { pos += 1; k <- TokenKind.Rarrow }
                k == -1 ? { k <- TokenKind.Minus }
            }
            k == -1 && c0 == 42 ? {
                (pos < n ? sv[pos] : 0) == 61 ? { pos += 1; k <- TokenKind.StarEq }
                k == -1 ? { k <- TokenKind.Star }
            }
            k == -1 && c0 == 47 ? {
                (pos < n ? sv[pos] : 0) == 61 ? { pos += 1; k <- TokenKind.SlashEq }
                k == -1 ? { k <- TokenKind.Slash }
            }
            k == -1 && c0 == 37 ? {
                (pos < n ? sv[pos] : 0) == 61 ? { pos += 1; k <- TokenKind.PercentEq }
                k == -1 ? { k <- TokenKind.Percent }
            }
            k == -1 && c0 == 61 ? {
                (pos < n ? sv[pos] : 0) == 61 ? { pos += 1; k <- TokenKind.EqEq }
                k == -1 && (pos < n ? sv[pos] : 0) == 62 ? { pos += 1; k <- TokenKind.FatArrow }
                k == -1 ? { k <- TokenKind.Eq }
            }
            k == -1 && c0 == 33 ? {
                (pos < n ? sv[pos] : 0) == 61 ? { pos += 1; k <- TokenKind.BangEq }
                k == -1 ? { k <- TokenKind.Bang }
            }
            k == -1 && c0 == 60 ? {
                (pos < n ? sv[pos] : 0) == 61 ? { pos += 1; k <- TokenKind.Lte }
                k == -1 && (pos < n ? sv[pos] : 0) == 60 ? { pos += 1; k <- TokenKind.Lshift }
                k == -1 && (pos < n ? sv[pos] : 0) == 45 ? { pos += 1; k <- TokenKind.Larrow }
                k == -1 ? { k <- TokenKind.Lt }
            }
            k == -1 && c0 == 62 ? {
                (pos < n ? sv[pos] : 0) == 61 ? { pos += 1; k <- TokenKind.Gte }
                k == -1 && (pos < n ? sv[pos] : 0) == 62 ? { pos += 1; k <- TokenKind.Rshift }
                k == -1 ? { k <- TokenKind.Gt }
            }
            k == -1 && c0 == 38 ? {
                (pos < n ? sv[pos] : 0) == 38 ? { pos += 1; k <- TokenKind.AndAnd }
                k == -1 ? { k <- TokenKind.Amp }
            }
            k == -1 && c0 == 124 ? {
                (pos < n ? sv[pos] : 0) == 124 ? { pos += 1; k <- TokenKind.OrOr }
                k == -1 ? { k <- TokenKind.Pipe }
            }
            k == -1 && c0 == 58 ? {
                (pos < n ? sv[pos] : 0) == 61 ? { pos += 1; k <- TokenKind.ColonEq }
                k == -1 ? { k <- TokenKind.Colon }
            }

            // Anything else is E01; lexer_next returns an EOF token, which
            // makes the dump loop stop right here.
            k == -1 ? {
                has_err <- 1
                eprint(diag_line(path, line, 1, str_cat(str_cat("unexpected character '", str_sub(source, pos - 1, pos)), "'")))
                k <- TokenKind.Eof
            }

            // make_token(): attach and clear pending comment trivia.
            vec_push(toks, Token { kind: k, start: start, length: pos - start, line: line, comment_start: pend_c, comment_length: pend_l })
            pend_c <- -1
            pend_l <- 0

            // The stream ends at the first EOF token; '\n' bumps the line
            // counter after its NEWLINE token was made, like make_token.
            k == TokenKind.Eof ? { eof <- true }
            k == TokenKind.Newline ? { line += 1 }
        }
    }
    has_err
}

// dump_tokens() in src/main.c: print every token but NEWLINE, stopping at
// EOF (which lex_scan already made the last token).
lex_dump source:str path:str : i64 -> {
    toks = vec_new()
    has_err = lex_scan(source, path, toks)
    count = vec_len(toks)
    [j <- 0..count] {
        k = tk_kind(toks, j)
        k != TokenKind.Eof && k != TokenKind.Newline ? {
            nm = token_kind_name(k)
            lexed = k == TokenKind.Ident || k == TokenKind.Int || k == TokenKind.Float || k == TokenKind.String
            print(lexed ? str_cat(str_cat(nm, " "), tk_lex(source, toks, j)) : nm)
        }
    }
    has_err
}
