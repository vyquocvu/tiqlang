// M14.5-T1: incremental module cache (`tiq cache`). Manages the compiler's
// artifact cache directory. The cache stores emitted C output keyed by
// source content hash (FNV-1a) so that compiling the same source again
// (unchanged) is instant.
//
// CLI:
//   tiq cache clear           -- remove all cached entries
//   tiq cache <path>          -- show cache status (prints path or "not cached")
//   (unknown flags/extra args -> exit 2)
//
// Determinism: the cache directory is fixed at /tmp/.tiq-cache; the hash
// depends only on the source content; entry names depend only on the source
// path; clearing is deterministic. No environment variables or timestamps
// reach the output.

// FNV-1a hash (32-bit, unsigned). Returns the hash of a string as int.
// The hash is computed from the byte values of the string (str_sub_code
// returns 0-255 unsigned bytes).
fnv_hash s:str : i64 -> {
    h <- 2166136261
    i <- 0
    [i < len(s)] {
        h <- h ^ str_sub_code(s, i)
        h <- h * 16777619
        i <- i + 1
    }
    h
}

// Mangle a source path into a cache entry file name. Path separators ('/')
// are replaced with '_' so the entry always lives flat inside the cache dir.
entry_name src:str : str -> {
    sb <- str_buf_new()
    i <- 0
    [i < len(src)] {
        c <- str_sub_code(src, i)
        c == 47 ? { str_buf_append(sb, "_") }  // 47 = '/'
        c != 47 ? { str_buf_append(sb, str_sub(src, i, i + 1)) }
        i <- i + 1
    }
    str_buf_to_str(sb)
}

// Full path to the cache entry for a source file.
cache_entry_path src:str : str -> {
    cd <- "/tmp/.tiq-cache"
    str_cat(str_cat(cd, "/"), entry_name(src))
}

// Check if a source file has a valid cache entry. Returns true when the
// cache entry exists and its stored hash matches the current source content.
cache_has src:str : i64 -> {
    cd <- "/tmp/.tiq-cache"
    r <- 0
    ep <- str_cat(str_cat(cd, "/"), entry_name(src))
    fs_exists(ep) ? {
        cached <- fs_read(ep)
        !str_eq(cached, "") ? {
            n <- len(cached)
            nli <- 0
            [nli < n && str_sub_code(cached, nli) != 10] { nli <- nli + 1 }
            nli > 0 ? {
                hash_line <- str_sub(cached, 0, nli)
                prefix_len <- 5
                len(hash_line) > prefix_len && str_eq(str_sub(hash_line, 0, prefix_len), "hash:") ? {
                    stored_hash_str <- str_sub(hash_line, prefix_len, len(hash_line))
                    current_hash_str <- int_str(fnv_hash(fs_read(src)))
                    str_eq(stored_hash_str, current_hash_str) ? { r <- 1 }
                }
            }
        }
    }
    r
}

// Store the emitted C content for a source file in the cache.
// Returns 0 on success, -1 on failure.
cache_put src:str content:str : i64 -> {
    cd <- "/tmp/.tiq-cache"
    r <- 0
    flag <- proc_exec(str_cat("mkdir -p ", cd))
    flag != 0 ? { r <- -1 }
    flag == 0 ? {
        h <- fnv_hash(fs_read(src))
        hstr <- int_str(h)
        sb <- str_buf_new()
        str_buf_append(sb, "hash:")
        str_buf_append(sb, hstr)
        str_buf_append(sb, "\n")
        str_buf_append(sb, content)
        rc <- fs_write(str_cat(str_cat(cd, "/"), entry_name(src)), str_buf_to_str(sb))
        rc != 0 ? { r <- -1 }
    }
    r
}

// --- CLI ---

cd <- "/tmp/.tiq-cache"
nargs <- cli_arg_count()
nargs == 0 ? {
    eprint("usage: tiq cache clear | <path>")
    proc_exit(2)
}

nargs == 1 ? {
    arg <- cli_arg(0)
    str_eq(arg, "clear") ? {
        r <- proc_exec(str_cat("rm -rf ", cd))
        r != 0 ? { proc_exit(1) }
        proc_exit(0)
    }
    str_sub_code(arg, 0) == 45 ? {
        eprint(str_cat("tiq cache: unknown option: ", arg))
        proc_exit(2)
    }
    // Show cache status for a path
    cache_has(arg) != 0 ? {
        print(str_cat(str_cat(cd, "/"), entry_name(arg)))
        proc_exit(0)
    }
    eprint(str_cat("not cached: ", arg))
    proc_exit(1)
}

nargs > 1 ? {
    eprint("tiq cache: too many arguments")
    proc_exit(2)
}
0