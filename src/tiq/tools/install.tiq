// M18.1-T1: package dependency installer (`tiq install`). Reads the manifest
// (`tiq.toml`) from the current directory, resolves each `[deps]` entry, and
// copies/clones dependencies into `.tiq-deps/<name>/`. Generates a `tiq.lock`
// lockfile with content hashes (FNV-1a) for integrity verification.
//
// CLI:
//   tiq install              -- install deps from tiq.toml in cwd
//   (no flags for now)
//
// Dependency source formats:
//   path:<dir>               -- local directory (copied with cp -r)
//   git:<url>                -- git repository (cloned)
//   git:<url>#<ref>          -- git repository at specific ref
//   <bare>                   -- treated as path:<bare>
//
// Determinism: the output depends only on the manifest content and the
// filesystem state of the dependency sources. No environment variables or
// timestamps reach the output.

import "../manifest.tiq"

// FNV-1a hash (32-bit, unsigned). Same as cache.tiq.
fnv_hash s: str -> i64 -> {
    h <- 2166136261
    i <- 0
    [i < len(s)] {
        h <- h ^ str_sub_code(s, i)
        h <- h * 16777619
        i <- i + 1
    }
    h
}

// Compute a content hash for a dependency directory by hashing the
// concatenated contents of all .tiq files.
dep_hash dir: str -> str -> {
    tmp <- str_cat("/tmp/.tiq-install-hash-", int_str(fnv_hash(dir)))
    cmd <- str_cat(str_cat("find ", dir), str_cat(" -name '*.tiq' -exec cat {} \\; > ", tmp))
    proc_exec(cmd)
    content <- fs_read(tmp)
    proc_exec(str_cat("rm -f ", tmp))
    int_str(fnv_hash(content))
}

// Main installation logic.
manifest_path <- "tiq.toml"
?[!fs_exists(manifest_path)] {
    eprint(str_cat("tiq install: cannot read ", manifest_path))
    proc_exit(1)
}

src <- fs_read(manifest_path)
sv <- vec_new()
vec_push(sv, 0)  // section
vec_push(sv, 0)  // name seen
vec_push(sv, 0)  // error flag
vec_push(sv, 0)  // version seen
vec_push(sv, 0)  // package seen

err <- mf_check(src, manifest_path, sv)
?[err != 0] {
    proc_exit(1)
}

pkg_name <- mf_extract_name(src)
dep_names = vec_new()
dep_sources = vec_new()
dep_count <- mf_extract_deps(src, dep_names, dep_sources)

?[dep_count == 0] {
    print("No dependencies to install")
    proc_exit(0)
}

// Ensure .tiq-deps/ exists
proc_exec("mkdir -p .tiq-deps")

installed <- 0
i <- 0
[i < dep_count] {
    name <- vec_get(dep_names, i)
    source <- vec_get(dep_sources, i)
    scheme <- mf_dep_scheme(source)
    dep_dir <- str_cat(".tiq-deps/", name)

    // Ensure the target directory exists
    proc_exec(str_cat("mkdir -p ", dep_dir))

    ?[scheme == 1] {
        // Path dependency
        path <- mf_dep_strip(source)
        ?[!fs_exists(path)] {
            eprint(str_cat(str_cat("tiq install: dependency '", name), str_cat("' path not found: ", path)))
            proc_exit(1)
        }
        // Copy directory contents
        cp_cmd <- str_cat(str_cat("cp -r ", path), str_cat("/* ", dep_dir))
        cp_cmd2 <- str_cat(str_cat("cp -r ", path), str_cat("/. ", dep_dir))
        proc_exec(cp_cmd)
        // Also copy hidden files (except . and ..)
        proc_exec(cp_cmd2)
        installed <- installed + 1
    }
    ?[scheme == 2] {
        // Git dependency
        url <- mf_git_url(source)
        ref <- mf_git_ref(source)
        // Remove existing directory for clean clone
        proc_exec(str_cat("rm -rf ", dep_dir))
        ?[len(ref) > 0] {
            clone_cmd <- str_cat(str_cat("git clone --depth 1 -b ", ref), str_cat(" ", str_cat(url, str_cat(" ", dep_dir))))
            rc <- proc_exec(clone_cmd)
            ?[rc != 0] {
                eprint(str_cat(str_cat("tiq install: git clone failed for '", name), "'"))
                proc_exit(1)
            }
        }
        ?[len(ref) == 0] {
            clone_cmd <- str_cat("git clone --depth 1 ", str_cat(url, str_cat(" ", dep_dir)))
            rc <- proc_exec(clone_cmd)
            ?[rc != 0] {
                eprint(str_cat(str_cat("tiq install: git clone failed for '", name), "'"))
                proc_exit(1)
            }
        }
        installed <- installed + 1
    }

    i <- i + 1
}

// Generate lockfile
lock_buf <- str_buf_new()
str_buf_append(lock_buf, "# This file is automatically generated by tiq install.\n")
str_buf_append(lock_buf, "# Do not edit manually.\n")
str_buf_append(lock_buf, str_cat("name = \"", str_cat(pkg_name, "\"\n")))
str_buf_append(lock_buf, "\n")

j <- 0
[j < dep_count] {
    name <- vec_get(dep_names, j)
    source <- vec_get(dep_sources, j)
    dep_dir <- str_cat(".tiq-deps/", name)

    str_buf_append(lock_buf, "[[pkg]]\n")
    str_buf_append(lock_buf, str_cat("name = \"", str_cat(name, "\"\n")))
    str_buf_append(lock_buf, str_cat("source = \"", str_cat(source, "\"\n")))

    // Compute content hash
    hash <- dep_hash(dep_dir)
    str_buf_append(lock_buf, str_cat("hash = \"", str_cat(hash, "\"\n")))
    str_buf_append(lock_buf, "\n")

    j <- j + 1
}

lock_content <- str_buf_to_str(lock_buf)
rc <- fs_write("tiq.lock", lock_content)
?[rc != 0] {
    eprint("tiq install: cannot write tiq.lock")
    proc_exit(1)
}

print(str_cat("Installed ", str_cat(int_str(installed), " dependenc" )))
?[installed == 1] {
    print("y")
}
?[installed != 1] {
    print("ies")
}
0
