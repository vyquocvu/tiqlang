// M14.2-T1: Tiq source formatter (`tiq fmt`). Token-based: it lexes the whole
// source with the self-hosted lexer (src/tiq/lexer.tiq) and re-emits the token
// stream with the repository's canonical layout (docs/CLI.md). The formatter
// does not parse, so it never rejects source on semantic grounds; a lexical
// error fails closed via lex_scan's return value.

import "../ast.tiq"
import "../lexer.tiq"
import "std/json.tiq"
//
// Comments are trivia attached to tokens (comment_start/comment_length) and
// are re-emitted verbatim in place. The output is a function of the token
// stream only, so it is deterministic for identical input; `--check` compares
// it byte-for-byte against the source.
//
// The engine walks the token vec once, keeping its small state in the
// `st` vec (at_line_start, indent, inline record-literal depth, use_tabs,
// indent_width) because structs read out of a vec cannot bind to locals in the
// bootstrap. Lookahead (peek) and two-token lookback (prev/prev2) drive the
// unary-vs-binary and block-vs-record-literal decisions.

// ---------------------------------------------------------------------------
// Token stream accessors (comment trivia is exposed here; ast.tiq exposes the
// other Token fields through tk_kind/tk_start/tk_length/tk_line).
tk_cs toks:vec[Token] i:i64 -> i64 -> vec_get(toks, i).comment_start
tk_cl toks:vec[Token] i:i64 -> i64 -> vec_get(toks, i).comment_length

// ---------------------------------------------------------------------------
// Kind predicates.

// Operators that take a space on both sides. Plus/Minus/Amp are context
// sensitive (unary tight, binary spaced) and are handled by their own rule;
// Question and Colon have their own ternary/annotation rules.
space_op k:i64 -> i64 -> {
    r <- 0
    ?[k == TokenKind.Star || k == TokenKind.Slash || k == TokenKind.Percent] { r <- 1 }
    ?[k == TokenKind.EqEq || k == TokenKind.BangEq || k == TokenKind.Lt || k == TokenKind.Lte || k == TokenKind.Gt || k == TokenKind.Gte] { r <- 1 }
    ?[k == TokenKind.AndAnd || k == TokenKind.OrOr || k == TokenKind.Pipe || k == TokenKind.Caret || k == TokenKind.Lshift || k == TokenKind.Rshift] { r <- 1 }
    ?[k == TokenKind.Eq || k == TokenKind.PlusEq || k == TokenKind.MinusEq || k == TokenKind.StarEq || k == TokenKind.SlashEq || k == TokenKind.PercentEq || k == TokenKind.ColonEq] { r <- 1 }
    ?[k == TokenKind.Larrow || k == TokenKind.Rarrow || k == TokenKind.FatArrow || k == TokenKind.QuestionQuestion] { r <- 1 }
    r
}

// Tokens that end an operand: a following + - & is then binary, and the token
// takes a trailing space unless it is followed by a tight-after token.
operand_end k:i64 -> i64 -> {
    r <- 0
    ?[k == TokenKind.Ident || k == TokenKind.Int || k == TokenKind.Float || k == TokenKind.String || k == TokenKind.Underscore || k == TokenKind.Rparen || k == TokenKind.Rbracket] { r <- 1 }
    r
}

// Keywords and keyword-like words: always take a trailing space.
is_keyword k:i64 -> i64 -> {
    r <- 0
    ?[k == TokenKind.While || k == TokenKind.Break || k == TokenKind.Skip || k == TokenKind.Move || k == TokenKind.Defer || k == TokenKind.Until || k == TokenKind.Spawn || k == TokenKind.Chan || k == TokenKind.Struct || k == TokenKind.Enum || k == TokenKind.Match || k == TokenKind.Mut || k == TokenKind.True || k == TokenKind.False || k == TokenKind.None || k == TokenKind.Import || k == TokenKind.Extern] { r <- 1 }
    r
}

// May the current token be followed by a space at all?
space_ok k:i64 -> i64 -> {
    r <- 1
    ?[k == TokenKind.Newline || k == TokenKind.Eof || k == TokenKind.Rbrace || k == TokenKind.Rbracket || k == TokenKind.Rparen || k == TokenKind.Comma || k == TokenKind.Semicolon] { r <- 0 }
    r
}

// A token that ends a nested construct: the propagation `?` stays tight
// before these, and a block-closing `}` needs no following line break.
is_closer k:i64 -> i64 -> {
    r <- 0
    ?[k == TokenKind.Newline || k == TokenKind.Eof || k == TokenKind.Rbrace || k == TokenKind.Rbracket || k == TokenKind.Rparen || k == TokenKind.Comma || k == TokenKind.Semicolon] { r <- 1 }
    r
}

// An operand-end token stays tight before these (call/index/field/range/
// type-postfix and every closer). `?` and `:` are handled separately: they
// may need a space (ternary) or stay tight (guard/propagation, annotation).
tight_after k:i64 -> i64 -> {
    r <- 0
    ?[k == TokenKind.Newline || k == TokenKind.Eof || k == TokenKind.Rbrace || k == TokenKind.Rbracket || k == TokenKind.Rparen || k == TokenKind.Comma || k == TokenKind.Semicolon || k == TokenKind.Lparen || k == TokenKind.Lbracket || k == TokenKind.Dot || k == TokenKind.DotDot || k == TokenKind.DotDotDot || k == TokenKind.Bang] { r <- 1 }
    r
}

// ---------------------------------------------------------------------------
// Emission helpers. State lives in `st`:
//   0 at_line_start (1 = next byte lands at the start of a line)
//   1 indent level
//   2 open inline record-literal braces
//   3 use_tabs
//   4 indent_width
// Helpers append to the `b` strbuf, which is shared by value.

em_space st:vec[int] b:strbuf -> i64 -> {
    ?[vec_get(st, 0) == 0] { str_buf_append(b, " ") }
    0
}

em_newline st:vec[int] b:strbuf -> i64 -> {
    ?[vec_get(st, 0) == 0] {
        str_buf_append(b, "\n")
        vec_set(st, 0, 1)
    }
    0
}

em_indent st:vec[int] b:strbuf -> i64 -> {
    ?[vec_get(st, 0) == 1] {
        ind <- vec_get(st, 1)
        tabs <- vec_get(st, 3)
        w <- vec_get(st, 4)
        ?[tabs == 1] {
            j <- 0
            [j < ind] { str_buf_append(b, "\t"); j <- j + 1 }
        }
        ?[tabs == 0] {
            j <- 0
            [j < ind * w] { str_buf_append(b, " "); j <- j + 1 }
        }
        vec_set(st, 0, 0)
    }
    0
}

em_comment st:vec[int] b:strbuf src:str toks:vec[Token] i:i64 -> i64 -> {
    clen <- tk_cl(toks, i)
    ?[clen > 0] {
        cstart <- tk_cs(toks, i)
        atls <- vec_get(st, 0)
        ?[atls == 1] { em_indent(st, b) }
        ?[atls == 0] { str_buf_append(b, " ") }
        str_buf_append(b, str_sub(src, cstart, cstart + clen))
    }
    0
}

// Emit token i (its comment first), then either a newline (nl=1, the NEWLINE
// token case) or the lexeme at the current position.
em_token st:vec[int] b:strbuf src:str toks:vec[Token] i:i64 nl:i64 -> i64 -> {
    em_comment(st, b, src, toks, i)
    ?[nl == 1] {
        str_buf_append(b, "\n")
        vec_set(st, 0, 1)
    }
    ?[nl == 0] {
        s <- tk_start(toks, i)
        l <- tk_length(toks, i)
        em_indent(st, b)
        str_buf_append(b, str_sub(src, s, s + l))
    }
    0
}

// ---------------------------------------------------------------------------
// The formatting engine. Walks toks[0 .. n-2] (the EOF token is index n-1 and
// only its comment trivia is emitted) and rewrites the stream into `b`.
// `tern` counts unmatched ternary `?` openers so `:` can be told apart from a
// type/field annotation; `prev`/`prev2` are the two previously emitted token
// kinds and `peek`/`peek2` the next two.
fmt_run src:str toks:vec[Token] st:vec[int] b:strbuf -> i64 -> {
    n <- vec_len(toks)
    i <- 0
    prev <- 0
    prev2 <- 0
    tern <- 0
    [i < n && tk_kind(toks, i) != TokenKind.Eof] {
        k <- tk_kind(toks, i)
        pk <- TokenKind.Eof
        ?[i + 1 < n] { pk <- tk_kind(toks, i + 1) }
        p2k <- TokenKind.Eof
        ?[i + 2 < n] { p2k <- tk_kind(toks, i + 2) }
        done <- 0

        // NEWLINE tokens carry trailing/comment-only-line comments.
        ?[done == 0 && k == TokenKind.Newline] {
            em_token(st, b, src, toks, i, 1)
            done <- 1
        }

        // Tight range operator.
        ?[done == 0 && k == TokenKind.DotDot] {
            em_token(st, b, src, toks, i, 0)
            done <- 1
        }

        // Stream operator: takes a trailing space.
        ?[done == 0 && k == TokenKind.DotDotDot] {
            em_token(st, b, src, toks, i, 0)
            ?[space_ok(pk) == 1] { em_space(st, b) }
            done <- 1
        }

        // Logical negation (and Result type postfix `T!E`): stays tight.
        ?[done == 0 && k == TokenKind.Bang] {
            em_token(st, b, src, toks, i, 0)
            done <- 1
        }

        // '?' is a ternary (space after, and it needs a matching ':'), a
        // guard opener '?[' (tight), or the propagation operator (tight).
        ?[done == 0 && k == TokenKind.Question] {
            em_token(st, b, src, toks, i, 0)
            is_tern <- 0
            ?[pk != TokenKind.Lbracket && space_ok(pk) == 1] { is_tern <- 1 }
            ?[is_tern == 1] { em_space(st, b); tern <- tern + 1 }
            done <- 1
        }

        // Comma and semicolon: no space before, a trailing space.
        ?[done == 0 && (k == TokenKind.Comma || k == TokenKind.Semicolon)] {
            em_token(st, b, src, toks, i, 0)
            ?[space_ok(pk) == 1] { em_space(st, b) }
            done <- 1
        }

        // ':' is a ternary colon (matches a pending '?') or a type/field
        // annotation (tight before); it always takes a trailing space. A
        // record-literal field colon does not close an outer ternary.
        ?[done == 0 && k == TokenKind.Colon] {
            em_token(st, b, src, toks, i, 0)
            ?[space_ok(pk) == 1] { em_space(st, b) }
            is_fc <- 0
            ?[prev2 == TokenKind.Lbrace || prev2 == TokenKind.Comma] { is_fc <- 1 }
            ?[tern > 0 && is_fc == 0] { tern <- tern - 1 }
            done <- 1
        }

        // + - & are unary (tight) unless the previous token ended an operand.
        ?[done == 0 && (k == TokenKind.Plus || k == TokenKind.Minus || k == TokenKind.Amp)] {
            em_token(st, b, src, toks, i, 0)
            ?[operand_end(prev) == 1 && space_ok(pk) == 1] { em_space(st, b) }
            done <- 1
        }

        // Remaining spaced operators.
        ?[done == 0 && space_op(k) == 1] {
            em_token(st, b, src, toks, i, 0)
            ?[space_ok(pk) == 1] { em_space(st, b) }
            done <- 1
        }

        // Openers stay tight on the left.
        ?[done == 0 && (k == TokenKind.Lparen || k == TokenKind.Lbracket)] {
            em_token(st, b, src, toks, i, 0)
            done <- 1
        }

        // '{': a block after ], ->, an identifier, or (for struct/enum/match)
        // their name; an inline record literal when it is `Name {` with
        // single-line content. Blocks open a line and add an indent level.
        ?[done == 0 && k == TokenKind.Lbrace] {
            gl <- 0
            ?[prev == TokenKind.Rbracket || prev == TokenKind.Rarrow || prev == TokenKind.Ident] { gl <- 1 }
            ?[gl == 0] { em_newline(st, b) }
            inl <- 0
            ?[prev == TokenKind.Ident && prev2 != TokenKind.Struct && prev2 != TokenKind.Enum && prev2 != TokenKind.Match && pk != TokenKind.Newline] { inl <- 1 }
            em_token(st, b, src, toks, i, 0)
            ?[inl == 1] {
                vec_set(st, 2, vec_get(st, 2) + 1)
                ?[pk != TokenKind.Newline && pk != TokenKind.Eof] { em_space(st, b) }
            }
            ?[inl == 0] {
                vec_set(st, 1, vec_get(st, 1) + 1)
                ?[pk != TokenKind.Newline && pk != TokenKind.Eof] { em_newline(st, b) }
            }
            done <- 1
        }

        // '}': closes an inline record literal inline, or a block at the
        // parent indent on its own line.
        ?[done == 0 && k == TokenKind.Rbrace] {
            d <- vec_get(st, 2)
            ?[d > 0] {
                vec_set(st, 2, d - 1)
                em_space(st, b)
                em_token(st, b, src, toks, i, 0)
                ?[space_op(pk) == 1 || pk == TokenKind.Question || pk == TokenKind.Colon] { em_space(st, b) }
            }
            ?[d == 0] {
                em_newline(st, b)
                vec_set(st, 1, vec_get(st, 1) - 1)
                em_token(st, b, src, toks, i, 0)
                close <- 0
                ?[is_closer(pk) == 1] { close <- 1 }
                ?[close == 0 && (space_op(pk) == 1 || pk == TokenKind.Question || pk == TokenKind.Colon)] { em_space(st, b) }
                ?[close == 0 && space_op(pk) == 0 && pk != TokenKind.Question && pk != TokenKind.Colon] { em_newline(st, b) }
            }
            done <- 1
        }

        // Default: keywords and operand-enders take a trailing space.
        ?[done == 0] {
            em_token(st, b, src, toks, i, 0)
            ?[is_keyword(k) == 1] {
                ?[space_ok(pk) == 1] { em_space(st, b) }
            }
            ?[is_keyword(k) == 0 && operand_end(k) == 1] {
                sp <- 1
                ?[tight_after(pk) == 1] { sp <- 0 }
                ?[pk == TokenKind.Question && is_closer(p2k) == 1] { sp <- 0 }
                ?[pk == TokenKind.Colon] {
                    is_f <- 0
                    ?[prev == TokenKind.Lbrace || prev == TokenKind.Comma] { is_f <- 1 }
                    ?[tern == 0 || is_f == 1] { sp <- 0 }
                }
                ?[sp == 1] { em_space(st, b) }
            }
            done <- 1
        }

        prev2 <- prev
        prev <- k
        i <- i + 1
    }
    // A comment before EOF (no trailing newline) attaches to the EOF token.
    ?[n > 0] { em_comment(st, b, src, toks, n - 1) }
    // Insert the final newline when the input lacked one.
    ?[vec_get(st, 0) == 0] { str_buf_append(b, "\n") }
    0
}

// ---------------------------------------------------------------------------
// CLI: tiq fmt [--check] [--output <file>] [--use-tabs] [--indent-width <n>]
// [file]. Reads `file` or stdin; writes stdout or --output. Deterministic.
check_flag <- 0
use_tabs <- 0
width <- 4
output <- ""
file <- ""
nargs <- cli_arg_count()
i <- 0
[i < nargs] {
    a <- cli_arg(i)
    used <- 0
    ?[str_eq(a, "--check")] { check_flag <- 1; used <- 1 }
    ?[str_eq(a, "--use-tabs")] { use_tabs <- 1; used <- 1 }
    ?[str_eq(a, "--output") && i + 1 < nargs] { i <- i + 1; output <- cli_arg(i); used <- 1 }
    ?[str_eq(a, "--indent-width") && i + 1 < nargs] {
        i <- i + 1
        w <- json_parse_int(cli_arg(i))
        ?[w < 1] { eprint("tiq fmt: --indent-width must be >= 1"); proc_exit(2) }
        width <- w
        used <- 1
    }
    ?[used == 0 && str_sub_code(a, 0) != 45] {
        ?[!str_eq(file, "")] { eprint("tiq fmt: too many input files"); proc_exit(2) }
        file <- a
        used <- 1
    }
    ?[used == 0] { eprint(str_cat("tiq fmt: unknown option: ", a)); proc_exit(2) }
    i <- i + 1
}
?[check_flag == 1 && !str_eq(output, "")] { eprint("tiq fmt: --check and --output cannot be combined"); proc_exit(2) }
?[check_flag == 1 && str_eq(file, "")] { eprint("tiq fmt: --check requires a file argument"); proc_exit(2) }

src <- ""
path <- "(stdin)"
?[str_eq(file, "")] { src <- fs_read("/dev/stdin") }
?[!str_eq(file, "")] { src <- fs_read(file); path <- file }

toks <- vec_new()
lerr <- lex_scan(src, path, toks)
?[lerr != 0] { proc_exit(1) }

st <- vec_new()
vec_push(st, 1)
vec_push(st, 0)
vec_push(st, 0)
vec_push(st, use_tabs)
vec_push(st, width)

b <- str_buf_new()
fmt_run(src, toks, st, b)
formatted <- str_buf_to_str(b)

?[check_flag == 1] {
    ?[!str_eq(src, formatted)] {
        eprint(str_cat(path, ": not formatted"))
        proc_exit(1)
    }
    proc_exit(0)
}

?[!str_eq(output, "")] {
    rc <- fs_write(output, formatted)
    ?[rc != 0] { eprint(str_cat("tiq fmt: cannot write ", output)); proc_exit(1) }
}
?[str_eq(output, "")] {
    rc <- fs_write("/dev/stdout", formatted)
    ?[rc != 0] { eprint("tiq fmt: cannot write output"); proc_exit(1) }
}
0
