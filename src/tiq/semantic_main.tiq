// M13.4-S3: the self-hosted `tiq dump-typed-ast` driver. Reads the file
// named by the first CLI argument, lexes, parses, runs semantic analysis
// (only when parsing succeeded, matching C dump_typed_ast), prints the
// typed AST, and exits with has_error.

import "semantic.tiq"

path = cli_arg(0)
source = fs_read(path)

toks = vec_new()
lex_err = lex_scan(source, path, toks)

st = vec_new()
vec_push(st, 0)
vec_push(st, 0)
vec_push(st, 0)
vec_push(st, 0)
first = p_peek(toks, 0)
vec_set(st, PS.Cur, first)
vec_set(st, PS.Prev, first)
vec_set(st, PS.HasErr, lex_err)

nodes = vec_new()
kids = vec_new()
sk = vec_new()
sk2 = vec_new()
tops = vec_new()

parse_err = p_parse(source, path, toks, st, nodes, kids, sk, sk2, tops)

has_err = semantic_check(source, path, toks, nodes, kids, tops, parse_err)
proc_exit(has_err)
