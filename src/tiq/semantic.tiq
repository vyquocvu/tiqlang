                sk == TY.RefMut ? { vec_set(ed, si * 4 + 1, 0); hand <- 1 }
            }
            hand == 0 && vec_get(ed, si * 4 + 0) == 0 ? { s_diag(ctx, path, ln, 11, "cannot assign to immutable binding"); hand <- 1 }
            hand == 0 ? {
