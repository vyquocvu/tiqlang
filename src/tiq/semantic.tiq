            // Assign layout matches the name: A=expr, B=index. The binding's
            // expr already sits in A; a rebind has no index, so clear B.
            nd_set(nodes, ni, NF.Kind, AstKind.Assign)
            nd_set(nodes, ni, NF.Op, TokenKind.Larrow)
            nd_set(nodes, ni, NF.F1, 0)
            nd_set(nodes, ni, NF.B, 0 - 1)
            // Now fall through to the Assign case below
            done <- 0
        }
        done == 0 ? {
            check_node(src, path, toks, nodes, kids, types, en, ed, sc, st_reg, st_data, st_names, st_meta, en_reg, en_data, fn_reg, fn_data, fpts, frks, tp, tpn, ctx, ei)
            bt <- ei != -1 ? vec_get(types, ei) : -1
            tp_b <- bt != -1 ? bt : ty_get(tp, tpn, TY.Unknown)
            env_define(en, ed, sc, nm, is_mut, tp_b, ln)
            vec_set(types, ni, tp_b); done <- 1
        }
    }
    // --- ASSIGN ---
    done == 0 && k == AstKind.Assign ? {
        ei <- nd_get(nodes, ni, NF.A); idx <- nd_get(nodes, ni, NF.B)
        check_node(src, path, toks, nodes, kids, types, en, ed, sc, st_reg, st_data, st_names, st_meta, en_reg, en_data, fn_reg, fn_data, fpts, frks, tp, tpn, ctx, ei)
        nm <- tk_lex(src, toks, nd_get(nodes, ni, NF.Name))
