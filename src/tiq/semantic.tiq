// M13.4-S3: self-hosted Tiq semantic checker — faithful port of src/semantic.c.
// One self-recursive check_node dispatches on node kind. All state is passed
// as parameters (no globals). Node types live in types:vec[int] (parallel
// to nodes, indexed by node id; -1 = untyped). Diagnostics go to stderr
// via eprint in diag_error's exact format.

import "ast.tiq"
import "lexer.tiq"
import "parser.tiq"
import "type.tiq"

// Env symbol: names in env_names:vec[str], data in env_data:vec[int]
// with EW=4 slots per binding: mut, moved, type, line.
enum EF { EMut, EMoved, EType, ELine }
// Context: packed into ctx:vec[int].
enum CX { HasErr, Fatal, LoopDepth, InRange, IsStd }

// M15: gated domain builtins — only recognized inside std/ module wrappers.
// json_view stays ungated: its str_view result cannot be wrapped in a
// function; ev_loop and dl_error stay ungated: zero-parameter functions
// cannot be defined in Tiq. All remain core builtins (same as the C
// bootstrap).
is_gated_name n:str : bool ->
    str_eq(n, "json_parse_int") || str_eq(n, "json_encode_str") || str_eq(n, "json_get") ||
    str_eq(n, "json_arr_len") || str_eq(n, "json_arr_get") ||
    str_eq(n, "json_has") || str_eq(n, "json_set") || str_eq(n, "json_del") ||
    str_eq(n, "net_fetch") || str_eq(n, "net_listen") || str_eq(n, "net_accept") ||
    str_eq(n, "net_connect") || str_eq(n, "net_recv") || str_eq(n, "net_send") ||
    str_eq(n, "net_close") || str_eq(n, "net_port") || str_eq(n, "net_shutdown") ||
    str_eq(n, "http_method") || str_eq(n, "http_path") || str_eq(n, "http_header") ||
    str_eq(n, "ev_add") || str_eq(n, "ev_wait") || str_eq(n, "ev_ready") ||
    str_eq(n, "dl_open") || str_eq(n, "dl_sym") || str_eq(n, "dl_call")

// Prime the pool with primitive kinds so pool[i] = TY.i for simple types.
// OPTION (10) and RESULT (11) are NOT primed: C's generic interner ignores
// inner_type, so the first OPTION/RESULT in the pool wins for ty_get. If we
// primed a bare OPTION, then `none` would match it instead of an earlier
// OPTION<INT> created by `some(1)`. Let them be created on demand like C.
prime_pool tp:vec[int] tpn:vec[str] : i64 -> { k <- 0; [k < 28] { k != 10 && k != 11 ? { ty_get(tp, tpn, k) }; k <- k + 1 }; 0 }

// diag_error(): path:line: error[E%02d]: msg. E07 is fatal → suppresses later diag.
s_diag ctx:vec[int] path:str ln:i64 code:i64 msg:str : i64 -> {
    vec_get(ctx, CX.Fatal) == 0 ? {
        vec_set(ctx, CX.HasErr, 1); eprint(diag_line(path, ln, code, msg))
        code == 7 ? { vec_set(ctx, CX.Fatal, 1) }
    }
    0
}

env_lookup en:vec[str] ed:vec[int] name:str : i64 -> {
    r <- 0 - 1; i <- vec_len(en) - 1
    [i >= 0] { str_eq(vec_get(en, i), name) ? { r <- i; break }; i <- i - 1 }; r
}
env_define en:vec[str] ed:vec[int] sc:vec[int] name:str is_mut:i64 tp:i64 ln:i64 : i64 -> {
    dup <- 0; ss <- vec_len(en)
    vec_len(sc) > 0 ? { ss <- vec_get(sc, vec_len(sc) - 1) }    i <- vec_len(en) - 1
    [i >= ss && dup == 0] { str_eq(vec_get(en, i), name) ? { dup <- 1; break }; i <- i - 1 }
    dup == 0 ? { vec_push(en, name); vec_push(ed, is_mut); vec_push(ed, 0); vec_push(ed, tp); vec_push(ed, ln) }
    dup == 0 ? 1 : 0
}
env_push_scope sc:vec[int] en:vec[str] : i64 -> { vec_push(sc, vec_len(en)); 0 }
env_pop_scope sc:vec[int] en:vec[str] ed:vec[int] : i64 -> {
    b <- 0; vec_len(sc) > 0 ? { b <- vec_get(sc, vec_len(sc) - 1); drop2 <- vec_pop(sc) }
    [vec_len(en) > b] { d4 <- vec_pop(ed); d3 <- vec_pop(ed); d2 <- vec_pop(ed); d1 <- vec_pop(ed); dn <- vec_pop(en) }; 0
}
env_set_moved en:vec[str] ed:vec[int] name:str : i64 -> {
    i <- vec_len(en) - 1
    [i >= 0] { str_eq(vec_get(en, i), name) ? { vec_set(ed, i * 4 + 1, 1); break }; i <- i - 1 }; 0
}
env_set_type en:vec[str] ed:vec[int] name:str tp:i64 : i64 -> {
    i <- vec_len(en) - 1
    [i >= 0] { str_eq(vec_get(en, i), name) ? { vec_set(ed, i * 4 + 2, tp); break }; i <- i - 1 }; 0
}

// Struct name registry: names in st_names (flat), types in st_meta (flat,
// parallel). Mirrors C's ctx->structs table: single-pass, forward-scan
// (earliest definition wins for duplicates).
struct_lookup st_names:vec[str] name:str : i64 -> {
    r <- 0 - 1; i <- 0
    [i < vec_len(st_names) && r == -1] { str_eq(vec_get(st_names, i), name) ? { r <- i; break }; i <- i + 1 }
    r
}

// Enum registry: en_data holds three slots per enum —
// [name_pos, var_base, var_count]. name_pos is the index in en_reg of the
// enum-name pair, var_base the index of the first variant-name pair, and
// var_count the number of variants. Variant pairs live in en_reg after the
// name pair, so en_reg stays the single string store.
enum_lookup en_reg:vec[str] en_data:vec[int] name:str : i64 -> {
    r <- 0 - 1; i <- 0
    [i < vec_len(en_data) / 3 && r == -1] {
        str_eq(vec_get(en_reg, vec_get(en_data, i * 3)), name) ? { r <- i }        i <- i + 1
    }
    r
}

resolve_type src:str toks:vec[Token] tp:vec[int] tpn:vec[str] tidx:i64 : i64 -> {
    r <- 0 - 1
    tidx != -1 ? {
        nm <- tk_lex(src, toks, tidx)
        str_eq(nm, "i8") ? { r <- ty_get(tp, tpn, TY.I8) }        str_eq(nm, "i16") ? { r <- ty_get(tp, tpn, TY.I16) }        str_eq(nm, "i32") ? { r <- ty_get(tp, tpn, TY.I32) }        str_eq(nm, "i64") ? { r <- ty_get(tp, tpn, TY.Int) }        str_eq(nm, "u8") ? { r <- ty_get(tp, tpn, TY.U8) }        str_eq(nm, "u16") ? { r <- ty_get(tp, tpn, TY.U16) }        str_eq(nm, "u32") ? { r <- ty_get(tp, tpn, TY.U32) }        str_eq(nm, "u64") ? { r <- ty_get(tp, tpn, TY.U64) }        str_eq(nm, "f32") ? { r <- ty_get(tp, tpn, TY.F32) }        str_eq(nm, "f64") ? { r <- ty_get(tp, tpn, TY.Float) }        str_eq(nm, "bool") ? { r <- ty_get(tp, tpn, TY.Bool) }        str_eq(nm, "str") ? { r <- ty_get(tp, tpn, TY.Str) }        str_eq(nm, "int") ? { r <- ty_get(tp, tpn, TY.Int) }        str_eq(nm, "float") ? { r <- ty_get(tp, tpn, TY.Float) }    }
    r
}
resolve_cont src:str toks:vec[Token] tp:vec[int] tpn:vec[str] st_names:vec[str] st_meta:vec[int] tidx:i64 eidx:i64 path:str ctx:vec[int] : i64 -> {
    r <- 0 - 1
    tidx != -1 ? {
        nm <- tk_lex(src, toks, tidx)
        str_eq(nm, "strbuf") ? { r <- ty_get(tp, tpn, TY.Strbuf) }        str_eq(nm, "map") ? { r <- ty_get(tp, tpn, TY.Map) }        str_eq(nm, "vec") ? {
            eidx == -1 ? { s_diag(ctx, path, tk_line(toks, tidx), 9, "vec annotation requires an element type: vec[T]"); r <- ty_get(tp, tpn, TY.Unknown) }
            eidx != -1 ? {
                et <- resolve_type(src, toks, tp, tpn, eidx)
                et == -1 ? { enm <- tk_lex(src, toks, eidx); esi <- struct_lookup(st_names, enm); esi != -1 ? { et <- vec_get(st_meta, esi) }}
                et == -1 ? { msg <- str_cat(str_cat("unknown type '", tk_lex(src, toks, eidx)), "'"); s_diag(ctx, path, tk_line(toks, eidx), 9, msg); r <- ty_get(tp, tpn, TY.Unknown) }
                et != -1 ? {
                    ek <- vec_get(tp, et * 8 + TF.Kind)
                    ek != TY.Int && ek != TY.Str && ek != TY.Struct ? { s_diag(ctx, path, tk_line(toks, eidx), 9, "vec element type must be int, str, or a struct"); r <- ty_get(tp, tpn, TY.Unknown) }
                    ek == TY.Int || ek == TY.Str || ek == TY.Struct ? { r <- ty_vec(tp, tpn, et) }                }
            }
        }
    }
    r
}

// Annotation resolution mirroring C resolve_container_annot + resolve_type_annot:
// containers (strbuf/map/vec[T]) first, then primitive names, then structs.
resolve_ann src:str toks:vec[Token] tp:vec[int] tpn:vec[str] st_names:vec[str] st_meta:vec[int] tidx:i64 eidx:i64 path:str ctx:vec[int] : i64 -> {
    r <- resolve_cont(src, toks, tp, tpn, st_names, st_meta, tidx, eidx, path, ctx)
    r == -1 ? { r <- resolve_type(src, toks, tp, tpn, tidx) }    r == -1 && tidx != -1 ? {
        nm <- tk_lex(src, toks, tidx)
        si2 <- struct_lookup(st_names, nm)
        si2 != -1 ? { r <- vec_get(st_meta, si2) }    }
    r
}
unify ctx:vec[int] path:str ln:i64 tp:vec[int] tpn:vec[str] exp:i64 found:i64 emsg:str : i64 -> {
    r <- 0 - 1; d <- 0
    d == 0 && exp == -1 ? { r <- found; d <- 1 }
    d == 0 && found == -1 ? { r <- exp; d <- 1 }
    d == 0 ? {
        ek <- vec_get(tp, exp * 8 + TF.Kind); fk <- vec_get(tp, found * 8 + TF.Kind)
        ek == TY.Unknown ? { r <- found; d <- 1 }
        fk == TY.Unknown ? { r <- exp; d <- 1 }
        ek == fk ? { r <- exp; d <- 1 }
        d == 0 ? {
            msg <- str_cat(str_cat(str_cat(emsg, ": expected "), disp(tp, tpn, exp)), str_cat(", found ", disp(tp, tpn, found)))
            s_diag(ctx, path, ln, 9, msg)
        }
    }
    r
}
vec_elem_ok k:i64 : i64 -> k == TY.Int || k == TY.Str || k == TY.Struct ? 1 : 0
vec_elem_same tp:vec[int] a:i64 b:i64 : i64 -> { ak <- vec_get(tp, a * 8 + TF.Kind); bk <- vec_get(tp, b * 8 + TF.Kind); ak == bk && (ak != TY.Struct || a == b) ? 1 : 0 }

check_int_range src:str toks:vec[Token] ctx:vec[int] path:str tidx:i64 : i64 -> {
    lx <- tk_lex(src, toks, tidx)
    n <- len(lx)
    n > 19 ? { s_diag(ctx, path, tk_line(toks, tidx), 20, "integer literal out of range for i64") }
    n == 19 ? {
        mx <- "9223372036854775807"
        j <- 0; bigger <- 0; done <- 0
        [j < 19 && done == 0] {
            a <- str_sub_code(lx, j); b <- str_sub_code(mx, j)
            a > b ? { bigger <- 1; done <- 1 }
            a < b ? { done <- 1 }
            j <- j + 1
        }
        bigger == 1 ? { s_diag(ctx, path, tk_line(toks, tidx), 20, "integer literal out of range for i64") }
    }
    0
}

// vec/strbuf/map builtin checkers (args already checked by caller).
chk_vec src:str toks:vec[Token] ctx:vec[int] path:str nodes:vec[int] kids:vec[int] types:vec[int] en:vec[str] ed:vec[int] tp:vec[int] tpn:vec[str] ni:i64 nm:str : i64 -> {
    s1 <- nd_get(nodes, ni, NF.L1s); c1 <- nd_get(nodes, ni, NF.L1n)
    isn <- str_eq(nm, "vec_new") ? 1 : 0; isp <- str_eq(nm, "vec_push") ? 1 : 0
    isg <- str_eq(nm, "vec_get") ? 1 : 0; iss <- str_eq(nm, "vec_set") ? 1 : 0
    isl <- str_eq(nm, "vec_len") ? 1 : 0; iso <- str_eq(nm, "vec_pop") ? 1 : 0
    ar <- isn == 1 ? 0 : (isp == 1 || isg == 1) ? 2 : iss == 1 ? 3 : 1
    c1 != ar ? {
        msg <- ar == 0 ? str_cat(nm, " expects no arguments") : str_cat(str_cat(str_cat(nm, " expects exactly "), int_str(ar)), ar == 1 ? " argument" : " arguments")
        s_diag(ctx, path, tk_line(toks, nd_get(nodes, ni, NF.Tok)), 12, msg)
        vec_set(types, ni, isn == 1 ? ty_vec(tp, tpn, 0 - 1) : (isg == 1 || iso == 1) ? ty_get(tp, tpn, TY.Unknown) : ty_get(tp, tpn, TY.Int))
    }
    c1 == ar && isn == 1 ? {
        vec_set(types, ni, ty_vec(tp, tpn, 0 - 1))
    }
    c1 == ar && isn == 0 ? {
        ai0 <- c1 > 0 ? vec_get(kids, s1) : 0 - 1
        vt <- ai0 != 0 - 1 ? vec_get(types, ai0) : 0 - 1
        unify(ctx, path, tk_line(toks, nd_get(nodes, ni, NF.Tok)), tp, tpn, ty_get(tp, tpn, TY.Vec), vt, str_cat(nm, " argument"))
        isg == 1 || iss == 1 ? {
            ai1 <- c1 > 1 ? vec_get(kids, s1 + 1) : 0 - 1
            it <- ai1 != 0 - 1 ? vec_get(types, ai1) : 0 - 1
            unify(ctx, path, tk_line(toks, nd_get(nodes, ni, NF.Tok)), tp, tpn, ty_get(tp, tpn, TY.Int), it, str_cat(nm, " index"))
        }
        el <- vt != 0 - 1 && vec_get(tp, vt * 8 + TF.Kind) == TY.Vec ? vec_get(tp, vt * 8 + TF.Elem) : 0 - 1
        isp == 1 ? {
            ai1 <- c1 > 1 ? vec_get(kids, s1 + 1) : 0 - 1
            et <- ai1 != 0 - 1 ? vec_get(types, ai1) : 0 - 1
            el == 0 - 1 ? {
                et != 0 - 1 && vec_get(tp, et * 8 + TF.Kind) != TY.Unknown ? {
                    vec_elem_ok(vec_get(tp, et * 8 + TF.Kind)) == 0 ? { s_diag(ctx, path, tk_line(toks, nd_get(nodes, ni, NF.Tok)), 9, "vec_push element must be int, str, or a struct") }
                    vec_elem_ok(vec_get(tp, et * 8 + TF.Kind)) == 1 && vt != 0 - 1 && vec_get(tp, vt * 8 + TF.Kind) == TY.Vec ? {
                        nv <- ty_vec(tp, tpn, et)
                        ai0 != 0 - 1 && nd_get(nodes, ai0, NF.Kind) == AstKind.Identifier ? {
                            sn <- env_lookup(en, ed, tk_lex(src, toks, nd_get(nodes, ai0, NF.Name)))
                            sn != 0 - 1 && vec_get(ed, sn * 4 + 2) == vt ? { env_set_type(en, ed, tk_lex(src, toks, nd_get(nodes, ai0, NF.Name)), nv) }
                            vec_set(types, ai0, nv)
                        }
                    }
                }
            }
            el != 0 - 1 && et != 0 - 1 && vec_get(tp, et * 8 + TF.Kind) != TY.Unknown && vec_elem_same(tp, el, et) == 0 ? {
                msg <- str_cat(str_cat("vec_push element: expected ", disp(tp, tpn, el)), str_cat(", found ", disp(tp, tpn, et)))
                s_diag(ctx, path, tk_line(toks, nd_get(nodes, ni, NF.Tok)), 9, msg)
            }
            vec_set(types, ni, ty_get(tp, tpn, TY.Int))
        }
        isl == 1 ? {
            vec_set(types, ni, ty_get(tp, tpn, TY.Int))
        }
        isp == 0 && isl == 0 && el == 0 - 1 ? {
            vt == 0 - 1 || vec_get(tp, vt * 8 + TF.Kind) == TY.Vec || vec_get(tp, vt * 8 + TF.Kind) == TY.Unknown ? {
                s_diag(ctx, path, tk_line(toks, nd_get(nodes, ni, NF.Tok)), 9, str_cat(nm, " on a vec with no established element type (no vec_push yet)"))
            }
            vec_set(types, ni, iss == 1 ? ty_get(tp, tpn, TY.Int) : ty_get(tp, tpn, TY.Unknown))
        }
        isp == 0 && isl == 0 && el != 0 - 1 && iss == 1 ? {
            ai2 <- c1 > 2 ? vec_get(kids, s1 + 2) : 0 - 1
            et <- ai2 != 0 - 1 ? vec_get(types, ai2) : 0 - 1
            et != 0 - 1 && vec_get(tp, et * 8 + TF.Kind) != TY.Unknown && vec_elem_same(tp, el, et) == 0 ? {
                msg <- str_cat(str_cat("vec_set element: expected ", disp(tp, tpn, el)), str_cat(", found ", disp(tp, tpn, et)))
                s_diag(ctx, path, tk_line(toks, nd_get(nodes, ni, NF.Tok)), 9, msg)
            }
            vec_set(types, ni, ty_get(tp, tpn, TY.Int))
        }
        isp == 0 && isl == 0 && el != 0 - 1 && (isg == 1 || iso == 1) ? {
            vec_set(types, ni, el)
        }
    }
    0
}
chk_sb ctx:vec[int] path:str toks:vec[Token] nodes:vec[int] kids:vec[int] types:vec[int] tp:vec[int] tpn:vec[str] ni:i64 nm:str : i64 -> {
    s1 <- nd_get(nodes, ni, NF.L1s); c1 <- nd_get(nodes, ni, NF.L1n)
    isn <- str_eq(nm, "str_buf_new") ? 1 : 0; isa <- str_eq(nm, "str_buf_append") ? 1 : 0; ist <- str_eq(nm, "str_buf_to_str") ? 1 : 0
    ar <- isn == 1 ? 0 : isa == 1 ? 2 : 1
    c1 != ar ? {
        msg <- ar == 0 ? str_cat(nm, " expects no arguments") : str_cat(str_cat(str_cat(nm, " expects exactly "), int_str(ar)), ar == 1 ? " argument" : " arguments")
        s_diag(ctx, path, tk_line(toks, nd_get(nodes, ni, NF.Tok)), 12, msg)
        vec_set(types, ni, isn == 1 ? ty_get(tp, tpn, TY.Strbuf) : ist == 1 ? ty_get(tp, tpn, TY.Str) : ty_get(tp, tpn, TY.Int))
    }
    c1 == ar && isn == 1 ? {
        vec_set(types, ni, ty_get(tp, tpn, TY.Strbuf))
    }
    c1 == ar && isn == 0 ? {
        ai0 <- c1 > 0 ? vec_get(kids, s1) : 0 - 1
        bt <- ai0 != 0 - 1 ? vec_get(types, ai0) : 0 - 1
        unify(ctx, path, tk_line(toks, nd_get(nodes, ni, NF.Tok)), tp, tpn, ty_get(tp, tpn, TY.Strbuf), bt, str_cat(nm, " argument"))
        isa == 1 ? {
            ai1 <- c1 > 1 ? vec_get(kids, s1 + 1) : 0 - 1
            st <- ai1 != 0 - 1 ? vec_get(types, ai1) : 0 - 1
            unify(ctx, path, tk_line(toks, nd_get(nodes, ni, NF.Tok)), tp, tpn, ty_get(tp, tpn, TY.Str), st, "str_buf_append value")
        }
        vec_set(types, ni, ist == 1 ? ty_get(tp, tpn, TY.Str) : ty_get(tp, tpn, TY.Int))
    }
    0
}
chk_map ctx:vec[int] path:str toks:vec[Token] nodes:vec[int] kids:vec[int] types:vec[int] tp:vec[int] tpn:vec[str] ni:i64 nm:str : i64 -> {
    s1 <- nd_get(nodes, ni, NF.L1s); c1 <- nd_get(nodes, ni, NF.L1n)
    isn <- str_eq(nm, "map_new") ? 1 : 0; iss <- str_eq(nm, "map_set") ? 1 : 0; isg <- str_eq(nm, "map_get") ? 1 : 0; ish <- str_eq(nm, "map_has") ? 1 : 0; isk <- str_eq(nm, "map_key_at") ? 1 : 0; isv <- str_eq(nm, "map_val_at") ? 1 : 0
    ar <- isn == 1 ? 0 : iss == 1 ? 3 : (isg == 1 || ish == 1 || isk == 1 || isv == 1) ? 2 : 1
    ret <- isn == 1 ? TY.Map : ish == 1 ? TY.Bool : isk == 1 ? TY.Str : TY.Int
    c1 != ar ? {
        msg <- ar == 0 ? str_cat(nm, " expects no arguments") : str_cat(str_cat(str_cat(nm, " expects exactly "), int_str(ar)), ar == 1 ? " argument" : " arguments")
        s_diag(ctx, path, tk_line(toks, nd_get(nodes, ni, NF.Tok)), 12, msg)
        vec_set(types, ni, ty_get(tp, tpn, ret))
    }
    c1 == ar && isn == 1 ? {
        vec_set(types, ni, ty_get(tp, tpn, TY.Map))
    }
    c1 == ar && isn == 0 ? {
        ai0 <- c1 > 0 ? vec_get(kids, s1) : 0 - 1
        mt <- ai0 != 0 - 1 ? vec_get(types, ai0) : 0 - 1
        unify(ctx, path, tk_line(toks, nd_get(nodes, ni, NF.Tok)), tp, tpn, ty_get(tp, tpn, TY.Map), mt, str_cat(nm, " argument"))
        iss == 1 || isg == 1 || ish == 1 ? {
            ai1 <- c1 > 1 ? vec_get(kids, s1 + 1) : 0 - 1
            kt <- ai1 != 0 - 1 ? vec_get(types, ai1) : 0 - 1
            unify(ctx, path, tk_line(toks, nd_get(nodes, ni, NF.Tok)), tp, tpn, ty_get(tp, tpn, TY.Str), kt, str_cat(nm, " key"))
        }
        iss == 1 ? {
            ai2 <- c1 > 2 ? vec_get(kids, s1 + 2) : 0 - 1
            vt <- ai2 != 0 - 1 ? vec_get(types, ai2) : 0 - 1
            unify(ctx, path, tk_line(toks, nd_get(nodes, ni, NF.Tok)), tp, tpn, ty_get(tp, tpn, TY.Int), vt, "map_set value")
        }
        isk == 1 || isv == 1 ? {
            ai1 <- c1 > 1 ? vec_get(kids, s1 + 1) : 0 - 1
            it <- ai1 != 0 - 1 ? vec_get(types, ai1) : 0 - 1
            unify(ctx, path, tk_line(toks, nd_get(nodes, ni, NF.Tok)), tp, tpn, ty_get(tp, tpn, TY.Int), it, str_cat(nm, " index"))
        }
        vec_set(types, ni, ty_get(tp, tpn, ret))
    }
    0
}

chk_generic_arity nm:str : i64 -> {
    ar <- 0 - 1
    str_eq(nm, "str_cat") || str_eq(nm, "fs_write") || str_eq(nm, "str_eq") || str_eq(nm, "json_get") || str_eq(nm, "json_arr_get") || str_eq(nm, "json_view") || str_eq(nm, "json_has") || str_eq(nm, "json_del") || str_eq(nm, "net_send") || str_eq(nm, "http_header") || str_eq(nm, "ev_add") || str_eq(nm, "ev_wait") || str_eq(nm, "ev_ready") || str_eq(nm, "str_sub_code") ? { ar <- 2 }    str_eq(nm, "int_str") || str_eq(nm, "eprint") || str_eq(nm, "fs_read") || str_eq(nm, "fs_exists") || str_eq(nm, "fs_list") || str_eq(nm, "proc_exec") || str_eq(nm, "proc_exit") || str_eq(nm, "net_fetch") || str_eq(nm, "cli_arg") || str_eq(nm, "json_parse_int") || str_eq(nm, "json_encode_str") || str_eq(nm, "json_arr_len") || str_eq(nm, "net_listen") || str_eq(nm, "net_accept") || str_eq(nm, "net_connect") || str_eq(nm, "net_recv") || str_eq(nm, "net_close") || str_eq(nm, "net_port") || str_eq(nm, "net_shutdown") || str_eq(nm, "http_method") || str_eq(nm, "http_path") ? { ar <- 1 }    str_eq(nm, "str_sub") || str_eq(nm, "json_set") ? { ar <- 3 }    str_eq(nm, "cli_arg_count") || str_eq(nm, "ev_loop") || str_eq(nm, "clock_ms") || str_eq(nm, "dl_error") ? { ar <- 0 }    str_eq(nm, "dl_open") ? { ar <- 1 }    str_eq(nm, "dl_sym") ? { ar <- 2 }    str_eq(nm, "dl_call") ? { ar <- 7 }    ar
}

// Generic builtin checker: returns 1 if matched, 0 if not.
chk_generic ctx:vec[int] path:str toks:vec[Token] nodes:vec[int] kids:vec[int] types:vec[int] tp:vec[int] tpn:vec[str] ni:i64 nm:str c1:i64 : i64 -> {
    ln <- tk_line(toks, nd_get(nodes, ni, NF.Tok))
    r <- 0; hit <- 0
    ar <- 0; exp <- 0; ret <- 0; exp2 <- 0
    // Try each known builtin
    str_eq(nm, "str_cat") ? { ar <- 2; exp <- TY.Str; ret <- TY.Str; exp2 <- 0; hit <- 1 }
    str_eq(nm, "int_str") ? { ar <- 1; exp <- TY.Int; ret <- TY.Str; exp2 <- 0; hit <- 1 }
    str_eq(nm, "str_sub") ? { ar <- 3; exp <- TY.Str; ret <- TY.Str; exp2 <- TY.Int; hit <- 1 }
    str_eq(nm, "str_eq") ? { ar <- 2; exp <- TY.Str; ret <- TY.Bool; exp2 <- 0; hit <- 1 }
    str_eq(nm, "str_sub_code") ? { ar <- 2; exp <- TY.Str; ret <- TY.Int; exp2 <- TY.Int; hit <- 1 }
    str_eq(nm, "eprint") ? { ar <- 1; exp <- TY.Str; ret <- TY.Int; exp2 <- 0; hit <- 1 }
    str_eq(nm, "fs_read") ? { ar <- 1; exp <- TY.Str; ret <- TY.Str; exp2 <- 0; hit <- 1 }
    str_eq(nm, "fs_write") ? { ar <- 2; exp <- TY.Str; ret <- TY.Int; exp2 <- 0; hit <- 1 }
    str_eq(nm, "fs_exists") ? { ar <- 1; exp <- TY.Str; ret <- TY.Bool; exp2 <- 0; hit <- 1 }
    str_eq(nm, "fs_list") ? { ar <- 1; exp <- TY.Str; ret <- TY.Str; exp2 <- 0; hit <- 1 }
    str_eq(nm, "proc_exec") ? { ar <- 1; exp <- TY.Str; ret <- TY.Int; exp2 <- 0; hit <- 1 }
    str_eq(nm, "proc_exit") ? { ar <- 1; exp <- TY.Int; ret <- TY.Int; exp2 <- 0; hit <- 1 }
    str_eq(nm, "net_fetch") ? { ar <- 1; exp <- TY.Str; ret <- TY.Str; exp2 <- 0; hit <- 1 }
    str_eq(nm, "cli_arg_count") ? { ar <- 0; exp <- TY.Int; ret <- TY.Int; exp2 <- 0; hit <- 1 }
    str_eq(nm, "cli_arg") ? { ar <- 1; exp <- TY.Int; ret <- TY.Str; exp2 <- 0; hit <- 1 }
    str_eq(nm, "json_parse_int") ? { ar <- 1; exp <- TY.Str; ret <- TY.Int; exp2 <- 0; hit <- 1 }
    str_eq(nm, "json_encode_str") ? { ar <- 1; exp <- TY.Str; ret <- TY.Str; exp2 <- 0; hit <- 1 }
    str_eq(nm, "json_get") ? { ar <- 2; exp <- TY.Str; ret <- TY.Str; exp2 <- 0; hit <- 1 }
    str_eq(nm, "json_arr_len") ? { ar <- 1; exp <- TY.Str; ret <- TY.Int; exp2 <- 0; hit <- 1 }
    str_eq(nm, "json_arr_get") ? { ar <- 2; exp <- TY.Str; ret <- TY.Str; exp2 <- TY.Int; hit <- 1 }
    str_eq(nm, "json_view") ? { ar <- 2; exp <- TY.Str; ret <- TY.StrView; exp2 <- 0; hit <- 1 }
    str_eq(nm, "json_has") ? { ar <- 2; exp <- TY.Str; ret <- TY.Bool; exp2 <- 0; hit <- 1 }
    str_eq(nm, "json_set") ? { ar <- 3; exp <- TY.Str; ret <- TY.Str; exp2 <- 0; hit <- 1 }
    str_eq(nm, "json_del") ? { ar <- 2; exp <- TY.Str; ret <- TY.Str; exp2 <- 0; hit <- 1 }
    str_eq(nm, "net_listen") ? { ar <- 1; exp <- TY.Int; ret <- TY.Int; exp2 <- 0; hit <- 1 }
    str_eq(nm, "net_accept") ? { ar <- 1; exp <- TY.Int; ret <- TY.Int; exp2 <- 0; hit <- 1 }
    str_eq(nm, "net_connect") ? { ar <- 1; exp <- TY.Int; ret <- TY.Int; exp2 <- 0; hit <- 1 }
    str_eq(nm, "net_recv") ? { ar <- 1; exp <- TY.Int; ret <- TY.Str; exp2 <- 0; hit <- 1 }
    str_eq(nm, "net_send") ? { ar <- 2; exp <- TY.Int; ret <- TY.Int; exp2 <- TY.Str; hit <- 1 }
    str_eq(nm, "net_close") ? { ar <- 1; exp <- TY.Int; ret <- TY.Int; exp2 <- 0; hit <- 1 }
    str_eq(nm, "net_port") ? { ar <- 1; exp <- TY.Int; ret <- TY.Int; exp2 <- 0; hit <- 1 }
    str_eq(nm, "net_shutdown") ? { ar <- 1; exp <- TY.Int; ret <- TY.Int; exp2 <- 0; hit <- 1 }
    str_eq(nm, "http_method") ? { ar <- 1; exp <- TY.Str; ret <- TY.Str; exp2 <- 0; hit <- 1 }
    str_eq(nm, "http_path") ? { ar <- 1; exp <- TY.Str; ret <- TY.Str; exp2 <- 0; hit <- 1 }
    str_eq(nm, "http_header") ? { ar <- 2; exp <- TY.Str; ret <- TY.Str; exp2 <- 0; hit <- 1 }
    str_eq(nm, "ev_loop") ? { ar <- 0; exp <- TY.Int; ret <- TY.Int; exp2 <- 0; hit <- 1 }
    str_eq(nm, "ev_add") ? { ar <- 2; exp <- TY.Int; ret <- TY.Int; exp2 <- TY.Int; hit <- 1 }
    str_eq(nm, "ev_wait") ? { ar <- 2; exp <- TY.Int; ret <- TY.Int; exp2 <- TY.Int; hit <- 1 }
    str_eq(nm, "ev_ready") ? { ar <- 2; exp <- TY.Int; ret <- TY.Int; exp2 <- TY.Int; hit <- 1 }
    str_eq(nm, "clock_ms") ? { ar <- 0; exp <- TY.Int; ret <- TY.Int; exp2 <- 0; hit <- 1 }
    // M16.4: dynamic library loading (LANGUAGE_SPEC §19.11).
    str_eq(nm, "dl_open") ? { ar <- 1; exp <- TY.Str; ret <- TY.U64; exp2 <- 0; hit <- 1 }
    str_eq(nm, "dl_sym") ? { ar <- 2; exp <- TY.U64; ret <- TY.U64; exp2 <- TY.Str; hit <- 1 }
    str_eq(nm, "dl_error") ? { ar <- 0; exp <- TY.Int; ret <- TY.Str; exp2 <- 0; hit <- 1 }
    str_eq(nm, "dl_call") ? { ar <- 7; exp <- TY.U64; ret <- TY.Int; exp2 <- TY.Int; hit <- 1 }
    // M15: gated domain builtins only match inside std/ wrapper functions.
    hit == 1 && is_gated_name(nm) && vec_get(ctx, CX.IsStd) == 0 ? { hit <- 0; r <- 0 }
    hit == 0 ? { r <- 0 }    // hit == 1: check arity + arg types
    hit == 1 && c1 != ar ? { msg <- str_cat(str_cat(str_cat(nm, " expects exactly "), int_str(ar)), ar == 1 ? " argument" : " arguments"); s_diag(ctx, path, ln, 12, msg); vec_set(types, ni, ty_get(tp, tpn, ret)); r <- 1; hit <- 0 }
    hit == 1 && c1 == ar ? {
        s1 <- nd_get(nodes, ni, NF.L1s)
        j <- 0
        [j < c1] {
            ai <- vec_get(kids, s1 + j)
            ai != 0 - 1 ? {
                at <- vec_get(types, ai)
                at != 0 - 1 ? {
                    want <- j >= 1 && exp2 != 0 ? exp2 : exp
                    ak <- vec_get(tp, at * 8 + TF.Kind)
                    want != TY.Str || ak != TY.StrView ? {
                        unify(ctx, path, ln, tp, tpn, ty_get(tp, tpn, want), at, str_cat(nm, " argument"))
                    }
                }
            }
            j <- j + 1
        }
        vec_set(types, ni, ty_get(tp, tpn, ret))
        r <- 1
    }
    r
}


// The monolithic self-recursive check_node. Dispatches on node kind.
// All 25 AstKind cases are handled inline (Tiq allows only self-recursion).
check_node src:str path:str toks:vec[Token] nodes:vec[int] kids:vec[int] types:vec[int] en:vec[str] ed:vec[int] sc:vec[int] st_reg:vec[str] st_data:vec[int] st_names:vec[str] st_meta:vec[int] en_reg:vec[str] en_data:vec[int] fn_reg:vec[str] fn_data:vec[int] fpts:vec[int] frks:vec[int] tp:vec[int] tpn:vec[str] ctx:vec[int] ni:i64 : i64 -> {
    k <- 0 - 1; tok <- 0 - 1; ln <- 0; done <- 1
    ni != -1 ? { k <- nd_get(nodes, ni, NF.Kind); tok <- nd_get(nodes, ni, NF.Tok); ln <- tok != -1 ? tk_line(toks, tok) : 0; done <- 0 }

    // --- LITERAL ---
    done == 0 && k == AstKind.Literal ? {
        op <- nd_get(nodes, ni, NF.Op)
        p <- op == TokenKind.Int ? TY.Int : op == TokenKind.Float ? TY.Float : op == TokenKind.String ? TY.Str : (op == TokenKind.True || op == TokenKind.False) ? TY.Bool : op == TokenKind.None ? TY.Option : TY.Unknown
        op == TokenKind.Int ? { check_int_range(src, toks, ctx, path, tok) }
        vec_set(types, ni, ty_get(tp, tpn, p)); done <- 1
    }
    // --- IDENTIFIER ---
    done == 0 && k == AstKind.Identifier ? {
        nm <- tk_lex(src, toks, nd_get(nodes, ni, NF.Name))
        done == 0 ? {
            si <- env_lookup(en, ed, nm)
            si == -1 ? {
                ei <- enum_lookup(en_reg, en_data, nm)
                ei != -1 ? { s_diag(ctx, path, ln, 9, str_cat(str_cat(str_cat(str_cat("enum '", nm), "' is not a value; use "), nm), ".<variant>")); vec_set(types, ni, ty_get(tp, tpn, TY.Unknown)); done <- 1 }
                done == 0 ? { s_diag(ctx, path, ln, 8, str_cat(str_cat("undefined symbol '", nm), "'")); vec_set(types, ni, ty_get(tp, tpn, TY.Unknown)); done <- 1 }
            }
            done == 0 ? {
                vec_get(ed, si * 4 + 1) == 1 ? { s_diag(ctx, path, ln, 18, str_cat(str_cat("use of moved value '", nm), "'")); vec_set(types, ni, ty_get(tp, tpn, TY.Unknown)); done <- 1 }
                done == 0 ? {
                    st <- vec_get(ed, si * 4 + 2)
                    st != -1 ? { sk <- vec_get(tp, st * 8 + TF.Kind); sk == TY.Ref || sk == TY.RefMut ? { el <- vec_get(tp, st * 8 + TF.Elem); vec_set(types, ni, el != -1 ? el : ty_get(tp, tpn, TY.Unknown)); done <- 1 } }
                    done == 0 ? { vec_set(types, ni, st); done <- 1 }
                }
            }
        }
    }
    // --- BINARY ---
    done == 0 && k == AstKind.Binary ? {
        op <- nd_get(nodes, ni, NF.Op)
        op == TokenKind.DotDot && vec_get(ctx, CX.InRange) == 0 ? { s_diag(ctx, path, ln, 7, "range expressions 'a..b' are only valid inside loop or slice contexts") }
        check_node(src, path, toks, nodes, kids, types, en, ed, sc, st_reg, st_data, st_names, st_meta, en_reg, en_data, fn_reg, fn_data, fpts, frks, tp, tpn, ctx, nd_get(nodes, ni, NF.A))
        check_node(src, path, toks, nodes, kids, types, en, ed, sc, st_reg, st_data, st_names, st_meta, en_reg, en_data, fn_reg, fn_data, fpts, frks, tp, tpn, ctx, nd_get(nodes, ni, NF.B))
        ai <- nd_get(nodes, ni, NF.A); bi <- nd_get(nodes, ni, NF.B)
        lt <- ai != -1 ? vec_get(types, ai) : -1; rt <- bi != -1 ? vec_get(types, bi) : -1
        op == TokenKind.QuestionQuestion ? {
            lt != -1 && (vec_get(tp, lt * 8 + TF.Kind) == TY.Option || vec_get(tp, lt * 8 + TF.Kind) == TY.Result) ? { inner <- vec_get(tp, lt * 8 + TF.Inner); inner <- inner != -1 ? inner : ty_get(tp, tpn, TY.Unknown); rt != -1 && vec_get(tp, rt * 8 + TF.Kind) != TY.Unknown && vec_get(tp, inner * 8 + TF.Kind) != TY.Unknown ? { unify(ctx, path, ln, tp, tpn, inner, rt, "fallback type mismatch") }; vec_set(types, ni, inner); done <- 1 }
            done == 0 ? { s_diag(ctx, path, ln, 9, "fallback operator requires Option or Result on left side"); vec_set(types, ni, ty_get(tp, tpn, TY.Unknown)); done <- 1 }
        }
        done == 0 && lt != -1 && rt != -1 ? {
            u <- unify(ctx, path, ln, tp, tpn, lt, rt, "type mismatch")
            u != -1 ? {
                vec_get(tp, lt * 8 + TF.Kind) == TY.Unknown && ai != -1 ? { vec_set(types, ai, u) }
                vec_get(tp, rt * 8 + TF.Kind) == TY.Unknown && bi != -1 ? { vec_set(types, bi, u) }
                op == TokenKind.EqEq || op == TokenKind.BangEq || op == TokenKind.Lt || op == TokenKind.Lte || op == TokenKind.Gt || op == TokenKind.Gte ? { vec_set(types, ni, ty_get(tp, tpn, TY.Bool)); done <- 1 }
                done == 0 ? { vec_set(types, ni, ty_get(tp, tpn, vec_get(tp, u * 8 + TF.Kind))); done <- 1 }
            }
            done == 0 ? { vec_set(types, ni, ty_get(tp, tpn, TY.Unknown)); done <- 1 }
        }
        done == 0 ? { vec_set(types, ni, ty_get(tp, tpn, TY.Unknown)); done <- 1 }
    }
    // --- UNARY ---
    done == 0 && k == AstKind.Unary ? {
        op <- nd_get(nodes, ni, NF.Op); ri <- nd_get(nodes, ni, NF.A)
        op == TokenKind.Move ? {
            check_node(src, path, toks, nodes, kids, types, en, ed, sc, st_reg, st_data, st_names, st_meta, en_reg, en_data, fn_reg, fn_data, fpts, frks, tp, tpn, ctx, ri)
            ri != -1 && nd_get(nodes, ri, NF.Kind) == AstKind.Identifier ? { rname <- tk_lex(src, toks, nd_get(nodes, ri, NF.Name)); si <- env_lookup(en, ed, rname); si != -1 ? { vec_get(ed, si * 4 + 0) == 0 ? { s_diag(ctx, path, ln, 17, "cannot move an immutable binding") }; vec_get(ed, si * 4 + 0) != 0 && vec_get(ed, si * 4 + 1) == 0 ? { vec_set(ed, si * 4 + 1, 1) }} }
            rt <- ri != -1 ? vec_get(types, ri) : -1; vec_set(types, ni, rt != -1 ? rt : ty_get(tp, tpn, TY.Unknown)); done <- 1
        }
        op == TokenKind.Amp ? { check_node(src, path, toks, nodes, kids, types, en, ed, sc, st_reg, st_data, st_names, st_meta, en_reg, en_data, fn_reg, fn_data, fpts, frks, tp, tpn, ctx, ri); s_diag(ctx, path, ln, 7, "borrow is only valid as an argument to a reference parameter"); vec_set(types, ni, ty_get(tp, tpn, TY.Unknown)); done <- 1 }
        op == TokenKind.Question ? {
            check_node(src, path, toks, nodes, kids, types, en, ed, sc, st_reg, st_data, st_names, st_meta, en_reg, en_data, fn_reg, fn_data, fpts, frks, tp, tpn, ctx, ri)
            rt <- ri != -1 ? vec_get(types, ri) : -1
            rt != -1 && (vec_get(tp, rt * 8 + TF.Kind) == TY.Option || vec_get(tp, rt * 8 + TF.Kind) == TY.Result) ? { inner <- vec_get(tp, rt * 8 + TF.Inner); vec_set(types, ni, inner != -1 ? inner : ty_get(tp, tpn, TY.Unknown)); done <- 1 }
            done == 0 ? { s_diag(ctx, path, ln, 9, "propagation operator requires Option or Result operand"); vec_set(types, ni, ty_get(tp, tpn, TY.Unknown)); done <- 1 }
        }
        done == 0 ? { check_node(src, path, toks, nodes, kids, types, en, ed, sc, st_reg, st_data, st_names, st_meta, en_reg, en_data, fn_reg, fn_data, fpts, frks, tp, tpn, ctx, ri) }
        op == TokenKind.Bang ? { rt <- ri != -1 ? vec_get(types, ri) : -1; rt != -1 && vec_get(tp, rt * 8 + TF.Kind) != TY.Bool && vec_get(tp, rt * 8 + TF.Kind) != TY.Unknown ? { s_diag(ctx, path, ln, 9, str_cat("operand of '!' must be bool, found ", disp(tp, tpn, rt))) }; vec_set(types, ni, ty_get(tp, tpn, TY.Bool)); done <- 1 }
        done == 0 ? { rt <- ri != -1 ? vec_get(types, ri) : -1; vec_set(types, ni, rt != -1 ? rt : ty_get(tp, tpn, TY.Unknown)); done <- 1 }
    }
    // --- CONDITIONAL ---
    done == 0 && k == AstKind.Conditional ? {
        ai <- nd_get(nodes, ni, NF.A); bi <- nd_get(nodes, ni, NF.B); ci <- nd_get(nodes, ni, NF.C)
        check_node(src, path, toks, nodes, kids, types, en, ed, sc, st_reg, st_data, st_names, st_meta, en_reg, en_data, fn_reg, fn_data, fpts, frks, tp, tpn, ctx, ai)
        bi != 0 - 1 ? { check_node(src, path, toks, nodes, kids, types, en, ed, sc, st_reg, st_data, st_names, st_meta, en_reg, en_data, fn_reg, fn_data, fpts, frks, tp, tpn, ctx, bi) }
        ci != 0 - 1 ? { check_node(src, path, toks, nodes, kids, types, en, ed, sc, st_reg, st_data, st_names, st_meta, en_reg, en_data, fn_reg, fn_data, fpts, frks, tp, tpn, ctx, ci) }
        ct <- ai != 0 - 1 ? vec_get(types, ai) : 0 - 1
        ct != 0 - 1 && vec_get(tp, ct * 8 + TF.Kind) != TY.Bool ? { s_diag(ctx, path, ln, 14, "conditional condition must be bool") }
        tt <- bi != 0 - 1 ? vec_get(types, bi) : 0 - 1; et <- ci != 0 - 1 ? vec_get(types, ci) : 0 - 1
        tt != 0 - 1 && et != 0 - 1 ? { u <- unify(ctx, path, ln, tp, tpn, tt, et, "type mismatch"); u != 0 - 1 ? { vec_get(tp, tt * 8 + TF.Kind) == TY.Unknown && bi != 0 - 1 ? { vec_set(types, bi, u) }; vec_get(tp, et * 8 + TF.Kind) == TY.Unknown && ci != 0 - 1 ? { vec_set(types, ci, u) }; vec_set(types, ni, u); done <- 1 }; done == 0 ? { vec_set(types, ni, tt); done <- 1 } }
        done == 0 && tt != 0 - 1 && ci == 0 - 1 ? { vec_set(types, ni, ty_get(tp, tpn, TY.Unit)); done <- 1 }
        done == 0 && tt != 0 - 1 ? { vec_set(types, ni, tt); done <- 1 }
        done == 0 ? { vec_set(types, ni, ty_get(tp, tpn, TY.Unknown)); done <- 1 }
    }
    // --- CALL ---
    done == 0 && k == AstKind.Call ? {
        ci <- nd_get(nodes, ni, NF.A); s1 <- nd_get(nodes, ni, NF.L1s); c1 <- nd_get(nodes, ni, NF.L1n)
        is_bracket <- nd_get(nodes, ni, NF.F1); is_slice <- nd_get(nodes, ni, NF.F2)
        handled <- 0
        // Builtin dispatch by callee name
        handled == 0 && ci != -1 && nd_get(nodes, ci, NF.Kind) == AstKind.Identifier ? {
            cnm <- tk_lex(src, toks, nd_get(nodes, ci, NF.Name))
            str_eq(cnm, "print") ? {
                c1 != 1 ? { s_diag(ctx, path, ln, 12, "print expects exactly 1 argument") }
                c1 == 1 ? {
                    ai0 <- vec_get(kids, s1)
                    ai0 != 0 - 1 ? { check_node(src, path, toks, nodes, kids, types, en, ed, sc, st_reg, st_data, st_names, st_meta, en_reg, en_data, fn_reg, fn_data, fpts, frks, tp, tpn, ctx, ai0) }
                    at <- ai0 != 0 - 1 ? vec_get(types, ai0) : 0 - 1
                    at != 0 - 1 ? { ak <- vec_get(tp, at * 8 + TF.Kind); ak != TY.Int && ak != TY.Float && ak != TY.Bool && ak != TY.Str && ak != TY.StrView && ak != TY.Slice && ak != TY.I8 && ak != TY.I16 && ak != TY.I32 && ak != TY.U8 && ak != TY.U16 && ak != TY.U32 && ak != TY.U64 && ak != TY.F32 && ak != TY.Unknown ? { s_diag(ctx, path, ln, 9, str_cat("print cannot print ", disp(tp, tpn, at))) }}
                }
                vec_set(types, ni, ty_get(tp, tpn, TY.Int)); handled <- 1
            }
            str_eq(cnm, "len") ? {
                c1 != 1 ? { s_diag(ctx, path, ln, 12, "len expects exactly 1 argument") }
                c1 == 1 ? {
                    ai0 <- vec_get(kids, s1)
                    ai0 != 0 - 1 ? { check_node(src, path, toks, nodes, kids, types, en, ed, sc, st_reg, st_data, st_names, st_meta, en_reg, en_data, fn_reg, fn_data, fpts, frks, tp, tpn, ctx, ai0) }
                    at <- ai0 != 0 - 1 ? vec_get(types, ai0) : 0 - 1
                    ak <- at != 0 - 1 ? vec_get(tp, at * 8 + TF.Kind) : 0 - 1
                    at == 0 - 1 || (ak != TY.Array && ak != TY.Slice && ak != TY.Str && ak != TY.StrView && ak != TY.Unknown) ? { s_diag(ctx, path, ln, 9, "len expects an array argument") }
                }
                vec_set(types, ni, ty_get(tp, tpn, TY.Int)); handled <- 1
            }
            str_eq(cnm, "some") ? {
                c1 != 1 ? { s_diag(ctx, path, ln, 12, "some expects exactly 1 argument") }
                c1 == 1 ? {
                    ai0 <- vec_get(kids, s1)
                    ai0 != 0 - 1 ? { check_node(src, path, toks, nodes, kids, types, en, ed, sc, st_reg, st_data, st_names, st_meta, en_reg, en_data, fn_reg, fn_data, fpts, frks, tp, tpn, ctx, ai0) }
                    at <- ai0 != 0 - 1 ? vec_get(types, ai0) : 0 - 1
                    at != 0 - 1 && vec_get(tp, at * 8 + TF.Kind) != TY.Unknown ? { vec_set(types, ni, ty_option(tp, tpn, at)) }
                    at == 0 - 1 || vec_get(tp, at * 8 + TF.Kind) == TY.Unknown ? { vec_set(types, ni, ty_get(tp, tpn, TY.Option)) }
                }
                handled <- 1
            }
            str_eq(cnm, "ok") ? {
                c1 != 1 ? { s_diag(ctx, path, ln, 12, "ok expects exactly 1 argument") }
                c1 == 1 ? {
                    ai0 <- vec_get(kids, s1)
                    ai0 != 0 - 1 ? { check_node(src, path, toks, nodes, kids, types, en, ed, sc, st_reg, st_data, st_names, st_meta, en_reg, en_data, fn_reg, fn_data, fpts, frks, tp, tpn, ctx, ai0) }
                    at <- ai0 != 0 - 1 ? vec_get(types, ai0) : 0 - 1
                    at != 0 - 1 && vec_get(tp, at * 8 + TF.Kind) != TY.Unknown ? { vec_set(types, ni, ty_result(tp, tpn, at, ty_get(tp, tpn, TY.Int))) }
                    at == 0 - 1 || vec_get(tp, at * 8 + TF.Kind) == TY.Unknown ? { vec_set(types, ni, ty_get(tp, tpn, TY.Result)) }
                }
                handled <- 1
            }
            str_eq(cnm, "err") ? {
                c1 != 1 ? { s_diag(ctx, path, ln, 12, "err expects exactly 1 argument") }
                c1 == 1 ? {
                    ai0 <- vec_get(kids, s1)
                    ai0 != 0 - 1 ? { check_node(src, path, toks, nodes, kids, types, en, ed, sc, st_reg, st_data, st_names, st_meta, en_reg, en_data, fn_reg, fn_data, fpts, frks, tp, tpn, ctx, ai0) }
                    at <- ai0 != 0 - 1 ? vec_get(types, ai0) : 0 - 1
                    at != 0 - 1 && vec_get(tp, at * 8 + TF.Kind) != TY.Unknown ? { vec_set(types, ni, ty_result(tp, tpn, ty_get(tp, tpn, TY.Int), at)) }
                    at == 0 - 1 || vec_get(tp, at * 8 + TF.Kind) == TY.Unknown ? { vec_set(types, ni, ty_get(tp, tpn, TY.Result)) }
                }
                handled <- 1
            }
            str_eq(cnm, "vec_new") || str_eq(cnm, "vec_push") || str_eq(cnm, "vec_get") || str_eq(cnm, "vec_set") || str_eq(cnm, "vec_len") || str_eq(cnm, "vec_pop") ? {
                j <- 0; [j < c1] { ai <- vec_get(kids, s1 + j); ai != 0 - 1 ? { check_node(src, path, toks, nodes, kids, types, en, ed, sc, st_reg, st_data, st_names, st_meta, en_reg, en_data, fn_reg, fn_data, fpts, frks, tp, tpn, ctx, ai) }; j <- j + 1 }
                chk_vec(src, toks, ctx, path, nodes, kids, types, en, ed, tp, tpn, ni, cnm); handled <- 1
            }
            str_eq(cnm, "str_buf_new") || str_eq(cnm, "str_buf_append") || str_eq(cnm, "str_buf_to_str") || str_eq(cnm, "str_buf_len") ? {
                j <- 0; [j < c1] { ai <- vec_get(kids, s1 + j); ai != 0 - 1 ? { check_node(src, path, toks, nodes, kids, types, en, ed, sc, st_reg, st_data, st_names, st_meta, en_reg, en_data, fn_reg, fn_data, fpts, frks, tp, tpn, ctx, ai) }; j <- j + 1 }
                chk_sb(ctx, path, toks, nodes, kids, types, tp, tpn, ni, cnm); handled <- 1
            }
            str_eq(cnm, "map_new") || str_eq(cnm, "map_set") || str_eq(cnm, "map_get") || str_eq(cnm, "map_has") || str_eq(cnm, "map_len") || str_eq(cnm, "map_key_at") || str_eq(cnm, "map_val_at") ? {
                j <- 0; [j < c1] { ai <- vec_get(kids, s1 + j); ai != 0 - 1 ? { check_node(src, path, toks, nodes, kids, types, en, ed, sc, st_reg, st_data, st_names, st_meta, en_reg, en_data, fn_reg, fn_data, fpts, frks, tp, tpn, ctx, ai) }; j <- j + 1 }
                chk_map(ctx, path, toks, nodes, kids, types, tp, tpn, ni, cnm); handled <- 1
            }
            handled == 0 ? {
