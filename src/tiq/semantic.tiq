                    it <- vec_get(types, idx)
                    it != -1 && vec_get(tp, it * 8 + TF.Kind) != TY.Int ? { s_diag(ctx, path, ln, 9, "array index must be int") }
                    st != -1 && vec_get(tp, st * 8 + TF.Kind) != TY.Array && vec_get(tp, st * 8 + TF.Kind) != TY.Slice ? { s_diag(ctx, path, ln, 9, "cannot index non-array") }
