                gen_ar != 0 - 1 && c1 == gen_ar ? {
                    j <- 0; [j < c1] { ai <- vec_get(kids, s1 + j); ai != 0 - 1 ? { check_node(src, path, toks, nodes, kids, types, en, ed, sc, st_reg, st_data, st_names, st_meta, en_reg, en_data, fn_reg, fn_data, fpts, frks, tp, tpn, ctx, ai) }; j <- j + 1 }
                }
                bi_f <- chk_generic(ctx, path, toks, nodes, kids, types, tp, tpn, ni, cnm, c1)
                handled <- bi_f
            }
        }
        // Type conversions
        handled == 0 && ci != -1 && nd_get(nodes, ci, NF.Kind) == AstKind.Identifier ? {
            cnm <- tk_lex(src, toks, nd_get(nodes, ci, NF.Name)); tgt <- 0 - 1
            str_eq(cnm, "i8") ? { tgt <- TY.I8 }            str_eq(cnm, "i16") ? { tgt <- TY.I16 }            str_eq(cnm, "i32") ? { tgt <- TY.I32 }            str_eq(cnm, "i64") ? { tgt <- TY.Int }            str_eq(cnm, "u8") ? { tgt <- TY.U8 }            str_eq(cnm, "u16") ? { tgt <- TY.U16 }            str_eq(cnm, "u32") ? { tgt <- TY.U32 }            str_eq(cnm, "u64") ? { tgt <- TY.U64 }            str_eq(cnm, "f32") ? { tgt <- TY.F32 }            str_eq(cnm, "f64") ? { tgt <- TY.Float }            str_eq(cnm, "bool") ? { tgt <- TY.Bool }            str_eq(cnm, "str") ? { tgt <- TY.Str }            tgt != -1 ? {
                c1 != 1 ? {
                    s_diag(ctx, path, ln, 12, "type conversion requires exactly 1 argument")
                    vec_set(types, ni, ty_get(tp, tpn, TY.Unknown))
                    j <- 0; [j < c1] { ai <- vec_get(kids, s1 + j); ai != 0 - 1 ? { check_node(src, path, toks, nodes, kids, types, en, ed, sc, st_reg, st_data, st_names, st_meta, en_reg, en_data, fn_reg, fn_data, fpts, frks, tp, tpn, ctx, ai) }; j <- j + 1 }
                    handled <- 1
                }
                c1 == 1 ? {
                    ai0 <- vec_get(kids, s1)
                    ai0 != 0 - 1 ? { check_node(src, path, toks, nodes, kids, types, en, ed, sc, st_reg, st_data, st_names, st_meta, en_reg, en_data, fn_reg, fn_data, fpts, frks, tp, tpn, ctx, ai0) }
                    st2 <- ai0 != 0 - 1 ? vec_get(types, ai0) : 0 - 1
                    src_k <- st2 != 0 - 1 ? vec_get(tp, st2 * 8 + TF.Kind) : TY.Unknown
                    src_num <- src_k == TY.Int || src_k == TY.Float || src_k == TY.I8 || src_k == TY.I16 || src_k == TY.I32 || src_k == TY.U8 || src_k == TY.U16 || src_k == TY.U32 || src_k == TY.U64 || src_k == TY.F32 ? 1 : 0
                    tgt_num <- tgt == TY.Int || tgt == TY.Float || tgt == TY.I8 || tgt == TY.I16 || tgt == TY.I32 || tgt == TY.U8 || tgt == TY.U16 || tgt == TY.U32 || tgt == TY.U64 || tgt == TY.F32 ? 1 : 0
                    conv_ok <- src_k == TY.Unknown ? 1 : (src_num == 1 && tgt_num == 1) ? 1 : src_k == tgt ? 1 : 0
                    conv_ok == 0 ? { td <- tgt == TY.Int ? "i64" : tgt == TY.Float ? "f64" : kind_disp(tgt); s_diag(ctx, path, ln, 10, str_cat(str_cat("cannot convert ", disp(tp, tpn, st2)), str_cat(" to ", td))); vec_set(types, ni, ty_get(tp, tpn, TY.Unknown)); handled <- 1 }
                    conv_ok != 0 ? { vec_set(types, ni, ty_get(tp, tpn, tgt)); handled <- 1 }
                }
            }
        }
        // User function calls + indexing/slicing
        handled == 0 ? {
            check_node(src, path, toks, nodes, kids, types, en, ed, sc, st_reg, st_data, st_names, st_meta, en_reg, en_data, fn_reg, fn_data, fpts, frks, tp, tpn, ctx, ci)
            callee_t <- ci != -1 ? vec_get(types, ci) : -1
            // Bracket call: indexing/slicing
            is_bracket == 1 && callee_t != -1 ? {
                j <- 0; [j < c1] { ai <- vec_get(kids, s1 + j); ai != 0 - 1 ? { check_node(src, path, toks, nodes, kids, types, en, ed, sc, st_reg, st_data, st_names, st_meta, en_reg, en_data, fn_reg, fn_data, fpts, frks, tp, tpn, ctx, ai) }; j <- j + 1 }
                bk <- vec_get(tp, callee_t * 8 + TF.Kind)
                is_slice == 1 ? {
                    bk == TY.Array || bk == TY.Slice ? { j <- 0; [j < c1 && j < 2] { ai <- vec_get(kids, s1 + j); ai != 0 - 1 ? { it <- vec_get(types, ai); it != 0 - 1 && vec_get(tp, it * 8 + TF.Kind) != TY.Int ? { s_diag(ctx, path, ln, 9, "slice index must be int") }}; j <- j + 1 }; el <- vec_get(tp, callee_t * 8 + TF.Elem); vec_set(types, ni, ty_slice(tp, tpn, el != 0 - 1 ? el : ty_get(tp, tpn, TY.Int))); handled <- 1 }
                    handled == 0 && (bk == TY.Str || bk == TY.StrView) ? { j <- 0; [j < c1 && j < 2] { ai <- vec_get(kids, s1 + j); ai != 0 - 1 ? { it <- vec_get(types, ai); it != 0 - 1 && vec_get(tp, it * 8 + TF.Kind) != TY.Int ? { s_diag(ctx, path, ln, 9, "slice index must be int") }}; j <- j + 1 }; vec_set(types, ni, ty_get(tp, tpn, TY.StrView)); handled <- 1 }
                    handled == 0 && bk == TY.Stream ? { s_diag(ctx, path, ln, 9, "cannot range-slice a stream generator"); vec_set(types, ni, ty_get(tp, tpn, TY.Unknown)); handled <- 1 }
                    handled == 0 ? { s_diag(ctx, path, ln, 9, "cannot slice non-array"); vec_set(types, ni, ty_get(tp, tpn, TY.Unknown)); handled <- 1 }
                }
                // Index
                is_slice == 0 && (bk == TY.Array || bk == TY.Slice || bk == TY.Unknown) ? {
                    bk == TY.Unknown && ci != 0 - 1 && nd_get(nodes, ci, NF.Kind) == AstKind.Identifier ? { si <- env_lookup(en, ed, tk_lex(src, toks, nd_get(nodes, ci, NF.Name))); si != 0 - 1 && vec_get(ed, si * 4 + 2) != 0 - 1 && vec_get(tp, vec_get(ed, si * 4 + 2) * 8 + TF.Kind) == TY.Unknown ? { nt <- ty_slice(tp, tpn, ty_get(tp, tpn, TY.Int)); vec_set(ed, si * 4 + 2, nt); vec_set(types, ci, nt); callee_t <- nt } }
                    c1 >= 1 ? { ai0 <- vec_get(kids, s1); ai0 != 0 - 1 ? { it <- vec_get(types, ai0); it != 0 - 1 && vec_get(tp, it * 8 + TF.Kind) != TY.Int ? { s_diag(ctx, path, ln, 9, "array index must be int") }} }
                    el <- vec_get(tp, callee_t * 8 + TF.Elem)
                    vec_set(types, ni, el != 0 - 1 ? el : ty_get(tp, tpn, TY.Unknown)); handled <- 1
                }
                is_slice == 0 && (bk == TY.Str || bk == TY.StrView) ? { c1 >= 1 ? { ai0 <- vec_get(kids, s1); ai0 != 0 - 1 ? { it <- vec_get(types, ai0); it != 0 - 1 && vec_get(tp, it * 8 + TF.Kind) != TY.Int ? { s_diag(ctx, path, ln, 9, "string index must be int") }} }; vec_set(types, ni, ty_get(tp, tpn, TY.Int)); handled <- 1 }
                is_slice == 0 && bk == TY.Stream ? { c1 >= 1 ? { ai0 <- vec_get(kids, s1); ai0 != 0 - 1 ? { it <- vec_get(types, ai0); it != 0 - 1 && vec_get(tp, it * 8 + TF.Kind) != TY.Int ? { s_diag(ctx, path, ln, 9, "stream index must be int") }} }; vec_set(types, ni, ty_get(tp, tpn, TY.Int)); handled <- 1 }
            }
            // Regular function call
            handled == 0 && callee_t != -1 ? { ck <- vec_get(tp, callee_t * 8 + TF.Kind); is_bracket == 0 && ck != TY.Struct && ck != TY.Vec ? { pc <- vec_get(tp, callee_t * 8 + TF.Pc); pc >= 0 && pc != c1 ? { s_diag(ctx, path, ln, 12, "arity mismatch") }} }
            // Borrow-aware argument checking
            fn_def <- -1; fn_pb <- 0
            is_bracket == 0 && ci != -1 && nd_get(nodes, ci, NF.Kind) == AstKind.Identifier ? { cnm <- tk_lex(src, toks, nd_get(nodes, ci, NF.Name)); fi <- vec_len(fn_reg) / 2 - 1; [fi >= 0 && fn_def == -1] { str_eq(vec_get(fn_reg, fi * 2), cnm) ? { fn_def <- vec_get(fn_data, fi * 2); fn_pb <- vec_get(fn_data, fi * 2 + 1); break }; fi <- fi - 1 } }
            fn_def != -1 && callee_t != -1 && vec_get(tp, callee_t * 8 + TF.Kind) == TY.Vec ? { fpc <- nd_get(nodes, fn_def, NF.L1n); fpc != c1 ? { s_diag(ctx, path, ln, 12, "arity mismatch") }}
            rec_names <- vec_new(); vec_push(rec_names, "")
            rec_muts <- vec_new(); vec_push(rec_muts, 0)
            j <- 0
            [j < c1] {
                ai <- vec_get(kids, s1 + j)
                done_arg <- 0
                ai == -1 ? { done_arg <- 1 }                arg_is_borrow <- 0; want_ref <- 0
                done_arg == 0 ? { arg_is_borrow <- nd_get(nodes, ai, NF.Kind) == AstKind.Unary && nd_get(nodes, ai, NF.Op) == TokenKind.Amp ? 1 : 0 }                done_arg == 0 && fn_def != -1 && j < nd_get(nodes, fn_def, NF.L1n) ? { want_ref <- vec_get(frks, fn_pb + j) }                // Non-borrow argument (mirrors C: check_node + want_ref diag + container establish + continue)
                done_arg == 0 && arg_is_borrow == 0 ? {
                    check_node(src, path, toks, nodes, kids, types, en, ed, sc, st_reg, st_data, st_names, st_meta, en_reg, en_data, fn_reg, fn_data, fpts, frks, tp, tpn, ctx, ai)
                    // M16.2: extern calls check argument types against the
                    // declared C ABI signature (LANGUAGE_SPEC §7.1);
                    // containers never reach here (rejected at the decl).
                    fn_def != 0 - 1 && nd_get(nodes, fn_def, NF.Kind) == AstKind.Extern && j < nd_get(nodes, fn_def, NF.L1n) ? {
                        ept <- vec_get(fpts, fn_pb + j)
                        ept != 0 - 1 ? { unify(ctx, path, ln, tp, tpn, ept, vec_get(types, ai), str_cat("argument ", int_str(j + 1))) }
                    }
                    want_ref != 0 ? { msg <- str_cat(str_cat("argument ", int_str(j + 1)), str_cat(" must be borrowed with ", want_ref == 2 ? "&mut" : "&")); s_diag(ctx, path, ln, 23, msg) }
                    fn_def != -1 && j < nd_get(nodes, fn_def, NF.L1n) ? {
                        cpt <- vec_get(fpts, fn_pb + j)
                        cpt != -1 ? {
                            cpk <- vec_get(tp, cpt * 8 + TF.Kind)
                            cpk == TY.Vec || cpk == TY.Strbuf || cpk == TY.Map ? {
                                at <- vec_get(types, ai)
                                wh <- str_cat("argument ", int_str(j + 1))
                                u <- unify(ctx, path, ln, tp, tpn, cpt, at, wh)
                                u != -1 && at != -1 && cpk == TY.Vec && vec_get(tp, at * 8 + TF.Kind) == TY.Vec ? {
                                    ce <- vec_get(tp, cpt * 8 + TF.Elem)
                                    ae <- vec_get(tp, at * 8 + TF.Elem)
                                    ce != -1 && ae != -1 && vec_elem_same(tp, ce, ae) == 0 ? { msg <- str_cat(str_cat(wh, ": expected "), disp(tp, tpn, cpt)); msg <- str_cat(msg, str_cat(", found ", disp(tp, tpn, at))); s_diag(ctx, path, ln, 9, msg) }
                                    ae == -1 && ce != -1 ? {
                                        nd_get(nodes, ai, NF.Kind) == AstKind.Identifier ? { asi <- env_lookup(en, ed, tk_lex(src, toks, nd_get(nodes, ai, NF.Name))); asi != -1 && vec_get(ed, asi * 4 + 2) == at ? { env_set_type(en, ed, tk_lex(src, toks, nd_get(nodes, ai, NF.Name)), cpt) }}
                                        vec_set(types, ai, cpt)
                                    }
                                }
                            }
                        }
                    }
                }
                // Borrow to by-value parameter
                done_arg == 0 && arg_is_borrow == 1 && want_ref == 0 ? { msg <- str_cat(str_cat("argument ", int_str(j + 1)), " cannot be a borrow: parameter is by value"); s_diag(ctx, path, ln, 23, msg); ri <- nd_get(nodes, ai, NF.A); ri != -1 ? { check_node(src, path, toks, nodes, kids, types, en, ed, sc, st_reg, st_data, st_names, st_meta, en_reg, en_data, fn_reg, fn_data, fpts, frks, tp, tpn, ctx, ri) }; vec_set(types, ai, ty_get(tp, tpn, TY.Unknown)); done_arg <- 1 }
                // Borrow to reference parameter
                done_arg == 0 && arg_is_borrow == 1 && want_ref != 0 ? {
                    is_mut <- nd_get(nodes, ai, NF.F1)
                    (want_ref == 2 ? 1 : 0) != is_mut ? { s_diag(ctx, path, ln, 23, str_cat(str_cat("argument ", int_str(j + 1)), str_cat(" must be borrowed with ", want_ref == 2 ? "&mut" : "&"))) }
                    operand <- nd_get(nodes, ai, NF.A)
                    operand == -1 || nd_get(nodes, operand, NF.Kind) != AstKind.Identifier ? { s_diag(ctx, path, tk_line(toks, nd_get(nodes, ai, NF.Tok)), 23, "borrow operand must be a named binding"); operand != -1 ? { check_node(src, path, toks, nodes, kids, types, en, ed, sc, st_reg, st_data, st_names, st_meta, en_reg, en_data, fn_reg, fn_data, fpts, frks, tp, tpn, ctx, operand) }; vec_set(types, ai, ty_get(tp, tpn, TY.Unknown)); done_arg <- 1 }
                    done_arg == 0 ? {
                        check_node(src, path, toks, nodes, kids, types, en, ed, sc, st_reg, st_data, st_names, st_meta, en_reg, en_data, fn_reg, fn_data, fpts, frks, tp, tpn, ctx, operand)
                        ref_name <- tk_lex(src, toks, nd_get(nodes, operand, NF.Name))
                        bsi <- env_lookup(en, ed, ref_name)
                        bsi != -1 ? {
                            bst <- vec_get(ed, bsi * 4 + 2)
                            bst != -1 && (vec_get(tp, bst * 8 + TF.Kind) == TY.Ref || vec_get(tp, bst * 8 + TF.Kind) == TY.RefMut) ? { s_diag(ctx, path, ln, 23, str_cat(str_cat("cannot re-borrow reference parameter '", ref_name), "'")) }
                            is_mut == 1 && vec_get(ed, bsi * 4 + 0) == 0 ? { s_diag(ctx, path, ln, 23, str_cat(str_cat("cannot borrow immutable binding '", ref_name), "' as mutable")) }
                        }
                        fn_def != -1 && j < nd_get(nodes, fn_def, NF.L1n) ? { pt <- vec_get(fpts, fn_pb + j); pt != -1 ? { pk <- vec_get(tp, pt * 8 + TF.Kind); pk == TY.Ref || pk == TY.RefMut ? { pel <- vec_get(tp, pt * 8 + TF.Elem); ot <- vec_get(types, operand); pel != -1 ? { unify(ctx, path, ln, tp, tpn, pel, ot, str_cat("argument ", int_str(j + 1))) }} } }
                        ri2 <- 1; conflict <- 0
                        [ri2 < vec_len(rec_names) && conflict == 0] {
                            str_eq(vec_get(rec_names, ri2), ref_name) ? {
                                vec_get(rec_muts, ri2) == 1 && is_mut == 1 ? { s_diag(ctx, path, ln, 23, str_cat(str_cat("cannot borrow '", ref_name), "' as mutable more than once in a call")); conflict <- 1 }
                                conflict == 0 && (vec_get(rec_muts, ri2) == 1 || is_mut == 1) ? { s_diag(ctx, path, ln, 23, str_cat(str_cat("cannot borrow '", ref_name), "' as both mutable and shared in a call")); conflict <- 1 }
                            }
                            ri2 <- ri2 + 1
                        }
                        vec_push(rec_names, ref_name); vec_push(rec_muts, is_mut)
                        ot <- operand != -1 ? vec_get(types, operand) : ty_get(tp, tpn, TY.Unknown)
                        vec_set(types, ai, ty_ref(tp, tpn, ot != -1 ? ot : ty_get(tp, tpn, TY.Unknown), is_mut))
                    }
                }
                j <- j + 1
            }
            handled == 0 && callee_t != -1 ? { vec_set(types, ni, callee_t); handled <- 1 }
            handled == 0 ? { vec_set(types, ni, ty_get(tp, tpn, TY.Unknown)); handled <- 1 }
        }
        handled == 0 ? { check_node(src, path, toks, nodes, kids, types, en, ed, sc, st_reg, st_data, st_names, st_meta, en_reg, en_data, fn_reg, fn_data, fpts, frks, tp, tpn, ctx, ci); vec_set(types, ni, ty_get(tp, tpn, TY.Unknown)) }
        done <- 1
    }

    // --- BLOCK ---
    done == 0 && k == AstKind.Block ? {
        env_push_scope(sc, en)
        s1 <- nd_get(nodes, ni, NF.L1s); c1 <- nd_get(nodes, ni, NF.L1n)
        s2 <- nd_get(nodes, ni, NF.L2s); c2 <- nd_get(nodes, ni, NF.L2n)
        fi <- nd_get(nodes, ni, NF.C)
        j <- 0; [j < c1] { si <- vec_get(kids, s1 + j); check_node(src, path, toks, nodes, kids, types, en, ed, sc, st_reg, st_data, st_names, st_meta, en_reg, en_data, fn_reg, fn_data, fpts, frks, tp, tpn, ctx, si); j <- j + 1 }
        j <- 0; [j < c2] { si <- vec_get(kids, s2 + j); check_node(src, path, toks, nodes, kids, types, en, ed, sc, st_reg, st_data, st_names, st_meta, en_reg, en_data, fn_reg, fn_data, fpts, frks, tp, tpn, ctx, si); j <- j + 1 }
        fi != -1 ? { check_node(src, path, toks, nodes, kids, types, en, ed, sc, st_reg, st_data, st_names, st_meta, en_reg, en_data, fn_reg, fn_data, fpts, frks, tp, tpn, ctx, fi) }
        env_pop_scope(sc, en, ed)
        vec_set(types, ni, ty_get(tp, tpn, TY.Unknown)); done <- 1
    }
    // --- BINDING ---
    done == 0 && k == AstKind.Binding ? {
        is_mut <- nd_get(nodes, ni, NF.F1)
        nm <- tk_lex(src, toks, nd_get(nodes, ni, NF.Name))
        ei <- nd_get(nodes, ni, NF.A)
        // Issue #6: `<-` and `=` never shadow an existing binding. Resolve
        // outward via env lookup (nearest-first), then:
        //   =   with an existing binding => E11 redefinition
        //   <-  on an immutable binding  => E11 (no shadow fallback)
        //   <-  on a mutable binding     => reassign (M9.2-D rewrite)
        //   no binding anywhere          => declare in current scope
        prev <- env_lookup(en, ed, nm)
        prev != -1 && is_mut == 0 ? { s_diag(ctx, path, ln, 11, str_cat(str_cat("cannot redefine binding '", nm), "'")); vec_set(types, ni, ty_get(tp, tpn, TY.Unknown)); done <- 1 }
        done == 0 && prev != -1 && is_mut == 1 && vec_get(ed, prev * 4 + 0) == 0 ? { s_diag(ctx, path, ln, 11, str_cat(str_cat("cannot mutate immutable binding '", nm), "'")); vec_set(types, ni, ty_get(tp, tpn, TY.Unknown)); done <- 1 }
        done == 0 && prev != -1 && is_mut == 1 && vec_get(ed, prev * 4 + 0) == 1 ? {
            // Rewrite to Assign in-place: set Kind=Assign, Op=Larrow.
            // Assign layout matches the name: A=expr, B=index. The binding's
            // expr already sits in A; a rebind has no index, so clear B.
            nd_set(nodes, ni, NF.Kind, AstKind.Assign)
            nd_set(nodes, ni, NF.Op, TokenKind.Larrow)
            nd_set(nodes, ni, NF.F1, 0)
            nd_set(nodes, ni, NF.B, 0 - 1)
            // Now fall through to the Assign case below
            done <- 0
        }
        done == 0 ? {
            check_node(src, path, toks, nodes, kids, types, en, ed, sc, st_reg, st_data, st_names, st_meta, en_reg, en_data, fn_reg, fn_data, fpts, frks, tp, tpn, ctx, ei)
            bt <- ei != -1 ? vec_get(types, ei) : -1
            tp_b <- bt != -1 ? bt : ty_get(tp, tpn, TY.Unknown)
            env_define(en, ed, sc, nm, is_mut, tp_b, ln)
            vec_set(types, ni, tp_b); done <- 1
        }
    }
    // --- ASSIGN ---
    done == 0 && k == AstKind.Assign ? {
        ei <- nd_get(nodes, ni, NF.A); idx <- nd_get(nodes, ni, NF.B)
        check_node(src, path, toks, nodes, kids, types, en, ed, sc, st_reg, st_data, st_names, st_meta, en_reg, en_data, fn_reg, fn_data, fpts, frks, tp, tpn, ctx, ei)
        nm <- tk_lex(src, toks, nd_get(nodes, ni, NF.Name))
        op <- nd_get(nodes, ni, NF.Op)
        si <- env_lookup(en, ed, nm)
        def <- 0
        si == -1 ? {
            op == TokenKind.Eq || op == TokenKind.Larrow ? {
                bt <- ei != -1 ? vec_get(types, ei) : -1
                tp_b <- bt != -1 ? bt : ty_get(tp, tpn, TY.Unknown)
                is_mut <- op == TokenKind.Larrow ? 1 : 0
                env_define(en, ed, sc, nm, is_mut, tp_b, ln)
                nd_set(nodes, ni, NF.F1, 1)
                si <- env_lookup(en, ed, nm)
                def <- 1
            }
            si == -1 ? { s_diag(ctx, path, ln, 8, str_cat(str_cat("undefined symbol '", nm), "'")); vec_set(types, ni, ty_get(tp, tpn, TY.Unknown)); done <- 1 }
        }
        si != -1 && def == 0 ? {
            st <- vec_get(ed, si * 4 + 2)
            hand <- 0
            st != -1 ? {
                sk <- vec_get(tp, st * 8 + TF.Kind)
                sk == TY.Ref ? { s_diag(ctx, path, ln, 23, str_cat(str_cat("cannot assign through shared borrow '", nm), "'")); hand <- 1 }
                sk == TY.RefMut ? { vec_set(ed, si * 4 + 1, 0); hand <- 1 }
            }
            hand == 0 && vec_get(ed, si * 4 + 0) == 0 ? { s_diag(ctx, path, ln, 11, "cannot assign to immutable binding"); hand <- 1 }
            hand == 0 ? {
                vec_set(ed, si * 4 + 1, 0)
                idx != -1 ? {
                    check_node(src, path, toks, nodes, kids, types, en, ed, sc, st_reg, st_data, st_names, st_meta, en_reg, en_data, fn_reg, fn_data, fpts, frks, tp, tpn, ctx, idx)
                    it <- vec_get(types, idx)
                    it != -1 && vec_get(tp, it * 8 + TF.Kind) != TY.Int ? { s_diag(ctx, path, ln, 9, "array index must be int") }
                    st != -1 && vec_get(tp, st * 8 + TF.Kind) != TY.Array && vec_get(tp, st * 8 + TF.Kind) != TY.Slice ? { s_diag(ctx, path, ln, 9, "cannot index non-array") }
                }
            }
            vec_set(types, ni, st != -1 ? st : ty_get(tp, tpn, TY.Unknown))
        }
        def == 1 ? { st2 <- vec_get(ed, si * 4 + 2); vec_set(types, ni, st2 != -1 ? st2 : ty_get(tp, tpn, TY.Unknown)) }
        done <- 1
    }
    // --- FUNCTION ---
    done == 0 && k == AstKind.Function ? {
        nm <- tk_lex(src, toks, nd_get(nodes, ni, NF.Name))
        pc <- nd_get(nodes, ni, NF.L1n)
        s1 <- nd_get(nodes, ni, NF.L1s)
        s2 <- nd_get(nodes, ni, NF.L2s)
        r_tok <- nd_get(nodes, ni, NF.R1); re_tok <- nd_get(nodes, ni, NF.R2)
        // M13.4-S3: resolve the return annotation before checking the body so
        // recursive calls see the correct return type. pre_ret is a KIND,
        // not a pool index: pool indices diverge from kinds for kinds >= 12
        // (Option/Result are not primed), and ty_func expects a kind.
        pre_ret <- TY.Unknown; pre_ret_full <- 0 - 1; pre_reg <- 0
        r_tok != -1 ? {
            ra <- resolve_ann(src, toks, tp, tpn, st_names, st_meta, r_tok, re_tok, path, ctx)
            ra != -1 ? {
                rk <- vec_get(tp, ra * 8 + TF.Kind)
                rk != TY.Unknown ? {
                    pre_reg <- 1
                    rk == TY.Struct || rk == TY.Vec ? { pre_ret_full <- ra }                    pre_ret <- rk
                }
            }
        }
        ft <- pre_ret_full != -1 ? pre_ret_full : ty_func(tp, tpn, pre_ret, pc)
        env_define(en, ed, sc, nm, 0, ft, ln)
        // Register function
        vec_push(fn_reg, nm); vec_push(fn_reg, "")
        // Record param types + ref kinds for borrow checking
        pts_base <- vec_len(fpts); rks_base <- vec_len(frks)
        vec_push(fn_data, ni); vec_push(fn_data, pts_base)
        // First pass: resolve param type annotations and ref kinds
        j <- 0
        [j < pc] {
            pt_tok <- vec_get(kids, s2 + j * 3)
            et_tok <- vec_get(kids, s2 + j * 3 + 1)
            ref_k <- vec_get(kids, s2 + j * 3 + 2)
            pt <- ty_get(tp, tpn, TY.Unknown)
            is_cont <- 0
            pt_tok != -1 ? {
                cont <- resolve_cont(src, toks, tp, tpn, st_names, st_meta, pt_tok, et_tok, path, ctx)
                cont != -1 ? {
                    ck <- vec_get(tp, cont * 8 + TF.Kind)
                    ck == TY.Vec || ck == TY.Map || ck == TY.Strbuf ? { is_cont <- 1 }
                    pt <- cont
                }
                cont == -1 ? {
                    ann <- resolve_type(src, toks, tp, tpn, pt_tok)
                    ann == -1 ? {
                        nm2 <- tk_lex(src, toks, pt_tok)
                        si2 <- struct_lookup(st_names, nm2)
                        si2 != -1 ? { ann <- vec_get(st_meta, si2) }                    }
                    ann != -1 ? { pt <- ann }                    ann == -1 ? {
                        msg <- str_cat(str_cat("unknown type '", tk_lex(src, toks, pt_tok)), "'")
                        s_diag(ctx, path, tk_line(toks, pt_tok), 9, msg)
                    }
                }
            }
            ref_k != 0 ? {
                is_cont == 1 ? { s_diag(ctx, path, tk_line(toks, pt_tok), 23, "container parameters are reference-semantics handles; '&' is not allowed") }
                is_cont == 0 ? { pt <- ty_ref(tp, tpn, pt, ref_k == 2 ? 1 : 0) }            }
            vec_push(fpts, pt); vec_push(frks, ref_k)
            j <- j + 1
        }
        // Redefine params properly - the L1 list stores just name token indices
        env_push_scope(sc, en)
        j <- 0
        [j < pc] {
            pn_tok <- vec_get(kids, s1 + j)
            pn <- tk_lex(src, toks, pn_tok)
            pt <- vec_get(fpts, pts_base + j)
            env_define(en, ed, sc, pn, 0, pt, ln)
            j <- j + 1
        }
        // Check body
        // M15: set IsStd when the function name matches a gated builtin
        // (std/ wrappers share the builtin name; user code does not).
        old_std <- vec_get(ctx, CX.IsStd)
        is_gated_name(nm) ? { vec_set(ctx, CX.IsStd, 1) }
        bi <- nd_get(nodes, ni, NF.A)
        check_node(src, path, toks, nodes, kids, types, en, ed, sc, st_reg, st_data, st_names, st_meta, en_reg, en_data, fn_reg, fn_data, fpts, frks, tp, tpn, ctx, bi)
        vec_set(ctx, CX.IsStd, old_std)
        // Update param types from env (may have been refined)
        j <- 0
        [j < pc] {
            pn_tok <- vec_get(kids, s1 + j)
            pn <- tk_lex(src, toks, pn_tok)
            psi <- env_lookup(en, ed, pn)
            psi != -1 ? { vec_set(fpts, pts_base + j, vec_get(ed, psi * 4 + 2)) }
            j <- j + 1
        }
        env_pop_scope(sc, en, ed)
        // Determine return type
        ret_kind <- TY.Unknown
        bi != -1 ? { bt <- vec_get(types, bi); bt != -1 ? { ret_kind <- vec_get(tp, bt * 8 + TF.Kind) }}
        // Check return type annotation (M12.4 / M13.1-P8)
        ret_type <- 0 - 1
        r_tok != -1 ? {
            r_ann <- resolve_ann(src, toks, tp, tpn, st_names, st_meta, r_tok, re_tok, path, ctx)
            r_ann != -1 ? {
                u <- unify(ctx, path, ln, tp, tpn, r_ann, ty_get(tp, tpn, ret_kind), "return type mismatch")
                u != -1 ? { ret_kind <- vec_get(tp, u * 8 + TF.Kind) }                rk <- vec_get(tp, r_ann * 8 + TF.Kind)
                rk == TY.Struct ? { ret_type <- r_ann }                rk == TY.Vec ? {
                    ret_type <- r_ann
                    vec_get(tp, r_ann * 8 + TF.Elem) != -1 && bi != -1 ? {
                        bt <- vec_get(types, bi)
                        bt != -1 && vec_get(tp, bt * 8 + TF.Kind) == TY.Vec && vec_get(tp, bt * 8 + TF.Elem) != -1 && vec_elem_same(tp, vec_get(tp, r_ann * 8 + TF.Elem), vec_get(tp, bt * 8 + TF.Elem)) == 0 ? {
                            msg <- str_cat(str_cat("return type mismatch: expected ", disp(tp, tpn, r_ann)), str_cat(", found ", disp(tp, tpn, bt)))
                            s_diag(ctx, path, ln, 9, msg)
                        }
                    }
                }
            }
            r_ann == -1 ? {
                msg <- str_cat(str_cat("unknown return type '", tk_lex(src, toks, r_tok)), "'")
                s_diag(ctx, path, tk_line(toks, r_tok), 9, msg)
            }
        }
        // Update the function's env entry with the resolved return type
        fsi <- env_lookup(en, ed, nm)
        fsi != -1 ? {
            pre_reg == 1 ? {
                // Container returns (vec/struct) keep the full type; primitive
                // returns use a function type. Don't overwrite ret_type.
                ret_type != -1 ? { vec_set(ed, fsi * 4 + 2, ret_type) }
                ret_type == -1 ? { vec_set(ed, fsi * 4 + 2, ty_func(tp, tpn, pre_ret, pc)) }
            }
            pre_reg == 0 ? {
                cur <- vec_get(ed, fsi * 4 + 2)
                su <- unify(ctx, path, ln, tp, tpn, cur != -1 ? ty_get(tp, tpn, vec_get(tp, cur * 8 + TF.Kind)) : ty_get(tp, tpn, TY.Unknown), ty_get(tp, tpn, ret_kind), "type mismatch")
                su != -1 && vec_get(tp, su * 8 + TF.Kind) != TY.Unknown ? {
                    ret_type != -1 && (vec_get(tp, ret_type * 8 + TF.Kind) == TY.Struct || vec_get(tp, ret_type * 8 + TF.Kind) == TY.Vec) ? { vec_set(ed, fsi * 4 + 2, ret_type) }
                    ret_type == -1 || (vec_get(tp, ret_type * 8 + TF.Kind) != TY.Struct && vec_get(tp, ret_type * 8 + TF.Kind) != TY.Vec) ? { vec_set(ed, fsi * 4 + 2, ty_func(tp, tpn, vec_get(tp, su * 8 + TF.Kind), pc)) }
                }
            }
        }
        vec_set(types, ni, ret_type != -1 ? ret_type : ty_get(tp, tpn, ret_kind)); done <- 1
    }
    // --- EXTERN --- (M16.1/M16.2: mirrors C's AST_EXTERN case,
    // LANGUAGE_SPEC §7.1. The ABI operand must be exactly "C"; every
    // parameter needs an FFI-safe annotation; the name must not collide
    // with an existing declaration. Registration mirrors a user function
    // with no body, so calls see the declared signature.)
    done == 0 && k == AstKind.Extern ? {
        nm <- tk_lex(src, toks, nd_get(nodes, ni, NF.Name))
        abi_tok <- nd_get(nodes, ni, NF.Tok)
        is_c <- 0
        abi_tok != -1 && tk_kind(toks, abi_tok) == TokenKind.String ? { str_eq(tk_lex(src, toks, abi_tok), "\"C\"") ? { is_c <- 1 }}
        is_c == 0 ? { s_diag(ctx, path, ln, 29, "extern ABI must be \"C\"") }
        // Duplicate / collision checks against the registries.
        fi <- vec_len(fn_reg) / 2 - 1; prev <- 0 - 1
        [fi >= 0 && prev == 0 - 1] { str_eq(vec_get(fn_reg, fi * 2), nm) ? { prev <- vec_get(fn_data, fi * 2) }; fi <- fi - 1 }
        dup <- 0
        prev != 0 - 1 && nd_get(nodes, prev, NF.Kind) == AstKind.Extern ? { dup <- 1 }        dup == 1 ? { s_diag(ctx, path, ln, 29, str_cat(str_cat("duplicate extern declaration '", nm), "'")) }
        dup == 0 && (prev != 0 - 1 || struct_lookup(st_names, nm) != 0 - 1 || enum_lookup(en_reg, en_data, nm) != 0 - 1) ? {
            s_diag(ctx, path, ln, 29, str_cat(str_cat("extern declaration '", nm), "' collides with an existing declaration"))
        }
        pc <- nd_get(nodes, ni, NF.L1n)
        s2 <- nd_get(nodes, ni, NF.L2s)
        pts_base <- vec_len(fpts)
        j <- 0
        [j < pc] {
            pt_tok <- vec_get(kids, s2 + j * 3)
            et_tok <- vec_get(kids, s2 + j * 3 + 1)
            ref_k <- vec_get(kids, s2 + j * 3 + 2)
            kept <- 0 - 1
            ref_k != 0 ? { s_diag(ctx, path, ln, 23, "extern parameters cannot use borrow annotations") }
            pt_tok == 0 - 1 ? { s_diag(ctx, path, ln, 29, "extern parameters require type annotations") }
            pt_tok != 0 - 1 && tk_kind(toks, pt_tok) != TokenKind.Ident ? {
                // Compound annotations ([T; N] forms) are not FFI-safe.
                s_diag(ctx, path, ln, 29, "extern parameter type is not FFI-safe")
            }
            took <- 0
            pt_tok != 0 - 1 && tk_kind(toks, pt_tok) == TokenKind.Ident ? {
                cont <- resolve_cont(src, toks, tp, tpn, st_names, st_meta, pt_tok, et_tok, path, ctx)
                cont != 0 - 1 ? {
                    vec_get(tp, cont * 8 + TF.Kind) != TY.Unknown ? { s_diag(ctx, path, ln, 29, "extern parameter type is not FFI-safe") }
                    took <- 1
                }
                cont == 0 - 1 ? {
                    ann <- resolve_type(src, toks, tp, tpn, pt_tok)
                    ann == 0 - 1 ? { nm2 <- tk_lex(src, toks, pt_tok); si2 <- struct_lookup(st_names, nm2); si2 != 0 - 1 ? { ann <- vec_get(st_meta, si2) }}
                    ann == 0 - 1 ? { s_diag(ctx, path, tk_line(toks, pt_tok), 9, str_cat(str_cat("unknown type '", tk_lex(src, toks, pt_tok)), "'")); took <- 1 }
                    ann != 0 - 1 ? {
                        ak <- vec_get(tp, ann * 8 + TF.Kind)
                        ffs <- ak == TY.I8 || ak == TY.I16 || ak == TY.I32 || ak == TY.Int || ak == TY.U8 || ak == TY.U16 || ak == TY.U32 || ak == TY.U64 || ak == TY.F32 || ak == TY.Float || ak == TY.Bool || ak == TY.Str || ak == TY.Struct ? 1 : 0
                        ffs == 0 ? { s_diag(ctx, path, ln, 29, "extern parameter type is not FFI-safe"); took <- 1 }
                        ffs == 1 ? { kept <- ann }
                    }
                }
            }
            vec_push(fpts, kept); vec_push(frks, ref_k)
            j <- j + 1
        }
        // The return type is mandatory, resolved, and FFI-safe.
        ret <- 0 - 1
        r_tok <- nd_get(nodes, ni, NF.R1); re_tok <- nd_get(nodes, ni, NF.R2)
        r_tok != 0 - 1 && tk_kind(toks, r_tok) == TokenKind.Ident ? {
            rcont <- resolve_cont(src, toks, tp, tpn, st_names, st_meta, r_tok, re_tok, path, ctx)
            rcont != 0 - 1 ? {
                vec_get(tp, rcont * 8 + TF.Kind) != TY.Unknown ? { s_diag(ctx, path, ln, 29, "extern return type is not FFI-safe") }
            }
            rcont == 0 - 1 ? {
                rann <- resolve_type(src, toks, tp, tpn, r_tok)
                rann == 0 - 1 ? { rnm <- tk_lex(src, toks, r_tok); rsi <- struct_lookup(st_names, rnm); rsi != 0 - 1 ? { rann <- vec_get(st_meta, rsi) }}
                rann == 0 - 1 ? { s_diag(ctx, path, tk_line(toks, r_tok), 9, str_cat(str_cat("unknown type '", tk_lex(src, toks, r_tok)), "'")) }
                rann != 0 - 1 ? {
                    rk2 <- vec_get(tp, rann * 8 + TF.Kind)
                    ffs2 <- rk2 == TY.I8 || rk2 == TY.I16 || rk2 == TY.I32 || rk2 == TY.Int || rk2 == TY.U8 || rk2 == TY.U16 || rk2 == TY.U32 || rk2 == TY.U64 || rk2 == TY.F32 || rk2 == TY.Float || rk2 == TY.Bool || rk2 == TY.Str || rk2 == TY.Struct ? 1 : 0
                    ffs2 == 0 ? { s_diag(ctx, path, ln, 29, "extern return type is not FFI-safe") }
                    ffs2 == 1 ? { ret <- rann }
                }
            }
        }
        // Register like a user function (body == NULL): calls see the
        // declared signature through the symbol and the func registry.
        ft <- ret != 0 - 1 && vec_get(tp, ret * 8 + TF.Kind) == TY.Struct ? ret : ty_func(tp, tpn, ret != 0 - 1 ? vec_get(tp, ret * 8 + TF.Kind) : TY.Unknown, pc)
        env_define(en, ed, sc, nm, 0, ft, ln)
        vec_push(fn_reg, nm); vec_push(fn_reg, "")
        vec_push(fn_data, ni); vec_push(fn_data, pts_base)
        vec_set(types, ni, ret != 0 - 1 ? ret : ty_get(tp, tpn, TY.Unknown)); done <- 1
    }
    // --- BRACKET_LOOP ---
    done == 0 && k == AstKind.BracketLoop ? {
        old_depth <- vec_get(ctx, CX.LoopDepth); vec_set(ctx, CX.LoopDepth, old_depth + 1)
        old_range <- vec_get(ctx, CX.InRange); vec_set(ctx, CX.InRange, 1)
        di <- nd_get(nodes, ni, NF.A)
        check_node(src, path, toks, nodes, kids, types, en, ed, sc, st_reg, st_data, st_names, st_meta, en_reg, en_data, fn_reg, fn_data, fpts, frks, tp, tpn, ctx, di)
        vec_set(ctx, CX.InRange, old_range)
        is_range <- di != -1 && nd_get(nodes, di, NF.Kind) == AstKind.Binary && nd_get(nodes, di, NF.Op) == TokenKind.DotDot ? 1 : 0
        is_range == 1 ? {
            li <- nd_get(nodes, di, NF.A); ri <- nd_get(nodes, di, NF.B)
            lt <- li != -1 ? vec_get(types, li) : -1; rt <- ri != -1 ? vec_get(types, ri) : -1
            lt != -1 && vec_get(tp, lt * 8 + TF.Kind) != TY.Int ? { s_diag(ctx, path, ln, 9, "range bounds must be int") }
            rt != -1 && vec_get(tp, rt * 8 + TF.Kind) != TY.Int ? { s_diag(ctx, path, ln, 9, "range bounds must be int") }
        }
        is_range == 0 && di != -1 ? {
            dt <- vec_get(types, di)
            dt != -1 && vec_get(tp, dt * 8 + TF.Kind) != TY.Bool ? { s_diag(ctx, path, ln, 14, "loop condition must be bool") }
        }
        has_binder <- nd_get(nodes, ni, NF.F1)
        has_binder == 1 && is_range == 0 ? { s_diag(ctx, path, ln, 15, "loop binder requires a range domain") }
        env_push_scope(sc, en)
        has_binder == 1 ? {
            bn <- tk_lex(src, toks, nd_get(nodes, ni, NF.Name))
            env_define(en, ed, sc, bn, 0, ty_get(tp, tpn, TY.Int), ln)
        }
        has_binder == 0 && is_range == 1 ? { env_define(en, ed, sc, "_tiq_i", 0, ty_get(tp, tpn, TY.Int), ln) }
        s1 <- nd_get(nodes, ni, NF.L1s); c1 <- nd_get(nodes, ni, NF.L1n)
        j <- 0; [j < c1] { si <- vec_get(kids, s1 + j); check_node(src, path, toks, nodes, kids, types, en, ed, sc, st_reg, st_data, st_names, st_meta, en_reg, en_data, fn_reg, fn_data, fpts, frks, tp, tpn, ctx, si); j <- j + 1 }
        bf <- nd_get(nodes, ni, NF.B)
        bf != -1 ? { check_node(src, path, toks, nodes, kids, types, en, ed, sc, st_reg, st_data, st_names, st_meta, en_reg, en_data, fn_reg, fn_data, fpts, frks, tp, tpn, ctx, bf) }
        env_pop_scope(sc, en, ed)
        vec_set(ctx, CX.LoopDepth, old_depth)
        vec_set(types, ni, ty_get(tp, tpn, TY.Unknown)); done <- 1
    }
    // --- BREAK ---
    done == 0 && k == AstKind.Break ? {
        vec_get(ctx, CX.LoopDepth) == 0 ? { s_diag(ctx, path, ln, 16, "break outside loop") }
        vec_set(types, ni, ty_get(tp, tpn, TY.Unknown)); done <- 1
    }
    // --- SKIP ---
    done == 0 && k == AstKind.Skip ? {
        vec_get(ctx, CX.LoopDepth) == 0 ? { s_diag(ctx, path, ln, 16, "skip outside loop") }
        vec_set(types, ni, ty_get(tp, tpn, TY.Unknown)); done <- 1
    }
    // --- DEFER ---
    done == 0 && k == AstKind.Defer ? {
        ei <- nd_get(nodes, ni, NF.A)
        check_node(src, path, toks, nodes, kids, types, en, ed, sc, st_reg, st_data, st_names, st_meta, en_reg, en_data, fn_reg, fn_data, fpts, frks, tp, tpn, ctx, ei)
        vec_set(types, ni, ty_get(tp, tpn, TY.Unknown)); done <- 1
    }
    // --- STREAM_GEN ---
    done == 0 && k == AstKind.StreamGen ? {
        s1 <- nd_get(nodes, ni, NF.L1s); c1 <- nd_get(nodes, ni, NF.L1n)
        c1 > 2 ? { s_diag(ctx, path, ln, 7, "stream generators support at most 2 seeds"); vec_set(types, ni, ty_get(tp, tpn, TY.Unknown)); done <- 1 }
        done == 0 ? {
            j <- 0; [j < c1] { si <- vec_get(kids, s1 + j); check_node(src, path, toks, nodes, kids, types, en, ed, sc, st_reg, st_data, st_names, st_meta, en_reg, en_data, fn_reg, fn_data, fpts, frks, tp, tpn, ctx, si); j <- j + 1 }
            gi <- nd_get(nodes, ni, NF.A)
            gi != -1 ? {
                bc = nd_get(nodes, ni, NF.F1)
                bc == 0 ? {
                    s_diag(ctx, path, ln, 7, "stream generators require explicit binders: use (name) -> expr")
                    vec_set(types, ni, ty_get(tp, tpn, TY.Unknown))
                    done <- 1
                }
                done == 0 ? {
                    env_push_scope(sc, en)
                    r1 = nd_get(nodes, ni, NF.R1)
                    r2 = nd_get(nodes, ni, NF.R2)
                    ci2 = nd_get(nodes, ni, NF.C)
                    hi = nd_get(nodes, ni, NF.F2)
                    bc == 1 ? { env_define(en, ed, sc, tk_lex(src, toks, r1), 0, ty_get(tp, tpn, TY.Int), ln) }
                    bc == 2 ? { env_define(en, ed, sc, tk_lex(src, toks, r1), 0, ty_get(tp, tpn, TY.Int), ln); env_define(en, ed, sc, tk_lex(src, toks, r2), 0, ty_get(tp, tpn, TY.Int), ln) }
                    hi == 1 ? { env_define(en, ed, sc, tk_lex(src, toks, ci2), 0, ty_get(tp, tpn, TY.Int), ln) }
                    check_node(src, path, toks, nodes, kids, types, en, ed, sc, st_reg, st_data, st_names, st_meta, en_reg, en_data, fn_reg, fn_data, fpts, frks, tp, tpn, ctx, gi)
                    env_pop_scope(sc, en, ed)
                    vec_set(types, ni, ty_get(tp, tpn, TY.Stream))
                }
            }
            gi == -1 ? { vec_set(types, ni, ty_get(tp, tpn, TY.Unknown)) }
            bi2 <- nd_get(nodes, ni, NF.B)
            bi2 != -1 ? { s_diag(ctx, path, ln, 7, "bounded stream generators are not yet supported") }
            done <- 1
        }
    }
    // --- ARRAY ---
    done == 0 && k == AstKind.Array ? {
        s1 <- nd_get(nodes, ni, NF.L1s); c1 <- nd_get(nodes, ni, NF.L1n)
        c1 == 0 ? { s_diag(ctx, path, ln, 21, "cannot infer element type for empty array"); vec_set(types, ni, ty_get(tp, tpn, TY.Unknown)); done <- 1 }
        elem <- 0 - 1
        j <- 0
        [done == 0 && j < c1] {
            ai <- vec_get(kids, s1 + j)
            check_node(src, path, toks, nodes, kids, types, en, ed, sc, st_reg, st_data, st_names, st_meta, en_reg, en_data, fn_reg, fn_data, fpts, frks, tp, tpn, ctx, ai)
            et <- ai != -1 ? vec_get(types, ai) : -1
            u <- unify(ctx, path, ln, tp, tpn, elem, et, "array elements must have the same type")
            u != -1 ? { elem <- u }            j <- j + 1
        }
        done == 0 ? { ek <- elem != -1 ? vec_get(tp, elem * 8 + TF.Kind) : TY.Unknown; vec_set(types, ni, ty_array(tp, tpn, ty_get(tp, tpn, ek), c1)); done <- 1 }
    }
    // --- ARRAY_FILL ---
    done == 0 && k == AstKind.ArrayFill ? {
        vi <- nd_get(nodes, ni, NF.A); li <- nd_get(nodes, ni, NF.B)
        check_node(src, path, toks, nodes, kids, types, en, ed, sc, st_reg, st_data, st_names, st_meta, en_reg, en_data, fn_reg, fn_data, fpts, frks, tp, tpn, ctx, vi)
        check_node(src, path, toks, nodes, kids, types, en, ed, sc, st_reg, st_data, st_names, st_meta, en_reg, en_data, fn_reg, fn_data, fpts, frks, tp, tpn, ctx, li)
        vt <- vi != -1 ? vec_get(types, vi) : -1
        lt <- li != -1 ? vec_get(types, li) : -1
        lt != -1 && vec_get(tp, lt * 8 + TF.Kind) != TY.Int ? { s_diag(ctx, path, ln, 9, "array fill length must be int") }
        fill_len <- 0
        li != -1 && nd_get(nodes, li, NF.Kind) == AstKind.Literal && nd_get(nodes, li, NF.Op) == TokenKind.Int ? {
            lx <- tk_lex(src, toks, nd_get(nodes, li, NF.Tok))
            // Simple atoi for the fill length
            fill_len <- 0; fi2 <- 0
            [fi2 < len(lx)] { fill_len <- fill_len * 10 + str_sub_code(lx, fi2) - 48; fi2 <- fi2 + 1 }
        }
        vk <- vt != -1 ? vec_get(tp, vt * 8 + TF.Kind) : TY.Unknown
        vec_set(types, ni, ty_array(tp, tpn, ty_get(tp, tpn, vk), fill_len)); done <- 1
    }
    // --- FIELD_ACCESS ---
    done == 0 && k == AstKind.FieldAccess ? {
        ti <- nd_get(nodes, ni, NF.A)
        fld <- tk_lex(src, toks, nd_get(nodes, ni, NF.Name))
        // Enum variant check (M13.1-P2): an identifier target naming a
        // declared enum wins over any same-named value binding.
        ti != -1 && nd_get(nodes, ti, NF.Kind) == AstKind.Identifier ? {
            tnm <- tk_lex(src, toks, nd_get(nodes, ti, NF.Name))
            ei <- enum_lookup(en_reg, en_data, tnm)
            ei != -1 ? {
                // Check variant exists
                vs <- vec_get(en_data, ei * 3 + 1); vn <- vec_get(en_data, ei * 3 + 2)
                found_v <- 0; vj <- 0
                [vj < vn && found_v == 0] { str_eq(vec_get(en_reg, vs + vj * 2), fld) ? { found_v <- 1; break }; vj <- vj + 1 }
                found_v == 0 ? { s_diag(ctx, path, ln, 26, str_cat(str_cat(str_cat(str_cat("unknown variant '", fld), "' in enum '"), tnm), "'")) }
                vec_set(types, ti, ty_get(tp, tpn, TY.Int))
                vec_set(types, ni, ty_get(tp, tpn, TY.Int)); done <- 1
            }
        }
        done == 0 ? {
            check_node(src, path, toks, nodes, kids, types, en, ed, sc, st_reg, st_data, st_names, st_meta, en_reg, en_data, fn_reg, fn_data, fpts, frks, tp, tpn, ctx, ti)
            tt <- ti != -1 ? vec_get(types, ti) : -1
            ft2 <- ty_get(tp, tpn, TY.Unknown)
            tt != -1 && vec_get(tp, tt * 8 + TF.Kind) == TY.Struct ? {
                fs <- vec_get(tp, tt * 8 + TF.Fs); fn2 <- vec_get(tp, tt * 8 + TF.Fn)
                found_f <- 0; fj <- 0
                [fj < fn2 / 2 && found_f == 0] {
                    str_eq(vec_get(st_reg, fs + fj * 2), fld) ? { ft2 <- vec_get(st_data, fs + fj * 2); found_f <- 1 }
                    fj <- fj + 1
                }
                found_f == 0 ? { s_diag(ctx, path, ln, 9, str_cat(str_cat("unknown field '", fld), "'")) }
            }
            tt != -1 && vec_get(tp, tt * 8 + TF.Kind) != TY.Struct && vec_get(tp, tt * 8 + TF.Kind) != TY.Unknown ? { s_diag(ctx, path, ln, 9, "field access on non-struct type") }
            vec_set(types, ni, ft2); done <- 1
        }
    }
    // --- STRUCT_DEF ---
    done == 0 && k == AstKind.StructDef ? {
        nm <- tk_lex(src, toks, nd_get(nodes, ni, NF.Name))
        // Check duplicate
        struct_lookup(st_names, nm) != -1 ? { s_diag(ctx, path, ln, 9, str_cat(str_cat("duplicate struct definition '", nm), "'")) }
        // Check enum conflict (M13.1-P2: struct and enum share a namespace)
        enum_lookup(en_reg, en_data, nm) != -1 ? { s_diag(ctx, path, ln, 24, str_cat(str_cat(str_cat(str_cat("struct '", nm), "' conflicts with enum '"), nm), "'")) }
        // Resolve field types (L1 = field names, L2 = field type tokens)
        s1 <- nd_get(nodes, ni, NF.L1s); c1 <- nd_get(nodes, ni, NF.L1n)
        s2 <- nd_get(nodes, ni, NF.L2s)
        fs_base <- vec_len(st_reg)
        j <- 0
        [j < c1] {
            fn_tok <- vec_get(kids, s1 + j)
            ft_tok <- vec_get(kids, s2 + j)
            fnm <- tk_lex(src, toks, fn_tok)
            ft2 <- resolve_ann(src, toks, tp, tpn, st_names, st_meta, ft_tok, -1, path, ctx)
            ft2 == -1 ? { msg <- str_cat(str_cat("unknown field type '", tk_lex(src, toks, ft_tok)), "'"); s_diag(ctx, path, ln, 9, msg); ft2 <- ty_get(tp, tpn, TY.Unknown) }
            vec_push(st_reg, fnm); vec_push(st_reg, "")
            vec_push(st_data, ft2); vec_push(st_data, 0)
            j <- j + 1
        }
        st2 <- ty_struct(tp, tpn, nm, fs_base, c1 * 2)
        // Register the struct in the struct registry (st_names/st_meta)
        vec_push(st_names, nm); vec_push(st_meta, st2)
        vec_set(types, ni, st2); done <- 1
    }
    // --- ENUM_DEF ---
    done == 0 && k == AstKind.EnumDef ? {
        nm <- tk_lex(src, toks, nd_get(nodes, ni, NF.Name))
        // Check duplicate enum
        enum_lookup(en_reg, en_data, nm) != -1 ? { s_diag(ctx, path, ln, 24, str_cat(str_cat("duplicate enum definition '", nm), "'")) }
        // Check struct conflict (M13.1-P2)
        struct_lookup(st_names, nm) != -1 ? { s_diag(ctx, path, ln, 24, str_cat(str_cat(str_cat(str_cat("enum '", nm), "' conflicts with struct '"), nm), "'")) }
        // Register enum: en_data holds [name_pos, var_base, var_count] per
        // enum; names (enum + variants) live in en_reg as pairs.
        s1 <- nd_get(nodes, ni, NF.L1s); c1 <- nd_get(nodes, ni, NF.L1n)
        vs_base <- vec_len(en_reg)
        j <- 0
        [j < c1] {
            vn_tok <- vec_get(kids, s1 + j)
            vnm <- tk_lex(src, toks, vn_tok)
            // Check duplicate variant
            dk <- 0; dv <- 0
            [dv < j && dk == 0] {
                dv_tok <- vec_get(kids, s1 + dv)
                dv_nm <- tk_lex(src, toks, dv_tok)
                str_eq(vnm, dv_nm) ? { dk <- 1 }                dv <- dv + 1
            }
            dk == 1 ? { s_diag(ctx, path, ln, 25, str_cat(str_cat(str_cat(str_cat("duplicate variant '", vnm), "' in enum '"), nm), "'")) }
            vec_push(en_reg, vnm); vec_push(en_reg, "")
            j <- j + 1
        }
        name_pos <- vec_len(en_reg)
        vec_push(en_reg, nm); vec_push(en_reg, "")
        vec_push(en_data, name_pos); vec_push(en_data, vs_base); vec_push(en_data, c1)
        done <- 1
    }
    // --- RECORD_LIT ---
    done == 0 && k == AstKind.RecordLit ? {
        nm <- tk_lex(src, toks, nd_get(nodes, ni, NF.Name))
        // Lookup struct in the struct registry (L1 = values, L2 = names)
        si2 <- struct_lookup(st_names, nm)
        st2 <- 0 - 1
        si2 != -1 ? { st2 <- vec_get(st_meta, si2) }        st2 == -1 ? { s_diag(ctx, path, ln, 9, str_cat(str_cat("unknown struct '", nm), "'")); vec_set(types, ni, ty_get(tp, tpn, TY.Unknown)); done <- 1 }
        st2 != -1 ? {
            // Check field count
            s1 <- nd_get(nodes, ni, NF.L1s); c1 <- nd_get(nodes, ni, NF.L1n)
            s2 <- nd_get(nodes, ni, NF.L2s)
            fc <- vec_get(tp, st2 * 8 + TF.Fn) / 2
            c1 != fc ? { s_diag(ctx, path, ln, 9, str_cat(str_cat("record literal has ", int_str(c1)), str_cat(" fields, struct has ", int_str(fc)))); vec_set(types, ni, st2); done <- 1 }
            // Check each field
            fs <- vec_get(tp, st2 * 8 + TF.Fs)
            j <- 0
            [j < c1] {
                fn_tok <- vec_get(kids, s2 + j)
                fv_node <- vec_get(kids, s1 + j)
                fnm <- tk_lex(src, toks, fn_tok)
                // Find field in struct
                found_f <- 0; fj <- 0; fidx <- 0 - 1
                [fj < fc && found_f == 0] {
                    str_eq(vec_get(st_reg, fs + fj * 2), fnm) ? { found_f <- 1; fidx <- fj }
                    fj <- fj + 1
                }
                found_f == 0 ? { s_diag(ctx, path, ln, 9, str_cat(str_cat("unknown field '", fnm), "'")); j <- j + 1 }
                check_node(src, path, toks, nodes, kids, types, en, ed, sc, st_reg, st_data, st_names, st_meta, en_reg, en_data, fn_reg, fn_data, fpts, frks, tp, tpn, ctx, fv_node)
                fidx != -1 ? {
                    vt <- fv_node != -1 ? vec_get(types, fv_node) : -1
                    exp <- vec_get(st_data, fs + fidx * 2)
                    vt != -1 && exp != -1 && vec_get(tp, vt * 8 + TF.Kind) != TY.Unknown && vec_get(tp, exp * 8 + TF.Kind) != TY.Unknown ? {
                        unify(ctx, path, ln, tp, tpn, exp, vt, "field type mismatch")
                    }
                }
                j <- j + 1
            }
            vec_set(types, ni, st2); done <- 1
        }
    }
    // --- MATCH ---
    done == 0 && k == AstKind.Match ? {
        s1 <- nd_get(nodes, ni, NF.L1s); c1 <- nd_get(nodes, ni, NF.L1n)
        // Check for wildcard
        has_wc <- 0; j <- 0
        [j < c1 && has_wc == 0] { ai <- vec_get(kids, s1 + j); ai != -1 && nd_get(nodes, ai, NF.F1) == 1 ? { has_wc <- 1; break }; j <- j + 1 }
        has_wc == 0 ? { s_diag(ctx, path, ln, 7, "match must have a wildcard arm ('_ => ...')") }
        // Check expr
        mi <- nd_get(nodes, ni, NF.A)
        check_node(src, path, toks, nodes, kids, types, en, ed, sc, st_reg, st_data, st_names, st_meta, en_reg, en_data, fn_reg, fn_data, fpts, frks, tp, tpn, ctx, mi)
        result <- 0 - 1
        j <- 0
        [j < c1] {
            arm <- vec_get(kids, s1 + j)
            arm != -1 ? {
                is_wc <- nd_get(nodes, arm, NF.F1)
                is_wc == 0 ? { pi <- nd_get(nodes, arm, NF.A); check_node(src, path, toks, nodes, kids, types, en, ed, sc, st_reg, st_data, st_names, st_meta, en_reg, en_data, fn_reg, fn_data, fpts, frks, tp, tpn, ctx, pi) }
                bi2 <- nd_get(nodes, arm, NF.B)
                check_node(src, path, toks, nodes, kids, types, en, ed, sc, st_reg, st_data, st_names, st_meta, en_reg, en_data, fn_reg, fn_data, fpts, frks, tp, tpn, ctx, bi2)
                bi2 != -1 ? {
                    bt <- vec_get(types, bi2)
                    u <- unify(ctx, path, bi2 != -1 ? tk_line(toks, nd_get(nodes, bi2, NF.Tok)) : ln, tp, tpn, result, bt, "match arms must have the same type")
                    u != -1 ? { result <- u }                }
            }
            j <- j + 1
        }
        vec_set(types, ni, ty_get(tp, tpn, result != -1 ? vec_get(tp, result * 8 + TF.Kind) : TY.Unknown)); done <- 1
    }
    // --- SPAWN ---
    done == 0 && k == AstKind.Spawn ? {
        s_diag(ctx, path, ln, 7, "spawn is not supported yet")
        vec_set(types, ni, ty_get(tp, tpn, TY.Unknown)); done <- 1
    }
    // --- CHAN ---
    done == 0 && k == AstKind.Chan ? {
        s_diag(ctx, path, ln, 7, "chan is not supported yet")
        vec_set(types, ni, ty_get(tp, tpn, TY.Unknown)); done <- 1
    }
    // --- IMPORT ---
    done == 0 && k == AstKind.Import ? {
        // Inert at single-file level
        done <- 1
    }
    0
}


// --- typed_ast_show: mirrors C ast_print with type suffixes ---
// indent_print: print `n` two-space indents
indent_print n:i64 : i64 -> { j <- 0; [j < n] { print("  "); j <- j + 1 }; 0 }

typed_ast_show src:str toks:vec[Token] nodes:vec[int] kids:vec[int] types:vec[int] tp:vec[int] tpn:vec[str] ni:i64 indent:i64 : i64 -> {
    ni != -1 ? {
        k <- nd_get(nodes, ni, NF.Kind)
        ts <- fmt_type(tp, tpn, vec_get(types, ni))
        pd <- pad(indent)
        d2 <- 0

        // --- LITERAL ---
        d2 == 0 && k == AstKind.Literal ? {
            op <- nd_get(nodes, ni, NF.Op)
            op == TokenKind.String ? { lx <- tk_lex(src, toks, nd_get(nodes, ni, NF.Tok)); print(str_cat(str_cat(pd, "STRING "), str_cat(lx, ts))); d2 <- 1 }
            op == TokenKind.Int ? { lx <- tk_lex(src, toks, nd_get(nodes, ni, NF.Tok)); print(str_cat(str_cat(pd, "INT "), str_cat(lx, ts))); d2 <- 1 }
            op == TokenKind.None ? { print(str_cat(pd, str_cat("LITERAL none", ts))); d2 <- 1 }
            d2 == 0 ? { print(str_cat(pd, str_cat("LITERAL", ts))); d2 <- 1 }
        }
        // --- IDENTIFIER ---
        d2 == 0 && k == AstKind.Identifier ? {
            nm <- tk_lex(src, toks, nd_get(nodes, ni, NF.Name))
            print(str_cat(str_cat(str_cat(pd, "IDENT "), nm), ts))
            d2 <- 1
        }
        // --- BINARY ---
        d2 == 0 && k == AstKind.Binary ? {
            op <- nd_get(nodes, ni, NF.Op)
            print(str_cat(str_cat(str_cat(pd, "BINARY "), token_kind_name(op)), ts))
            typed_ast_show(src, toks, nodes, kids, types, tp, tpn, nd_get(nodes, ni, NF.A), indent + 1)
            typed_ast_show(src, toks, nodes, kids, types, tp, tpn, nd_get(nodes, ni, NF.B), indent + 1)
            d2 <- 1
        }
        // --- UNARY ---
        d2 == 0 && k == AstKind.Unary ? {
            op <- nd_get(nodes, ni, NF.Op)
            print(str_cat(str_cat(str_cat(pd, "UNARY "), token_kind_name(op)), ts))
            typed_ast_show(src, toks, nodes, kids, types, tp, tpn, nd_get(nodes, ni, NF.A), indent + 1)
            d2 <- 1
        }
        // --- CONDITIONAL ---
        d2 == 0 && k == AstKind.Conditional ? {
            print(str_cat(pd, str_cat("CONDITIONAL", ts)))
            typed_ast_show(src, toks, nodes, kids, types, tp, tpn, nd_get(nodes, ni, NF.A), indent + 1)
            typed_ast_show(src, toks, nodes, kids, types, tp, tpn, nd_get(nodes, ni, NF.B), indent + 1)
            typed_ast_show(src, toks, nodes, kids, types, tp, tpn, nd_get(nodes, ni, NF.C), indent + 1)
            d2 <- 1
        }
        // --- CALL ---
        d2 == 0 && k == AstKind.Call ? {
            is_slice <- nd_get(nodes, ni, NF.F2)
            is_slice == 1 ? { print(str_cat(pd, str_cat("SLICE", ts))); d2 <- 1 }
            d2 == 0 ? { print(str_cat(pd, str_cat("CALL", ts))) }
            typed_ast_show(src, toks, nodes, kids, types, tp, tpn, nd_get(nodes, ni, NF.A), indent + 1)
            s1 <- nd_get(nodes, ni, NF.L1s); c1 <- nd_get(nodes, ni, NF.L1n)
            j <- 0
            [j < c1] {
                ai <- vec_get(kids, s1 + j)
                ai != -1 ? { typed_ast_show(src, toks, nodes, kids, types, tp, tpn, ai, indent + 1); j <- j + 1 }
                ai == -1 ? { print(str_cat(pad(indent + 1), "OMITTED")); j <- j + 1 }
            }
            d2 <- 1
        }
        // --- BLOCK ---
        d2 == 0 && k == AstKind.Block ? {
            print(str_cat(pd, str_cat("BLOCK", ts)))
            s1 <- nd_get(nodes, ni, NF.L1s); c1 <- nd_get(nodes, ni, NF.L1n)
            s2 <- nd_get(nodes, ni, NF.L2s); c2 <- nd_get(nodes, ni, NF.L2n)
            j <- 0; [j < c1] { typed_ast_show(src, toks, nodes, kids, types, tp, tpn, vec_get(kids, s1 + j), indent + 1); j <- j + 1 }
            j <- 0; [j < c2] { typed_ast_show(src, toks, nodes, kids, types, tp, tpn, vec_get(kids, s2 + j), indent + 1); j <- j + 1 }
            typed_ast_show(src, toks, nodes, kids, types, tp, tpn, nd_get(nodes, ni, NF.C), indent + 1)
            d2 <- 1
        }
        // --- BINDING ---
        d2 == 0 && k == AstKind.Binding ? {
            is_mut <- nd_get(nodes, ni, NF.F1)
            nm <- tk_lex(src, toks, nd_get(nodes, ni, NF.Name))
            is_mut == 1 ? { print(str_cat(str_cat(str_cat(pd, "MUT_BINDING "), nm), ts)); typed_ast_show(src, toks, nodes, kids, types, tp, tpn, nd_get(nodes, ni, NF.A), indent + 1); d2 <- 1 }
            is_mut == 0 ? { print(str_cat(str_cat(str_cat(pd, "BINDING "), nm), ts)); typed_ast_show(src, toks, nodes, kids, types, tp, tpn, nd_get(nodes, ni, NF.A), indent + 1); d2 <- 1 }
        }
        // --- ASSIGN ---
        d2 == 0 && k == AstKind.Assign ? {
            nm <- tk_lex(src, toks, nd_get(nodes, ni, NF.Name))
            op <- nd_get(nodes, ni, NF.Op)
            print(str_cat(str_cat(str_cat(str_cat(pd, "ASSIGN "), nm), str_cat(" ", token_kind_name(op))), ts))
            typed_ast_show(src, toks, nodes, kids, types, tp, tpn, nd_get(nodes, ni, NF.B), indent + 1)
            typed_ast_show(src, toks, nodes, kids, types, tp, tpn, nd_get(nodes, ni, NF.A), indent + 1)
            d2 <- 1
        }
        // --- FUNCTION ---
        d2 == 0 && k == AstKind.Function ? {
            nm <- tk_lex(src, toks, nd_get(nodes, ni, NF.Name))
            print(str_cat(str_cat(str_cat(pd, "FUNCTION "), nm), ts))
            s1 <- nd_get(nodes, ni, NF.L1s); c1 <- nd_get(nodes, ni, NF.L1n)
            j <- 0
            [j < c1] {
                pn_tok <- vec_get(kids, s1 + j)
                pn <- tk_lex(src, toks, pn_tok)
                print(str_cat(str_cat(pad(indent + 1), "PARAM "), pn))
                j <- j + 1
            }
            typed_ast_show(src, toks, nodes, kids, types, tp, tpn, nd_get(nodes, ni, NF.A), indent + 1)
            d2 <- 1
        }
        // --- EXTERN --- (M16.1: mirrors the FUNCTION shape; no body). A
        // missing name (broken ABI operand) prints empty, like C's
        // zero-length token.
        d2 == 0 && k == AstKind.Extern ? {
            nt <- nd_get(nodes, ni, NF.Name)
            nm <- nt != 0 - 1 ? tk_lex(src, toks, nt) : ""
            print(str_cat(str_cat(str_cat(pd, "EXTERN "), nm), ts))
            s1 <- nd_get(nodes, ni, NF.L1s); c1 <- nd_get(nodes, ni, NF.L1n)
            j <- 0
            [j < c1] {
                pn_tok <- vec_get(kids, s1 + j)
                pn <- tk_lex(src, toks, pn_tok)
                print(str_cat(str_cat(pad(indent + 1), "PARAM "), pn))
                j <- j + 1
            }
            d2 <- 1
        }
        // --- BRACKET_LOOP ---
        d2 == 0 && k == AstKind.BracketLoop ? {
            has_binder <- nd_get(nodes, ni, NF.F1)
            has_binder == 1 ? { bn <- tk_lex(src, toks, nd_get(nodes, ni, NF.Name)); print(str_cat(str_cat(str_cat(pd, "BRACKET_LOOP "), bn), ts)); d2 <- 1 }
            d2 == 0 ? { print(str_cat(pd, str_cat("BRACKET_LOOP", ts))) }
            typed_ast_show(src, toks, nodes, kids, types, tp, tpn, nd_get(nodes, ni, NF.A), indent + 1)
            s1 <- nd_get(nodes, ni, NF.L1s); c1 <- nd_get(nodes, ni, NF.L1n)
            j <- 0; [j < c1] { typed_ast_show(src, toks, nodes, kids, types, tp, tpn, vec_get(kids, s1 + j), indent + 1); j <- j + 1 }
            typed_ast_show(src, toks, nodes, kids, types, tp, tpn, nd_get(nodes, ni, NF.B), indent + 1)
            d2 <- 1
        }
        // --- BREAK ---
        d2 == 0 && k == AstKind.Break ? { print(str_cat(pd, str_cat("BREAK", ts))); d2 <- 1 }
        // --- SKIP ---
        d2 == 0 && k == AstKind.Skip ? { print(str_cat(pd, str_cat("SKIP", ts))); d2 <- 1 }
        // --- STREAM_GEN ---
        d2 == 0 && k == AstKind.StreamGen ? {
            bc = nd_get(nodes, ni, NF.F1)
            hi = nd_get(nodes, ni, NF.F2)
            has_binders <- 0
            bc > 0 ? { has_binders <- 1 }
            hi == 1 ? { has_binders <- 1 }
            has_binders == 1 ? {
                lbl <- "STREAM_GEN("
                r1 = nd_get(nodes, ni, NF.R1)
                r2 = nd_get(nodes, ni, NF.R2)
                ci2 = nd_get(nodes, ni, NF.C)
                bc > 0 ? {
                    lbl <- str_cat(lbl, tk_lex(src, toks, r1))
                }
                bc > 1 ? {
                    lbl <- str_cat(str_cat(lbl, ", "), tk_lex(src, toks, r2))
                }
                hi == 1 ? {
                    lbl <- str_cat(str_cat(lbl, "; "), tk_lex(src, toks, ci2))
                }
                lbl <- str_cat(lbl, ")")
                print(str_cat(pd, str_cat(lbl, ts)))
            }
            has_binders == 0 ? {
                print(str_cat(pd, str_cat("STREAM_GEN", ts)))
            }
            s1 <- nd_get(nodes, ni, NF.L1s); c1 <- nd_get(nodes, ni, NF.L1n)
            j <- 0; [j < c1] { typed_ast_show(src, toks, nodes, kids, types, tp, tpn, vec_get(kids, s1 + j), indent + 1); j <- j + 1 }
            typed_ast_show(src, toks, nodes, kids, types, tp, tpn, nd_get(nodes, ni, NF.A), indent + 1)
            typed_ast_show(src, toks, nodes, kids, types, tp, tpn, nd_get(nodes, ni, NF.B), indent + 1)
            d2 <- 1
        }
        // --- ARRAY ---
        d2 == 0 && k == AstKind.Array ? {
            print(str_cat(pd, str_cat("ARRAY", ts)))
            s1 <- nd_get(nodes, ni, NF.L1s); c1 <- nd_get(nodes, ni, NF.L1n)
            j <- 0; [j < c1] { typed_ast_show(src, toks, nodes, kids, types, tp, tpn, vec_get(kids, s1 + j), indent + 1); j <- j + 1 }
            d2 <- 1
        }
        // --- DEFER ---
        d2 == 0 && k == AstKind.Defer ? {
            print(str_cat(pd, str_cat("DEFER", ts)))
            typed_ast_show(src, toks, nodes, kids, types, tp, tpn, nd_get(nodes, ni, NF.A), indent + 1)
            d2 <- 1
        }
        // --- FIELD_ACCESS ---
        d2 == 0 && k == AstKind.FieldAccess ? {
            fld <- tk_lex(src, toks, nd_get(nodes, ni, NF.Name))
            print(str_cat(str_cat(str_cat(pd, "FIELD_ACCESS "), fld), ts))
            typed_ast_show(src, toks, nodes, kids, types, tp, tpn, nd_get(nodes, ni, NF.A), indent + 1)
            d2 <- 1
        }
        // --- ENUM_DEF ---
        d2 == 0 && k == AstKind.EnumDef ? {
            nm <- tk_lex(src, toks, nd_get(nodes, ni, NF.Name))
            print(str_cat(str_cat(str_cat(pd, "ENUM_DEF "), nm), ts))
            s1 <- nd_get(nodes, ni, NF.L1s); c1 <- nd_get(nodes, ni, NF.L1n)
            j <- 0
            [j < c1] {
                vn_tok <- vec_get(kids, s1 + j)
                vnm <- tk_lex(src, toks, vn_tok)
                print(str_cat(str_cat(pad(indent + 1), "VARIANT "), vnm))
                j <- j + 1
            }
            d2 <- 1
        }
        // --- IMPORT ---
        d2 == 0 && k == AstKind.Import ? {
            nm <- tk_lex(src, toks, nd_get(nodes, ni, NF.Name))
            print(str_cat(str_cat(str_cat(pd, "IMPORT "), nm), ts))
            d2 <- 1
        }
        // fallback
        d2 == 0 ? { print(str_cat(pd, str_cat("UNKNOWN", ts))) }
    }
    0
}

// M13.5: run semantic analysis while retaining the node-type vector and type
// pool for the backend. All three output containers use shared-handle
// semantics, so the caller sees the elements appended here. Unlike
// semantic_check(), this entry point never writes a typed-AST dump to stdout.
semantic_run src:str path:str toks:vec[Token] nodes:vec[int] kids:vec[int] tops:vec[int] parse_err:i64 tp:vec[int] tpn:vec[str] types:vec[int] : i64 -> {
    prime_pool(tp, tpn)
    // Pre-fill types with -1 for each node
    nc <- vec_len(nodes) / 15
    j <- 0; [j < nc] { vec_push(types, 0 - 1); j <- j + 1 }
    en <- vec_new(); ed <- vec_new(); sc <- vec_new()
    st_reg <- vec_new(); st_data <- vec_new()
    st_names <- vec_new(); st_meta <- vec_new()
    en_reg <- vec_new(); en_data <- vec_new()
    fn_reg <- vec_new(); fn_data <- vec_new()
    fpts <- vec_new(); frks <- vec_new()
    ctx <- vec_new()
    vec_push(ctx, 0); vec_push(ctx, 0); vec_push(ctx, 0); vec_push(ctx, 0); vec_push(ctx, 0)
    top_count <- vec_len(tops)
    // Only run semantic checking if parse was clean
    parse_err == 0 ? {
        j <- 0
        [j < top_count] {
            ni <- vec_get(tops, j)
            check_node(src, path, toks, nodes, kids, types, en, ed, sc, st_reg, st_data, st_names, st_meta, en_reg, en_data, fn_reg, fn_data, fpts, frks, tp, tpn, ctx, ni)
            j <- j + 1
        }
    }
    parse_err != 0 ? parse_err : vec_get(ctx, CX.HasErr)
}

// Top-level dump entry: run the retained-state checker above, then print the
// typed AST exactly like the C dump_typed_ast command.
semantic_check src:str path:str toks:vec[Token] nodes:vec[int] kids:vec[int] tops:vec[int] parse_err:i64 : i64 -> {
    tp <- vec_new(); tpn <- vec_new(); types <- vec_new()
    has_err = semantic_run(src, path, toks, nodes, kids, tops, parse_err, tp, tpn, types)
    top_count = vec_len(tops)
    j <- 0
    [j < top_count] {
        typed_ast_show(src, toks, nodes, kids, types, tp, tpn, vec_get(tops, j), 0)
        j <- j + 1
    }
    has_err
}
