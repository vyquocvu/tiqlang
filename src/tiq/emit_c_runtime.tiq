    str_buf_append(b, "            return 1;\n")
    str_buf_append(b, "        p = tiq_json_ws(ve);\n")
    str_buf_append(b, "        if (*p != ',') break;\n")
    str_buf_append(b, "        p = tiq_json_ws(p + 1);\n")
    str_buf_append(b, "    }\n")
    str_buf_append(b, "    return 0;\n")
    str_buf_append(b, "}\n")
    str_buf_append(b, "\n")
    str_buf_append(b, "int64_t tiq_http_is_chunked(const char *h, size_t n) {\n")
    str_buf_append(b, "    for (size_t i = 0; i + 18 <= n; i++) {\n")
    str_buf_append(b, "        if ((i == 0 || h[i - 1] == '\\n') &&\n")
    str_buf_append(b, "            strncasecmp(h + i, \"transfer-encoding:\", 18) == 0) {\n")
    str_buf_append(b, "            size_t j = i + 18;\n")
    str_buf_append(b, "            while (j + 7 <= n && h[j] != '\\r' && h[j] != '\\n') {\n")
    str_buf_append(b, "                if (strncasecmp(h + j, \"chunked\", 7) == 0) return 1;\n")
    str_buf_append(b, "                j++;\n")
    str_buf_append(b, "            }\n")
    str_buf_append(b, "            return 0;\n")
    str_buf_append(b, "        }\n")
    str_buf_append(b, "    }\n")
    str_buf_append(b, "    return 0;\n")
    str_buf_append(b, "}\n")
    str_buf_append(b, "\n")
    str_buf_append(b, "char *tiq_http_unchunk(const char *p, size_t n) {\n")
    str_buf_append(b, "    char *out = (char *)tiq_alloc(n + 1);\n")
    str_buf_append(b, "    size_t len = 0, i = 0;\n")
    str_buf_append(b, "    for (;;) {\n")
    str_buf_append(b, "        size_t sz = 0;\n")
    str_buf_append(b, "        int digits = 0;\n")
    str_buf_append(b, "        while (i < n) {\n")
    str_buf_append(b, "            char c = p[i];\n")
    str_buf_append(b, "            int v;\n")
    str_buf_append(b, "            if (c >= '0' && c <= '9') v = c - '0';\n")
    str_buf_append(b, "            else if (c >= 'a' && c <= 'f') v = c - 'a' + 10;\n")
    str_buf_append(b, "            else if (c >= 'A' && c <= 'F') v = c - 'A' + 10;\n")
    str_buf_append(b, "            else break;\n")
    str_buf_append(b, "            sz = sz * 16 + (size_t)v;\n")
    str_buf_append(b, "            digits++;\n")
    str_buf_append(b, "            i++;\n")
    str_buf_append(b, "        }\n")
    str_buf_append(b, "        if (digits == 0 || digits > 8) { free(out); return 0; }\n")
    str_buf_append(b, "        while (i < n && p[i] != '\\r') i++;\n")
    str_buf_append(b, "        if (i + 1 >= n || p[i + 1] != '\\n') { free(out); return 0; }\n")
    str_buf_append(b, "        i += 2;\n")
    str_buf_append(b, "        if (sz == 0) break;\n")
    str_buf_append(b, "        if (i + sz + 2 > n) { free(out); return 0; }\n")
    str_buf_append(b, "        memcpy(out + len, p + i, sz);\n")
    str_buf_append(b, "        len += sz;\n")
    str_buf_append(b, "        i += sz;\n")
    str_buf_append(b, "        if (p[i] != '\\r' || p[i + 1] != '\\n') { free(out); return 0; }\n")
    str_buf_append(b, "        i += 2;\n")
    str_buf_append(b, "    }\n")
    str_buf_append(b, "    out[len] = 0;\n")
    str_buf_append(b, "    return out;\n")
    str_buf_append(b, "}\n")
    str_buf_append(b, "\n")
    str_buf_append(b, "const char *tiq_net_fetch(const char *url) {\n")
    str_buf_append(b, "    if (!url || strncmp(url, \"http://\", 7) != 0) return tiq_str_dup(\"\");\n")
    str_buf_append(b, "    const char *hs = url + 7;\n")
    str_buf_append(b, "    const char *he = hs;\n")
    str_buf_append(b, "    while (*he && *he != ':' && *he != '/') he++;\n")
    str_buf_append(b, "    if (he == hs || (size_t)(he - hs) >= 256) return tiq_str_dup(\"\");\n")
    str_buf_append(b, "    char host[256];\n")
    str_buf_append(b, "    memcpy(host, hs, (size_t)(he - hs));\n")
    str_buf_append(b, "    host[he - hs] = 0;\n")
    str_buf_append(b, "    char port[8] = \"80\";\n")
    str_buf_append(b, "    const char *p = he;\n")
    str_buf_append(b, "    if (*p == ':') {\n")
    str_buf_append(b, "        p++;\n")
    str_buf_append(b, "        size_t n = 0;\n")
    str_buf_append(b, "        while (*p && *p != '/' && n + 1 < sizeof port) port[n++] = *p++;\n")
    str_buf_append(b, "        if (n == 0 || (*p && *p != '/')) return tiq_str_dup(\"\");\n")
    str_buf_append(b, "        port[n] = 0;\n")
    str_buf_append(b, "    }\n")
    str_buf_append(b, "    const char *path = (*p == '/') ? p : \"/\";\n")
    str_buf_append(b, "    struct addrinfo hints, *res = 0;\n")
    str_buf_append(b, "    memset(&hints, 0, sizeof hints);\n")
    str_buf_append(b, "    hints.ai_family = AF_UNSPEC;\n")
    str_buf_append(b, "    hints.ai_socktype = SOCK_STREAM;\n")
    str_buf_append(b, "    if (getaddrinfo(host, port, &hints, &res) != 0 || !res) return tiq_str_dup(\"\");\n")
    str_buf_append(b, "    int fd = socket(res->ai_family, res->ai_socktype, res->ai_protocol);\n")
    str_buf_append(b, "    if (fd < 0) { freeaddrinfo(res); return tiq_str_dup(\"\"); }\n")
    str_buf_append(b, "    if (connect(fd, res->ai_addr, res->ai_addrlen) != 0) {\n")
    str_buf_append(b, "        freeaddrinfo(res); close(fd); return tiq_str_dup(\"\");\n")
    str_buf_append(b, "    }\n")
    str_buf_append(b, "    freeaddrinfo(res);\n")
    str_buf_append(b, "    char req[512];\n")
    str_buf_append(b, "    const char *reqfmt = \"GET %s HTTP/1.1\\r\\n\"\n")
    str_buf_append(b, "        \"Host: %s\\r\\nConnection: close\\r\\n\\r\\n\";\n")
    str_buf_append(b, "    int rl = snprintf(req, sizeof req, reqfmt, path, host);\n")
    str_buf_append(b, "    if (rl <= 0 || (size_t)rl >= sizeof req ||\n")
    str_buf_append(b, "        write(fd, req, (size_t)rl) != (ssize_t)rl) { close(fd); return tiq_str_dup(\"\"); }\n")
    str_buf_append(b, "    size_t cap = 4096, len = 0;\n")
    str_buf_append(b, "    char *buf = (char *)tiq_alloc(cap);\n")
    str_buf_append(b, "    for (;;) {\n")
    str_buf_append(b, "        if (len + 1025 >= cap) {\n")
    str_buf_append(b, "            cap *= 2;\n")
    str_buf_append(b, "            char *nb = (char *)realloc(buf, cap);\n")
    str_buf_append(b, "            if (!nb) { fprintf(stderr, \"tiq: out of memory\\n\"); exit(1); }\n")
    str_buf_append(b, "            buf = nb;\n")
    str_buf_append(b, "        }\n")
    str_buf_append(b, "        ssize_t r = read(fd, buf + len, 1024);\n")
    str_buf_append(b, "        if (r < 0) { free(buf); close(fd); return tiq_str_dup(\"\"); }\n")
    str_buf_append(b, "        if (r == 0) break;\n")
    str_buf_append(b, "        len += (size_t)r;\n")
    str_buf_append(b, "    }\n")
    str_buf_append(b, "    close(fd);\n")
    str_buf_append(b, "    buf[len] = 0;\n")
    str_buf_append(b, "    char *body = strstr(buf, \"\\r\\n\\r\\n\");\n")
    str_buf_append(b, "    if (!body) { free(buf); return tiq_str_dup(\"\"); }\n")
    str_buf_append(b, "    body += 4;\n")
    str_buf_append(b, "    size_t blen = len - (size_t)(body - buf);\n")
    str_buf_append(b, "    if (tiq_http_is_chunked(buf, (size_t)(body - buf))) {\n")
    str_buf_append(b, "        char *dec = tiq_http_unchunk(body, blen);\n")
    str_buf_append(b, "        free(buf);\n")
    str_buf_append(b, "        return dec ? dec : tiq_str_dup(\"\");\n")
    str_buf_append(b, "    }\n")
    str_buf_append(b, "    char *out = (char *)tiq_alloc(blen + 1);\n")
    str_buf_append(b, "    memcpy(out, body, blen + 1);\n")
    str_buf_append(b, "    free(buf);\n")
    str_buf_append(b, "    return out;\n")
    str_buf_append(b, "}\n")
    str_buf_append(b, "\n")
    str_buf_append(b, "int64_t tiq_net_listen(int64_t port) {\n")
    str_buf_append(b, "    int fd = socket(AF_INET, SOCK_STREAM, 0);\n")
    str_buf_append(b, "    if (fd < 0) return -1;\n")
    str_buf_append(b, "    int opt = 1;\n")
    str_buf_append(b, "    setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, &opt, sizeof opt);\n")
    str_buf_append(b, "    struct sockaddr_in a;\n")
    str_buf_append(b, "    memset(&a, 0, sizeof a);\n")
    str_buf_append(b, "    a.sin_family = AF_INET;\n")
    str_buf_append(b, "    a.sin_addr.s_addr = htonl(INADDR_LOOPBACK);\n")
    str_buf_append(b, "    a.sin_port = htons((uint16_t)port);\n")
    str_buf_append(b, "    if (bind(fd, (struct sockaddr *)&a, sizeof a) != 0 ||\n")
    str_buf_append(b, "        listen(fd, 1) != 0) { close(fd); return -1; }\n")
    str_buf_append(b, "    return fd;\n")
    str_buf_append(b, "}\n")
    str_buf_append(b, "\n")
    str_buf_append(b, "int64_t tiq_net_accept(int64_t fd) {\n")
    str_buf_append(b, "    int c = accept((int)fd, 0, 0);\n")
    str_buf_append(b, "    return c < 0 ? -1 : c;\n")
    str_buf_append(b, "}\n")
    str_buf_append(b, "\n")
    str_buf_append(b, "int64_t tiq_net_connect(int64_t port) {\n")
    str_buf_append(b, "    int fd = socket(AF_INET, SOCK_STREAM, 0);\n")
    str_buf_append(b, "    if (fd < 0) return -1;\n")
    str_buf_append(b, "    struct sockaddr_in a;\n")
    str_buf_append(b, "    memset(&a, 0, sizeof a);\n")
    str_buf_append(b, "    a.sin_family = AF_INET;\n")
    str_buf_append(b, "    a.sin_addr.s_addr = htonl(INADDR_LOOPBACK);\n")
    str_buf_append(b, "    a.sin_port = htons((uint16_t)port);\n")
    str_buf_append(b, "    if (connect(fd, (struct sockaddr *)&a, sizeof a) != 0) {\n")
    str_buf_append(b, "        close(fd); return -1;\n")
    str_buf_append(b, "    }\n")
    str_buf_append(b, "    return fd;\n")
    str_buf_append(b, "}\n")
    str_buf_append(b, "\n")
    str_buf_append(b, "const char *tiq_net_recv(int64_t fd) {\n")
    str_buf_append(b, "    char *buf = (char *)tiq_alloc(4097);\n")
    str_buf_append(b, "    ssize_t r = read((int)fd, buf, 4096);\n")
    str_buf_append(b, "    if (r <= 0) { free(buf); return tiq_str_dup(\"\"); }\n")
    str_buf_append(b, "    buf[r] = 0;\n")
    str_buf_append(b, "    return buf;\n")
    str_buf_append(b, "}\n")
    str_buf_append(b, "\n")
    str_buf_append(b, "int64_t tiq_net_send(int64_t fd, const char *data) {\n")
    str_buf_append(b, "    if (!data) return -1;\n")
    str_buf_append(b, "    size_t n = strlen(data);\n")
    str_buf_append(b, "    ssize_t w = write((int)fd, data, n);\n")
    str_buf_append(b, "    return w < 0 ? -1 : (int64_t)w;\n")
    str_buf_append(b, "}\n")
    str_buf_append(b, "\n")
    str_buf_append(b, "int64_t tiq_net_close(int64_t fd) {\n")
    str_buf_append(b, "    return close((int)fd) == 0 ? 0 : -1;\n")
    str_buf_append(b, "}\n")
    str_buf_append(b, "\n")
    str_buf_append(b, "int64_t tiq_net_port(int64_t fd) {\n")
    str_buf_append(b, "    struct sockaddr_in a;\n")
    str_buf_append(b, "    socklen_t len = sizeof a;\n")
    str_buf_append(b, "    if (getsockname((int)fd, (struct sockaddr *)&a, &len) != 0) return -1;\n")
    str_buf_append(b, "    return ntohs(a.sin_port);\n")
    str_buf_append(b, "}\n")
    str_buf_append(b, "\n")
    str_buf_append(b, "int64_t tiq_net_shutdown(int64_t fd) {\n")
    str_buf_append(b, "    return shutdown((int)fd, SHUT_WR) == 0 ? 0 : -1;\n")
    str_buf_append(b, "}\n")
    str_buf_append(b, "\n")
    str_buf_append(b, "const char *tiq_http_method(const char *req) {\n")
    str_buf_append(b, "    if (!req || !req[0]) return tiq_str_dup(\"\");\n")
    str_buf_append(b, "    const char *sp = strchr(req, ' ');\n")
    str_buf_append(b, "    if (!sp) return tiq_str_dup(req);\n")
    str_buf_append(b, "    size_t n = (size_t)(sp - req);\n")
    str_buf_append(b, "    char *out = (char *)tiq_alloc(n + 1);\n")
    str_buf_append(b, "    memcpy(out, req, n); out[n] = 0;\n")
    str_buf_append(b, "    return out;\n")
    str_buf_append(b, "}\n")
    str_buf_append(b, "\n")
    str_buf_append(b, "const char *tiq_http_path(const char *req) {\n")
    str_buf_append(b, "    if (!req) return tiq_str_dup(\"\");\n")
    str_buf_append(b, "    const char *sp1 = strchr(req, ' ');\n")
    str_buf_append(b, "    if (!sp1) return tiq_str_dup(\"\");\n")
    str_buf_append(b, "    const char *sp2 = strchr(sp1 + 1, ' ');\n")
    str_buf_append(b, "    if (!sp2) return tiq_str_dup(\"\");\n")
    str_buf_append(b, "    size_t n = (size_t)(sp2 - sp1 - 1);\n")
    str_buf_append(b, "    char *out = (char *)tiq_alloc(n + 1);\n")
    str_buf_append(b, "    memcpy(out, sp1 + 1, n); out[n] = 0;\n")
    str_buf_append(b, "    return out;\n")
    str_buf_append(b, "}\n")
    str_buf_append(b, "\n")
    str_buf_append(b, "#if defined(__APPLE__)\n")
    str_buf_append(b, "struct kevent tiq_ev_out_[64];\n")
    str_buf_append(b, "int64_t tiq_ev_nout_ = 0;\n")
    str_buf_append(b, "\n")
    str_buf_append(b, "int64_t tiq_ev_loop(void) {\n")
    str_buf_append(b, "    static int kq = -2;\n")
    str_buf_append(b, "    if (kq == -2) kq = kqueue();\n")
    str_buf_append(b, "    return kq;\n")
    str_buf_append(b, "}\n")
    str_buf_append(b, "\n")
    str_buf_append(b, "int64_t tiq_ev_add(int64_t loop, int64_t fd) {\n")
    str_buf_append(b, "    struct kevent ev;\n")
    str_buf_append(b, "    EV_SET(&ev, fd, EVFILT_READ, EV_ADD, 0, 0, NULL);\n")
    str_buf_append(b, "    return kevent((int)loop, &ev, 1, NULL, 0, NULL) == 0 ? 0 : -1;\n")
    str_buf_append(b, "}\n")
    str_buf_append(b, "\n")
    str_buf_append(b, "int64_t tiq_ev_wait(int64_t loop, int64_t timeout_ms) {\n")
    str_buf_append(b, "    struct timespec ts;\n")
    str_buf_append(b, "    struct timespec *tsp = NULL;\n")
    str_buf_append(b, "    if (timeout_ms >= 0) {\n")
    str_buf_append(b, "        ts.tv_sec = timeout_ms / 1000;\n")
    str_buf_append(b, "        ts.tv_nsec = (timeout_ms % 1000) * 1000000L;\n")
    str_buf_append(b, "        tsp = &ts;\n")
    str_buf_append(b, "    }\n")
    str_buf_append(b, "    tiq_ev_nout_ = kevent((int)loop, NULL, 0, tiq_ev_out_, 64, tsp);\n")
    str_buf_append(b, "    return tiq_ev_nout_;\n")
    str_buf_append(b, "}\n")
    str_buf_append(b, "\n")
    str_buf_append(b, "int64_t tiq_ev_ready(int64_t loop, int64_t fd) {\n")
    str_buf_append(b, "    (void)loop;\n")
    str_buf_append(b, "    for (int i = 0; i < tiq_ev_nout_; i++)\n")
    str_buf_append(b, "        if ((int64_t)tiq_ev_out_[i].ident == fd) return 1;\n")
    str_buf_append(b, "    return 0;\n")
    str_buf_append(b, "}\n")
    str_buf_append(b, "\n")
    str_buf_append(b, "#elif defined(__linux__)\n")
    str_buf_append(b, "struct epoll_event tiq_ev_out_[64];\n")
    str_buf_append(b, "int64_t tiq_ev_nout_ = 0;\n")
    str_buf_append(b, "\n")
    str_buf_append(b, "int64_t tiq_ev_loop(void) {\n")
    str_buf_append(b, "    static int kq = -2;\n")
    str_buf_append(b, "    if (kq == -2) kq = epoll_create(8);\n")
    str_buf_append(b, "    return kq;\n")
    str_buf_append(b, "}\n")
    str_buf_append(b, "\n")
    str_buf_append(b, "int64_t tiq_ev_add(int64_t loop, int64_t fd) {\n")
    str_buf_append(b, "    struct epoll_event ev;\n")
    str_buf_append(b, "    memset(&ev, 0, sizeof(ev));\n")
    str_buf_append(b, "    ev.events = EPOLLIN;\n")
    str_buf_append(b, "    ev.data.fd = (int)fd;\n")
    str_buf_append(b, "    return epoll_ctl((int)loop, EPOLL_CTL_ADD, (int)fd, &ev) == 0 ? 0 : -1;\n")
    str_buf_append(b, "}\n")
    str_buf_append(b, "\n")
    str_buf_append(b, "int64_t tiq_ev_wait(int64_t loop, int64_t timeout_ms) {\n")
    str_buf_append(b, "    tiq_ev_nout_ = epoll_wait((int)loop, tiq_ev_out_, 64, (int)timeout_ms);\n")
    str_buf_append(b, "    return tiq_ev_nout_;\n")
    str_buf_append(b, "}\n")
    str_buf_append(b, "\n")
    str_buf_append(b, "int64_t tiq_ev_ready(int64_t loop, int64_t fd) {\n")
    str_buf_append(b, "    (void)loop;\n")
    str_buf_append(b, "    for (int i = 0; i < tiq_ev_nout_; i++)\n")
    str_buf_append(b, "        if ((int64_t)tiq_ev_out_[i].data.fd == fd) return 1;\n")
    str_buf_append(b, "    return 0;\n")
    str_buf_append(b, "}\n")
    str_buf_append(b, "\n")
    str_buf_append(b, "#else\n")
    str_buf_append(b, "int64_t tiq_ev_nout_ = 0;\n")
    str_buf_append(b, "\n")
    str_buf_append(b, "int64_t tiq_ev_loop(void) { return -1; }\n")
    str_buf_append(b, "\n")
    str_buf_append(b, "int64_t tiq_ev_add(int64_t loop, int64_t fd) { (void)loop; (void)fd; return -1; }\n")
    str_buf_append(b, "\n")
    str_buf_append(b, "int64_t tiq_ev_wait(int64_t loop, int64_t timeout_ms) { (void)loop; (void)timeout_ms; return -1; }\n")
    str_buf_append(b, "\n")
    str_buf_append(b, "int64_t tiq_ev_ready(int64_t loop, int64_t fd) { (void)loop; (void)fd; return 0; }\n")
    str_buf_append(b, "\n")
    str_buf_append(b, "#endif\n")
    str_buf_append(b, "const char *tiq_json_set(const char *json, const char *key, const char *val) {\n")
    str_buf_append(b, "    if (!json || !key || !val) return tiq_str_dup(\"{}\");\n")
    str_buf_append(b, "    size_t jl = strlen(json), kl = strlen(key), vl = strlen(val);\n")
    str_buf_append(b, "    const char *p = json;\n")
    str_buf_append(b, "    while (*p == ' ' || *p == '\\t' || *p == '\\n' || *p == '\\r') p++;\n")
    str_buf_append(b, "    if (*p != '{') {\n")
    str_buf_append(b, "        size_t n = kl + vl + 5;\n")
    str_buf_append(b, "        char *r = (char *)tiq_alloc(n + 1);\n")
    str_buf_append(b, "        snprintf(r, n + 1, \"{\\\"%s\\\":%s}\", key, val);\n")
    str_buf_append(b, "        return r;\n")
    str_buf_append(b, "    }\n")
    str_buf_append(b, "    char pat[258];\n")
    str_buf_append(b, "    if (kl > 254) return tiq_str_dup(json);\n")
    str_buf_append(b, "    snprintf(pat, sizeof pat, \"\\\"%s\\\"\", key);\n")
    str_buf_append(b, "    size_t pl = strlen(pat);\n")
    str_buf_append(b, "    const char *m = NULL; int depth = 0; int in_str = 0;\n")
    str_buf_append(b, "    for (const char *s = p + 1; *s; s++) {\n")
    str_buf_append(b, "        if (in_str) { if (*s == '\\\\') s++; else if (*s == '\"') in_str = 0; continue; }\n")
    str_buf_append(b, "        if (*s == '\"') {\n")
    str_buf_append(b, "            if (depth == 0 && !m && strncmp(s, pat, pl) == 0) m = s;\n")
    str_buf_append(b, "            in_str = 1; continue;\n")
    str_buf_append(b, "        }\n")
    str_buf_append(b, "        if (*s == '{' || *s == '[') depth++;\n")
    str_buf_append(b, "        else if (*s == '}' || *s == ']') depth--;\n")
    str_buf_append(b, "    }\n")
    str_buf_append(b, "    if (m) {\n")
    str_buf_append(b, "        const char *c = m + pl;\n")
    str_buf_append(b, "        while (*c == ' ' || *c == '\\t' || *c == '\\n' || *c == '\\r') c++;\n")
    str_buf_append(b, "        if (*c != ':') return tiq_str_dup(json);\n")
    str_buf_append(b, "        c++;\n")
    str_buf_append(b, "        while (*c == ' ' || *c == '\\t' || *c == '\\n' || *c == '\\r') c++;\n")
    str_buf_append(b, "        const char *ve = c; int d2 = 0; int s2 = 0;\n")
    str_buf_append(b, "        while (*ve) {\n")
    str_buf_append(b, "            if (s2) { if (*ve == '\\\\') ve++; else if (*ve == '\"') s2 = 0; ve++; continue; }\n")
    str_buf_append(b, "            if (*ve == '\"') { s2 = 1; ve++; continue; }\n")
    str_buf_append(b, "            if (*ve == '{' || *ve == '[') { d2++; ve++; continue; }\n")
    str_buf_append(b, "            if (*ve == '}' || *ve == ']') { if (d2 == 0) break; d2--; ve++; continue; }\n")
    str_buf_append(b, "            if (*ve == ',' && d2 == 0) break;\n")
    str_buf_append(b, "            ve++;\n")
    str_buf_append(b, "        }\n")
    str_buf_append(b, "        size_t n = (size_t)(c - json) + vl + strlen(ve) + 1;\n")
    str_buf_append(b, "        char *r = (char *)tiq_alloc(n + 1);\n")
    str_buf_append(b, "        size_t pre = (size_t)(c - json);\n")
    str_buf_append(b, "        memcpy(r, json, pre);\n")
    str_buf_append(b, "        memcpy(r + pre, val, vl);\n")
    str_buf_append(b, "        strcpy(r + pre + vl, ve);\n")
    str_buf_append(b, "        return r;\n")
    str_buf_append(b, "    }\n")
    str_buf_append(b, "    const char *close = NULL; int d3 = 0; int s3 = 0;\n")
    str_buf_append(b, "    for (const char *s = p; *s; s++) {\n")
    str_buf_append(b, "        if (s3) { if (*s == '\\\\') s++; else if (*s == '\"') s3 = 0; continue; }\n")
    str_buf_append(b, "        if (*s == '\"') { s3 = 1; continue; }\n")
    str_buf_append(b, "        if (*s == '{' || *s == '[') d3++;\n")
    str_buf_append(b, "        else if (*s == '}' || *s == ']') { d3--; if (d3 == 0) { close = s; break; } }\n")
    str_buf_append(b, "    }\n")
    str_buf_append(b, "    if (!close) return tiq_str_dup(json);\n")
    str_buf_append(b, "    int empty = 1;\n")
    str_buf_append(b, "    for (const char *s = p + 1; s < close; s++)\n")
    str_buf_append(b, "        if (*s != ' ' && *s != '\\t' && *s != '\\n' && *s != '\\r') { empty = 0; break; }\n")
    str_buf_append(b, "    size_t n = jl + kl + vl + (empty ? 4 : 5);\n")
    str_buf_append(b, "    char *r = (char *)tiq_alloc(n + 1);\n")
    str_buf_append(b, "    size_t pre = (size_t)(close - json);\n")
    str_buf_append(b, "    memcpy(r, json, pre);\n")
    str_buf_append(b, "    char *w = r + pre;\n")
    str_buf_append(b, "    if (!empty) *w++ = ',';\n")
    str_buf_append(b, "    *w++ = '\"';\n")
    str_buf_append(b, "    memcpy(w, key, kl); w += kl;\n")
    str_buf_append(b, "    *w++ = '\"'; *w++ = ':';\n")
    str_buf_append(b, "    memcpy(w, val, vl); w += vl;\n")
    str_buf_append(b, "    strcpy(w, close);\n")
    str_buf_append(b, "    return r;\n")
    str_buf_append(b, "}\n")
    str_buf_append(b, "\n")
    str_buf_append(b, "const char *tiq_json_del(const char *json, const char *key) {\n")
    str_buf_append(b, "    if (!json || !key) return tiq_str_dup(\"\");\n")
    str_buf_append(b, "    size_t jl = strlen(json), kl = strlen(key);\n")
    str_buf_append(b, "    const char *p = json;\n")
    str_buf_append(b, "    while (*p == ' ' || *p == '\\t' || *p == '\\n' || *p == '\\r') p++;\n")
    str_buf_append(b, "    if (*p != '{') return tiq_str_dup(json);\n")
    str_buf_append(b, "    char pat[258];\n")
    str_buf_append(b, "    if (kl > 254) return tiq_str_dup(json);\n")
    str_buf_append(b, "    snprintf(pat, sizeof pat, \"\\\"%s\\\"\", key);\n")
    str_buf_append(b, "    size_t pl = strlen(pat);\n")
    str_buf_append(b, "    const char *m = NULL; int depth = 0; int in_str = 0;\n")
    str_buf_append(b, "    for (const char *s = p + 1; *s; s++) {\n")
    str_buf_append(b, "        if (in_str) { if (*s == '\\\\') s++; else if (*s == '\"') in_str = 0; continue; }\n")
    str_buf_append(b, "        if (*s == '\"') {\n")
    str_buf_append(b, "            if (depth == 0 && !m && strncmp(s, pat, pl) == 0) m = s;\n")
    str_buf_append(b, "            in_str = 1; continue;\n")
    str_buf_append(b, "        }\n")
    str_buf_append(b, "        if (*s == '{' || *s == '[') depth++;\n")
    str_buf_append(b, "        else if (*s == '}' || *s == ']') depth--;\n")
    str_buf_append(b, "    }\n")
    str_buf_append(b, "    if (!m) return tiq_str_dup(json);\n")
    str_buf_append(b, "    const char *comma_before = NULL;\n")
    str_buf_append(b, "    for (const char *s = m - 1; s > p; s--) {\n")
    str_buf_append(b, "        if (*s == ' ' || *s == '\\t' || *s == '\\n' || *s == '\\r') continue;\n")
    str_buf_append(b, "        if (*s == ',') comma_before = s;\n")
    str_buf_append(b, "        break;\n")
    str_buf_append(b, "    }\n")
    str_buf_append(b, "    const char *c = m + pl;\n")
    str_buf_append(b, "    while (*c == ' ' || *c == '\\t' || *c == '\\n' || *c == '\\r') c++;\n")
    str_buf_append(b, "    if (*c != ':') return tiq_str_dup(json);\n")
    str_buf_append(b, "    c++;\n")
    str_buf_append(b, "    while (*c == ' ' || *c == '\\t' || *c == '\\n' || *c == '\\r') c++;\n")
    str_buf_append(b, "    const char *ve = c; int d2 = 0; int s2 = 0;\n")
    str_buf_append(b, "    while (*ve) {\n")
    str_buf_append(b, "        if (s2) { if (*ve == '\\\\') ve++; else if (*ve == '\"') s2 = 0; ve++; continue; }\n")
    str_buf_append(b, "        if (*ve == '\"') { s2 = 1; ve++; continue; }\n")
    str_buf_append(b, "        if (*ve == '{' || *ve == '[') { d2++; ve++; continue; }\n")
    str_buf_append(b, "        if (*ve == '}' || *ve == ']') { if (d2 == 0) break; d2--; ve++; continue; }\n")
    str_buf_append(b, "        if (*ve == ',' && d2 == 0) break;\n")
    str_buf_append(b, "        ve++;\n")
    str_buf_append(b, "    }\n")
    str_buf_append(b, "    const char *rm_start, *rm_end;\n")
    str_buf_append(b, "    if (comma_before) {\n")
    str_buf_append(b, "        rm_start = comma_before;\n")
    str_buf_append(b, "        rm_end = ve;\n")
    str_buf_append(b, "    } else {\n")
    str_buf_append(b, "        rm_start = m;\n")
    str_buf_append(b, "        rm_end = ve;\n")
    str_buf_append(b, "        if (*ve == ',') rm_end = ve + 1;\n")
    str_buf_append(b, "    }\n")
    str_buf_append(b, "    size_t n = jl - (size_t)(rm_end - rm_start) + 1;\n")
    str_buf_append(b, "    char *r = (char *)tiq_alloc(n + 1);\n")
    str_buf_append(b, "    size_t pre = (size_t)(rm_start - json);\n")
    str_buf_append(b, "    memcpy(r, json, pre);\n")
    str_buf_append(b, "    strcpy(r + pre, rm_end);\n")
    str_buf_append(b, "    return r;\n")
    str_buf_append(b, "}\n")
    str_buf_append(b, "\n")
    str_buf_append(b, "const char *tiq_str_cat(const char *a, const char *b) {\n")
    str_buf_append(b, "    if (!a) a = \"\";\n")
    str_buf_append(b, "    if (!b) b = \"\";\n")
    str_buf_append(b, "    size_t la = strlen(a), lb = strlen(b);\n")
    str_buf_append(b, "    char *r = (char *)tiq_alloc(la + lb + 1);\n")
    str_buf_append(b, "    memcpy(r, a, la);\n")
    str_buf_append(b, "    memcpy(r + la, b, lb + 1);\n")
    str_buf_append(b, "    return r;\n")
    str_buf_append(b, "}\n")
    str_buf_append(b, "\n")
    str_buf_append(b, "const char *tiq_int_str(int64_t n) {\n")
    str_buf_append(b, "    char *r = (char *)tiq_alloc(21);\n")
    str_buf_append(b, "    snprintf(r, 21, \"%lld\", (long long)n);\n")
    str_buf_append(b, "    return r;\n")
    str_buf_append(b, "}\n")
    str_buf_append(b, "\n")
    str_buf_append(b, "\n")
    str_buf_append(b, "const char *tiq_http_header(const char *req, const char *name) {\n")
    str_buf_append(b, "    if (!req || !name) return tiq_str_dup(\"\");\n")
    str_buf_append(b, "    size_t nl = strlen(name);\n")
    str_buf_append(b, "    const char *p = req;\n")
    str_buf_append(b, "    while (*p && *p != '\\n') p++;\n")
    str_buf_append(b, "    if (*p == '\\n') p++;\n")
    str_buf_append(b, "    while (*p) {\n")
    str_buf_append(b, "        if (*p == '\\r' || *p == '\\n') break;\n")
    str_buf_append(b, "        if (strncasecmp(p, name, nl) == 0 && p[nl] == ':') {\n")
    str_buf_append(b, "            const char *v = p + nl + 1;\n")
    str_buf_append(b, "            while (*v == ' ' || *v == '\\t') v++;\n")
    str_buf_append(b, "            const char *e = v;\n")
    str_buf_append(b, "            while (*e && *e != '\\r' && *e != '\\n') e++;\n")
    str_buf_append(b, "            size_t len = (size_t)(e - v);\n")
    str_buf_append(b, "            char *r = (char *)tiq_alloc(len + 1);\n")
    str_buf_append(b, "            memcpy(r, v, len);\n")
    str_buf_append(b, "            r[len] = '\\0';\n")
    str_buf_append(b, "            return r;\n")
    str_buf_append(b, "        }\n")
    str_buf_append(b, "        while (*p && *p != '\\n') p++;\n")
    str_buf_append(b, "        if (*p == '\\n') p++;\n")
    str_buf_append(b, "    }\n")
    str_buf_append(b, "    return tiq_str_dup(\"\");\n")
    str_buf_append(b, "}\n")
    str_buf_append(b, "const char *tiq_str_sub(const char *s, int64_t start, int64_t end) {\n")
    str_buf_append(b, "    if (!s) return tiq_str_dup(\"\");\n")
    str_buf_append(b, "    int64_t len = (int64_t)strlen(s);\n")
    str_buf_append(b, "    if (start < 0 || end < start || end > len) return tiq_str_dup(\"\");\n")
    str_buf_append(b, "    size_t n = (size_t)(end - start);\n")
    str_buf_append(b, "    char *r = (char *)tiq_alloc(n + 1);\n")
    str_buf_append(b, "    memcpy(r, s + start, n);\n")
    str_buf_append(b, "    r[n] = '\\0';\n")
    str_buf_append(b, "    return r;\n")
    str_buf_append(b, "}\n")
    str_buf_append(b, "\n")
    str_buf_append(b, "int64_t tiq_str_sub_code(const char *s, int64_t idx) {\n")
    str_buf_append(b, "    if (!s) return 0;\n")
    str_buf_append(b, "    int64_t len = (int64_t)strlen(s);\n")
    str_buf_append(b, "    if (idx < 0 || idx >= len) return 0;\n")
    str_buf_append(b, "    return (int64_t)(unsigned char)s[idx];\n")
    str_buf_append(b, "}\n")
    str_buf_append(b, "\n")
    str_buf_append(b, "int64_t tiq_str_eq(const char *a, const char *b) {\n")
    str_buf_append(b, "    if (!a) a = \"\";\n")
    str_buf_append(b, "    if (!b) b = \"\";\n")
    str_buf_append(b, "    return strcmp(a, b) == 0 ? 1 : 0;\n")
    str_buf_append(b, "}\n")
    str_buf_append(b, "\n")
    str_buf_append(b, "int64_t tiq_eprint(const char *s) {\n")
    str_buf_append(b, "    if (!s) s = \"\";\n")
    str_buf_append(b, "    int n = fprintf(stderr, \"%s\\n\", s);\n")
    str_buf_append(b, "    return n < 0 ? -1 : (int64_t)n;\n")
    str_buf_append(b, "}\n")
    str_buf_append(b, "\n")
    str_buf_append(b, "const char *tiq_fs_list(const char *dir) {\n")
    str_buf_append(b, "    if (!dir) return tiq_str_dup(\"\");\n")
    str_buf_append(b, "    DIR *d = opendir(dir);\n")
    str_buf_append(b, "    if (!d) return tiq_str_dup(\"\");\n")
    str_buf_append(b, "    char **names = NULL;\n")
    str_buf_append(b, "    size_t count = 0, cap = 0, total = 0;\n")
    str_buf_append(b, "    struct dirent *e;\n")
    str_buf_append(b, "    while ((e = readdir(d)) != NULL) {\n")
    str_buf_append(b, "        if (strcmp(e->d_name, \".\") == 0 || strcmp(e->d_name, \"..\") == 0) continue;\n")
    str_buf_append(b, "        if (count == cap) {\n")
    str_buf_append(b, "            cap = cap ? cap * 2 : 16;\n")
    str_buf_append(b, "            char **nn = (char **)realloc(names, cap * sizeof *nn);\n")
    str_buf_append(b, "            if (!nn) { fprintf(stderr, \"tiq: out of memory\\n\"); exit(1); }\n")
    str_buf_append(b, "            names = nn;\n")
    str_buf_append(b, "        }\n")
    str_buf_append(b, "        names[count++] = (char *)tiq_str_dup(e->d_name);\n")
    str_buf_append(b, "        total += strlen(e->d_name) + 1;\n")
    str_buf_append(b, "    }\n")
    str_buf_append(b, "    closedir(d);\n")
    str_buf_append(b, "    if (count == 0) { free(names); return tiq_str_dup(\"\"); }\n")
    str_buf_append(b, "    for (size_t i = 1; i < count; i++) {\n")
    str_buf_append(b, "        char *key = names[i];\n")
    str_buf_append(b, "        size_t j = i;\n")
    str_buf_append(b, "        while (j > 0 && strcmp(names[j - 1], key) > 0) {\n")
    str_buf_append(b, "            names[j] = names[j - 1];\n")
    str_buf_append(b, "            j--;\n")
    str_buf_append(b, "        }\n")
    str_buf_append(b, "        names[j] = key;\n")
    str_buf_append(b, "    }\n")
    str_buf_append(b, "    char *r = (char *)tiq_alloc(total);\n")
    str_buf_append(b, "    size_t pos = 0;\n")
    str_buf_append(b, "    for (size_t i = 0; i < count; i++) {\n")
    str_buf_append(b, "        size_t n = strlen(names[i]);\n")
    str_buf_append(b, "        memcpy(r + pos, names[i], n);\n")
    str_buf_append(b, "        pos += n;\n")
    str_buf_append(b, "        r[pos++] = (i + 1 < count) ? '\\n' : '\\0';\n")
    str_buf_append(b, "        free(names[i]);\n")
    str_buf_append(b, "    }\n")
    str_buf_append(b, "    free(names);\n")
    str_buf_append(b, "    return r;\n")
    str_buf_append(b, "}\n")
    str_buf_append(b, "typedef struct { unsigned char *data; int64_t len; int64_t cap; int64_t elem_size; } TiqVec;\n")
    str_buf_append(b, "\n")
    str_buf_append(b, "TiqVec *tiq_vec_new(void) {\n")
    str_buf_append(b, "    TiqVec *v = (TiqVec *)tiq_alloc(sizeof(TiqVec));\n")
    str_buf_append(b, "    v->data = NULL;\n")
    str_buf_append(b, "    v->len = 0;\n")
    str_buf_append(b, "    v->cap = 0;\n")
    str_buf_append(b, "    v->elem_size = 0;\n")
    str_buf_append(b, "    return v;\n")
    str_buf_append(b, "}\n")
    str_buf_append(b, "\n")
    str_buf_append(b, "void tiq_vec_reserve(TiqVec *v, int64_t elem_size) {\n")
    str_buf_append(b, "    if (v->elem_size == 0) v->elem_size = elem_size;\n")
    str_buf_append(b, "    if (v->len < v->cap) return;\n")
    str_buf_append(b, "    int64_t nc = v->cap == 0 ? 8 : v->cap * 2;\n")
    str_buf_append(b, "    unsigned char *nd = (unsigned char *)tiq_alloc((size_t)(nc * v->elem_size));\n")
    str_buf_append(b, "    if (v->len > 0) memcpy(nd, v->data, (size_t)(v->len * v->elem_size));\n")
    str_buf_append(b, "    v->data = nd;\n")
    str_buf_append(b, "    v->cap = nc;\n")
    str_buf_append(b, "}\n")
    str_buf_append(b, "\n")
    str_buf_append(b, "int64_t tiq_vec_len(TiqVec *v) {\n")
    str_buf_append(b, "    return v->len;\n")
    str_buf_append(b, "}\n")
    str_buf_append(b, "\n")
    str_buf_append(b, "unsigned char *tiq_vec_slot(TiqVec *v, int64_t i) {\n")
    str_buf_append(b, "    if (i < 0 || i >= v->len) {\n")
    str_buf_append(b, "        fprintf(stderr, \"tiq: vec index %lld out of bounds for vec of length %lld\\n\",\n")
    str_buf_append(b, "                (long long)i, (long long)v->len);\n")
    str_buf_append(b, "        exit(1);\n")
    str_buf_append(b, "    }\n")
    str_buf_append(b, "    return v->data + (size_t)(i * v->elem_size);\n")
    str_buf_append(b, "}\n")
    str_buf_append(b, "\n")
    str_buf_append(b, "unsigned char *tiq_vec_push_slot(TiqVec *v, int64_t elem_size) {\n")
    str_buf_append(b, "    tiq_vec_reserve(v, elem_size);\n")
    str_buf_append(b, "    return v->data + (size_t)(v->len++ * v->elem_size);\n")
    str_buf_append(b, "}\n")
    str_buf_append(b, "\n")
    str_buf_append(b, "int64_t tiq_vec_push_i64(TiqVec *v, int64_t x) {\n")
    str_buf_append(b, "    memcpy(tiq_vec_push_slot(v, (int64_t)sizeof(int64_t)), &x, sizeof(int64_t));\n")
    str_buf_append(b, "    return v->len;\n")
    str_buf_append(b, "}\n")
    str_buf_append(b, "\n")
    str_buf_append(b, "int64_t tiq_vec_push_str(TiqVec *v, const char *s) {\n")
    str_buf_append(b, "    const char *d = tiq_str_dup(s ? s : \"\");\n")
    str_buf_append(b, "    memcpy(tiq_vec_push_slot(v, (int64_t)sizeof(const char *)), &d, sizeof(const char *));\n")
    str_buf_append(b, "    return v->len;\n")
    str_buf_append(b, "}\n")
    str_buf_append(b, "\n")
    str_buf_append(b, "int64_t tiq_vec_set_str(TiqVec *v, int64_t i, const char *s) {\n")
    str_buf_append(b, "    const char *d = tiq_str_dup(s ? s : \"\");\n")
    str_buf_append(b, "    memcpy(tiq_vec_slot(v, i), &d, sizeof(const char *));\n")
    str_buf_append(b, "    return 0;\n")
    str_buf_append(b, "}\n")
    str_buf_append(b, "\n")
    str_buf_append(b, "int64_t tiq_vec_set_i64(TiqVec *v, int64_t i, int64_t x) {\n")
    str_buf_append(b, "    memcpy(tiq_vec_slot(v, i), &x, sizeof(int64_t));\n")
    str_buf_append(b, "    return 0;\n")
    str_buf_append(b, "}\n")
    str_buf_append(b, "\n")
    str_buf_append(b, "unsigned char *tiq_vec_pop(TiqVec *v) {\n")
    str_buf_append(b, "    if (v->len == 0) {\n")
    str_buf_append(b, "        fprintf(stderr, \"tiq: vec_pop on empty vec\\n\");\n")
    str_buf_append(b, "        exit(1);\n")
    str_buf_append(b, "    }\n")
    str_buf_append(b, "    v->len--;\n")
    str_buf_append(b, "    return v->data + (size_t)(v->len * v->elem_size);\n")
    str_buf_append(b, "}\n")
    str_buf_append(b, "typedef struct { char *data; int64_t len; int64_t cap; } TiqStrBuf;\n")
    str_buf_append(b, "\n")
    str_buf_append(b, "TiqStrBuf *tiq_str_buf_new(void) {\n")
    str_buf_append(b, "    TiqStrBuf *b = (TiqStrBuf *)tiq_alloc(sizeof(TiqStrBuf));\n")
    str_buf_append(b, "    b->cap = 16;\n")
    str_buf_append(b, "    b->data = (char *)tiq_alloc((size_t)b->cap);\n")
    str_buf_append(b, "    b->data[0] = '\\0';\n")
    str_buf_append(b, "    b->len = 0;\n")
    str_buf_append(b, "    return b;\n")
    str_buf_append(b, "}\n")
    str_buf_append(b, "\n")
    str_buf_append(b, "int64_t tiq_str_buf_len(TiqStrBuf *b) {\n")
    str_buf_append(b, "    return b->len;\n")
    str_buf_append(b, "}\n")
    str_buf_append(b, "\n")
    str_buf_append(b, "int64_t tiq_str_buf_append(TiqStrBuf *b, const char *s) {\n")
    str_buf_append(b, "    size_t n = s ? strlen(s) : 0;\n")
    str_buf_append(b, "    if (n == 0) return b->len;\n")
    str_buf_append(b, "    int64_t need = b->len + (int64_t)n + 1;\n")
    str_buf_append(b, "    if (need > b->cap) {\n")
    str_buf_append(b, "        int64_t nc = b->cap;\n")
    str_buf_append(b, "        while (nc < need) nc *= 2;\n")
    str_buf_append(b, "        char *nd = (char *)tiq_alloc((size_t)nc);\n")
    str_buf_append(b, "        memcpy(nd, b->data, (size_t)b->len + 1);\n")
    str_buf_append(b, "        b->data = nd;\n")
    str_buf_append(b, "        b->cap = nc;\n")
    str_buf_append(b, "    }\n")
    str_buf_append(b, "    memcpy(b->data + b->len, s, n);\n")
    str_buf_append(b, "    b->len += (int64_t)n;\n")
    str_buf_append(b, "    b->data[b->len] = '\\0';\n")
    str_buf_append(b, "    return b->len;\n")
    str_buf_append(b, "}\n")
    str_buf_append(b, "\n")
    str_buf_append(b, "const char *tiq_str_buf_to_str(TiqStrBuf *b) {\n")
    str_buf_append(b, "    char *s = (char *)tiq_alloc((size_t)b->len + 1);\n")
    str_buf_append(b, "    memcpy(s, b->data, (size_t)b->len + 1);\n")
    str_buf_append(b, "    return s;\n")
    str_buf_append(b, "}\n")
    str_buf_append(b, "typedef struct { const char **keys; int64_t *vals; int64_t len; int64_t cap; int64_t *buckets; int64_t nbuckets; } TiqMap;\n")
    str_buf_append(b, "\n")
    str_buf_append(b, "uint64_t tiq_map_hash(const char *s) {\n")
    str_buf_append(b, "    uint64_t h = 14695981039346656037ULL;\n")
    str_buf_append(b, "    while (*s) {\n")
    str_buf_append(b, "        h ^= (uint64_t)(unsigned char)*s++;\n")
    str_buf_append(b, "        h *= 1099511628211ULL;\n")
    str_buf_append(b, "    }\n")
    str_buf_append(b, "    return h;\n")
    str_buf_append(b, "}\n")
    str_buf_append(b, "\n")
    str_buf_append(b, "TiqMap *tiq_map_new(void) {\n")
    str_buf_append(b, "    TiqMap *m = (TiqMap *)tiq_alloc(sizeof(TiqMap));\n")
    str_buf_append(b, "    m->keys = NULL;\n")
    str_buf_append(b, "    m->vals = NULL;\n")
    str_buf_append(b, "    m->len = 0;\n")
    str_buf_append(b, "    m->cap = 0;\n")
    str_buf_append(b, "    m->nbuckets = 8;\n")
    str_buf_append(b, "    m->buckets = (int64_t *)tiq_alloc((size_t)m->nbuckets * sizeof(int64_t));\n")
    str_buf_append(b, "    for (int64_t i = 0; i < m->nbuckets; i++) m->buckets[i] = -1;\n")
    str_buf_append(b, "    return m;\n")
    str_buf_append(b, "}\n")
    str_buf_append(b, "\n")
    str_buf_append(b, "void tiq_map_place(TiqMap *m, int64_t e) {\n")
    str_buf_append(b, "    int64_t b = (int64_t)(tiq_map_hash(m->keys[e]) & (uint64_t)(m->nbuckets - 1));\n")
    str_buf_append(b, "    while (m->buckets[b] >= 0) b = (b + 1) & (m->nbuckets - 1);\n")
    str_buf_append(b, "    m->buckets[b] = e;\n")
    str_buf_append(b, "}\n")
    str_buf_append(b, "\n")
    str_buf_append(b, "void tiq_map_rehash(TiqMap *m) {\n")
    str_buf_append(b, "    m->nbuckets *= 2;\n")
    str_buf_append(b, "    m->buckets = (int64_t *)tiq_alloc((size_t)m->nbuckets * sizeof(int64_t));\n")
    str_buf_append(b, "    for (int64_t i = 0; i < m->nbuckets; i++) m->buckets[i] = -1;\n")
    str_buf_append(b, "    for (int64_t e = 0; e < m->len; e++) tiq_map_place(m, e);\n")
    str_buf_append(b, "}\n")
    str_buf_append(b, "\n")
    str_buf_append(b, "int64_t tiq_map_find(TiqMap *m, const char *k) {\n")
    str_buf_append(b, "    int64_t b = (int64_t)(tiq_map_hash(k) & (uint64_t)(m->nbuckets - 1));\n")
    str_buf_append(b, "    for (;;) {\n")
    str_buf_append(b, "        int64_t e = m->buckets[b];\n")
    str_buf_append(b, "        if (e < 0) return -1;\n")
    str_buf_append(b, "        if (strcmp(m->keys[e], k) == 0) return e;\n")
    str_buf_append(b, "        b = (b + 1) & (m->nbuckets - 1);\n")
    str_buf_append(b, "    }\n")
    str_buf_append(b, "}\n")
    str_buf_append(b, "\n")
    str_buf_append(b, "int64_t tiq_map_set(TiqMap *m, const char *k, int64_t v) {\n")
    str_buf_append(b, "    const char *kk = k ? k : \"\";\n")
    str_buf_append(b, "    int64_t e = tiq_map_find(m, kk);\n")
    str_buf_append(b, "    if (e >= 0) {\n")
    str_buf_append(b, "        m->vals[e] = v;\n")
    str_buf_append(b, "        return m->len;\n")
    str_buf_append(b, "    }\n")
    str_buf_append(b, "    if ((m->len + 1) * 10 > m->nbuckets * 7) tiq_map_rehash(m);\n")
    str_buf_append(b, "    if (m->len == m->cap) {\n")
    str_buf_append(b, "        int64_t nc = m->cap == 0 ? 8 : m->cap * 2;\n")
    str_buf_append(b, "        const char **nk = (const char **)tiq_alloc((size_t)nc * sizeof(const char *));\n")
    str_buf_append(b, "        int64_t *nv = (int64_t *)tiq_alloc((size_t)nc * sizeof(int64_t));\n")
    str_buf_append(b, "        if (m->len > 0) {\n")
    str_buf_append(b, "            memcpy(nk, m->keys, (size_t)m->len * sizeof(const char *));\n")
    str_buf_append(b, "            memcpy(nv, m->vals, (size_t)m->len * sizeof(int64_t));\n")
    str_buf_append(b, "        }\n")
    str_buf_append(b, "        m->keys = nk;\n")
    str_buf_append(b, "        m->vals = nv;\n")
    str_buf_append(b, "        m->cap = nc;\n")
    str_buf_append(b, "    }\n")
    str_buf_append(b, "    m->keys[m->len] = tiq_str_dup(kk);\n")
    str_buf_append(b, "    m->vals[m->len] = v;\n")
    str_buf_append(b, "    tiq_map_place(m, m->len);\n")
    str_buf_append(b, "    m->len++;\n")
    str_buf_append(b, "    return m->len;\n")
    str_buf_append(b, "}\n")
    str_buf_append(b, "\n")
    str_buf_append(b, "int64_t tiq_map_get(TiqMap *m, const char *k) {\n")
    str_buf_append(b, "    int64_t e = tiq_map_find(m, k ? k : \"\");\n")
    str_buf_append(b, "    return e >= 0 ? m->vals[e] : -1;\n")
    str_buf_append(b, "}\n")
    str_buf_append(b, "\n")
    str_buf_append(b, "int64_t tiq_map_has(TiqMap *m, const char *k) {\n")
    str_buf_append(b, "    return tiq_map_find(m, k ? k : \"\") >= 0 ? 1 : 0;\n")
    str_buf_append(b, "}\n")
    str_buf_append(b, "\n")
    str_buf_append(b, "int64_t tiq_map_len(TiqMap *m) {\n")
    str_buf_append(b, "    return m->len;\n")
    str_buf_append(b, "}\n")
    str_buf_append(b, "\n")
    str_buf_append(b, "int64_t tiq_map_index(TiqMap *m, int64_t i) {\n")
    str_buf_append(b, "    if (i < 0 || i >= m->len) {\n")
    str_buf_append(b, "        fprintf(stderr, \"tiq: map index %lld out of bounds for map of length %lld\\n\",\n")
    str_buf_append(b, "                (long long)i, (long long)m->len);\n")
    str_buf_append(b, "        exit(1);\n")
    str_buf_append(b, "    }\n")
    str_buf_append(b, "    return i;\n")
    str_buf_append(b, "}\n")
    str_buf_append(b, "\n")
    str_buf_append(b, "const char *tiq_map_key_at(TiqMap *m, int64_t i) {\n")
    str_buf_append(b, "    return m->keys[tiq_map_index(m, i)];\n")
    str_buf_append(b, "}\n")
    str_buf_append(b, "\n")
    str_buf_append(b, "int64_t tiq_map_val_at(TiqMap *m, int64_t i) {\n")
    str_buf_append(b, "    return m->vals[tiq_map_index(m, i)];\n")
    str_buf_append(b, "}\n")
    str_buf_append(b, "\n")
    str_buf_append(b, "uint64_t tiq_dl_open(const char *path) {\n")
    str_buf_append(b, "    void *h = dlopen(path, RTLD_NOW | RTLD_LOCAL);\n")
    str_buf_append(b, "    return (uint64_t)(uintptr_t)h;\n")
    str_buf_append(b, "}\n")
    str_buf_append(b, "\n")
    str_buf_append(b, "uint64_t tiq_dl_sym(uint64_t handle, const char *name) {\n")
    str_buf_append(b, "    void *s = dlsym((void *)(uintptr_t)handle, name);\n")
    str_buf_append(b, "    return (uint64_t)(uintptr_t)s;\n")
    str_buf_append(b, "}\n")
    str_buf_append(b, "\n")
    str_buf_append(b, "const char *tiq_dl_error(void) {\n")
    str_buf_append(b, "    const char *e = dlerror();\n")
    str_buf_append(b, "    return tiq_str_dup(e ? e : \"\");\n")
    str_buf_append(b, "}\n")
    str_buf_append(b, "\n")
    str_buf_append(b, "int64_t tiq_dl_call(uint64_t sym, int64_t a, int64_t b, int64_t c,\n")
    str_buf_append(b, "                           int64_t d, int64_t e, int64_t f) {\n")
    str_buf_append(b, "    if (!sym) return 0;\n")
    str_buf_append(b, "    int64_t (*fn)(int64_t, int64_t, int64_t, int64_t, int64_t, int64_t) =\n")
    str_buf_append(b, "        (int64_t (*)(int64_t, int64_t, int64_t, int64_t, int64_t, int64_t))(uintptr_t)sym;\n")
    str_buf_append(b, "    return fn(a, b, c, d, e, f);\n")
    str_buf_append(b, "}\n")
    str_buf_append(b, "\n")
    0
}
