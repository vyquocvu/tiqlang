// M13.5-P0 driver: parse, check without dumping, and emit the scalar C11
// backend slice. The final print supplies the generated file's last newline.

import "emit_c.tiq"
import "module.tiq"

path = cli_arg(0)
// M16.3: optional emission mode — "" program, "lib", or "header".
mode <- 0
?[str_eq(cli_arg(1), "lib")] { mode <- 1 }
?[str_eq(cli_arg(1), "header")] { mode <- 2 }
source = mod_flatten(path)
toks = vec_new()
lex_err = lex_scan(source, path, toks)
st = vec_new()
vec_push(st, 0)
vec_push(st, 0)
vec_push(st, 0)
vec_push(st, 0)
first = p_peek(toks, 0)
vec_set(st, PS.Cur, first)
vec_set(st, PS.Prev, first)
vec_set(st, PS.HasErr, lex_err)
nodes = vec_new()
kids = vec_new()
sk = vec_new()
sk2 = vec_new()
tops = vec_new()
parse_err = p_parse(source, path, toks, st, nodes, kids, sk, sk2, tops)
tp = vec_new()
tpn = vec_new()
types = vec_new()
has_err <- semantic_run(source, path, toks, nodes, kids, tops, parse_err, tp, tpn, types)
// M16.3: library modes require definitions-only modules (E31), checked
// before the backend preflight so the diagnostic order matches the C
// bootstrap. Imports mirror the C flattener: they resolve to module
// statements and never trigger E31 themselves.
?[has_err == 0 && mode != 0] {
    lj <- 0
    [lj < vec_len(tops) && has_err == 0] {
        lni = vec_get(tops, lj)
        lk = nd_get(nodes, lni, NF.Kind)
        ?[lk != AstKind.Function && lk != AstKind.StructDef && lk != AstKind.EnumDef && lk != AstKind.Extern && lk != AstKind.Import] {
            eprint(diag_line(path, tk_line(toks, nd_get(nodes, lni, NF.Tok)), 31, "library requires definitions only; top-level statement is not allowed"))
            has_err <- 1
        }
        lj <- lj + 1
    }
}
bad <- 0 - 1
?[has_err == 0] {
    j <- 0
    [j < vec_len(tops) && bad == 0 - 1] {
        bad <- ec_find_unsupported(source, toks, nodes, kids, types, tp, vec_get(tops, j))
        j <- j + 1
    }
    ?[bad != 0 - 1] {
        eprint(diag_line(path, tk_line(toks, nd_get(nodes, bad, NF.Tok)), 7, "self-hosted C emitter does not support this expression yet"))
        has_err <- 1
    }
}
?[has_err == 0] { print(emit_c_program(path, source, toks, nodes, kids, tops, types, tp, tpn, mode)) }
proc_exit(has_err)
