// M13.5-P0: first executable slice of the self-hosted C11 backend.
//
// This deliberately starts with the closed scalar core: literals, names,
// conventional operators, conditionals, calls/print, bindings, assignment,
// bracket loops, control flow, and scalar functions. Later M13.5 packages
// extend this same retained-type interface with aggregates, streams, owned
// strings, the full runtime prelude, modules, and byte-identical formatting.

import "semantic.tiq"
import "emit_c_runtime.tiq"

ec_put b:strbuf s:str : i64 -> str_buf_append(b, s)

ec_indent b:strbuf n:i64 : i64 -> {
    [i <- 0..n] { str_buf_append(b, "    ") }
    0
}

ec_op k:i64 : str -> match k {
    TokenKind.Plus => "+",
    TokenKind.Minus => "-",
    TokenKind.Star => "*",
    TokenKind.Slash => "/",
    TokenKind.Percent => "%",
    TokenKind.EqEq => "==",
    TokenKind.BangEq => "!=",
    TokenKind.Lt => "<",
    TokenKind.Lte => "<=",
    TokenKind.Gt => ">",
    TokenKind.Gte => ">=",
    TokenKind.AndAnd => "&&",
    TokenKind.OrOr => "||",
    TokenKind.Amp => "&",
    TokenKind.Pipe => "|",
    TokenKind.Caret => "^",
    TokenKind.Lshift => "<<",
    TokenKind.Rshift => ">>",
    TokenKind.Bang => "!",
    _ => ""
}

ec_assign_op k:i64 : str -> match k {
    TokenKind.PlusEq => "+=",
    TokenKind.MinusEq => "-=",
    TokenKind.StarEq => "*=",
    TokenKind.SlashEq => "/=",
    TokenKind.PercentEq => "%=",
    _ => "="
}

ec_kind types:vec[int] tp:vec[int] ni:i64 : i64 -> {
    t = vec_get(types, ni)
    t == 0 - 1 ? TY.Unknown : vec_get(tp, t * 8 + TF.Kind)
}

ec_array_len types:vec[int] tp:vec[int] ni:i64 : i64 -> {
    t = vec_get(types, ni)
    t == 0 - 1 ? 0 : vec_get(tp, t * 8 + TF.Len)
}

ec_kind_type k:i64 : str -> match k {
    TY.Float => "double",
    TY.Str => "const char *",
    TY.I8 => "int8_t",
    TY.I16 => "int16_t",
    TY.I32 => "int32_t",
    TY.U8 => "uint8_t",
    TY.U16 => "uint16_t",
    TY.U32 => "uint32_t",
    TY.U64 => "uint64_t",
    TY.F32 => "float",
    _ => "int64_t"
}

ec_annot_type src:str toks:vec[Token] ti:i64 : str -> {
    n = tk_lex(src, toks, ti)
    r <- "int64_t"
    str_eq(n, "f64") ? { r <- "double" }
    str_eq(n, "f32") ? { r <- "float" }
    str_eq(n, "str") ? { r <- "const char *" }
    str_eq(n, "i8") ? { r <- "int8_t" }
    str_eq(n, "i16") ? { r <- "int16_t" }
    str_eq(n, "i32") ? { r <- "int32_t" }
    str_eq(n, "u8") ? { r <- "uint8_t" }
    str_eq(n, "u16") ? { r <- "uint16_t" }
    str_eq(n, "u32") ? { r <- "uint32_t" }
    str_eq(n, "u64") ? { r <- "uint64_t" }
    str_eq(n, "vec") ? { r <- "TiqVec *" }
    str_eq(n, "strbuf") ? { r <- "TiqStrBuf *" }
    str_eq(n, "map") ? { r <- "TiqMap *" }
    r
}

// M16.2: extern "C" names the preamble's system headers already declare
// with a signature Tiq's fixed-width ABI table cannot spell
// (size_t/pid_t/int/void returns). The prototype pass skips them: the
// header declaration serves for codegen and the symbol links normally.
// Mirrors C's ffi_shadows_preamble_header byte-for-byte (selfhost
// byte-compare); keep both tables identical.
ec_ffi_shadow n:str : bool ->
    str_eq(n, "clock") || str_eq(n, "close") || str_eq(n, "exit") || str_eq(n, "fork") ||
    str_eq(n, "getpid") || str_eq(n, "getppid") || str_eq(n, "llabs") || str_eq(n, "memcmp") || str_eq(n, "rand") ||
    str_eq(n, "read") || str_eq(n, "sleep") || str_eq(n, "strcmp") || str_eq(n, "strlen") ||
    str_eq(n, "time") || str_eq(n, "write")

// FFI-safe parameter annotation to its C ABI spelling (M16.2 table).
// Semantic already rejected everything else (E29): the surviving names
// are the scalar keywords and top-level struct typedefs.
ec_ffi_param_type src:str toks:vec[Token] nodes:vec[int] tops:vec[int] ti:i64 : str -> {
    n = tk_lex(src, toks, ti)
    r <- ""
    str_eq(n, "i8") ? { r <- "int8_t" }
    str_eq(n, "i16") ? { r <- "int16_t" }
    str_eq(n, "i32") ? { r <- "int32_t" }
    str_eq(n, "i64") || str_eq(n, "int") || str_eq(n, "bool") ? { r <- "int64_t" }
    str_eq(n, "u8") ? { r <- "uint8_t" }
    str_eq(n, "u16") ? { r <- "uint16_t" }
    str_eq(n, "u32") ? { r <- "uint32_t" }
    str_eq(n, "u64") ? { r <- "uint64_t" }
    str_eq(n, "f32") ? { r <- "float" }
    str_eq(n, "f64") || str_eq(n, "float") ? { r <- "double" }
    str_eq(n, "str") ? { r <- "const char *" }
    // Any other accepted annotation names a top-level struct: emit the
    // typedef itself (passed by value, mirroring C's emit_semantic_type).
    j <- 0
    [j < vec_len(tops) && str_eq(r, "")] {
        ni = vec_get(tops, j)
        // str_cat materializes an owned copy: tk_lex returns a view into
        // src, and reassigning a view into the mutable owner r dangles
        // under self-application.
        nd_get(nodes, ni, NF.Kind) == AstKind.StructDef && str_eq(tk_lex(src, toks, nd_get(nodes, ni, NF.Name)), n) ? { r <- str_cat(n, "") }
        j <- j + 1
    }
    str_eq(r, "") ? { r <- "int64_t" }
    r
}

ec_runtime_builtin n:str : bool ->
    str_eq(n, "fs_read") || str_eq(n, "fs_write") || str_eq(n, "fs_exists") || str_eq(n, "fs_list") ||
    str_eq(n, "proc_exec") || str_eq(n, "proc_exit") || str_eq(n, "json_parse_int") || str_eq(n, "json_encode_str") ||
    str_eq(n, "net_fetch") || str_eq(n, "cli_arg_count") || str_eq(n, "cli_arg") || str_eq(n, "json_get") ||
    str_eq(n, "json_arr_len") || str_eq(n, "json_arr_get") || str_eq(n, "json_view") || str_eq(n, "json_has") ||
    str_eq(n, "json_set") || str_eq(n, "json_del") || str_eq(n, "net_listen") || str_eq(n, "net_accept") ||
    str_eq(n, "net_connect") || str_eq(n, "net_recv") || str_eq(n, "net_send") || str_eq(n, "net_close") ||
    str_eq(n, "net_port") || str_eq(n, "net_shutdown") || str_eq(n, "http_method") || str_eq(n, "http_path") ||
    str_eq(n, "http_header") || str_eq(n, "ev_loop") || str_eq(n, "ev_add") || str_eq(n, "ev_wait") ||
    str_eq(n, "ev_ready") || str_eq(n, "str_cat") || str_eq(n, "int_str") || str_eq(n, "str_sub") ||
    str_eq(n, "str_eq") || str_eq(n, "str_sub_code") || str_eq(n, "eprint") ||
    str_eq(n, "clock_ms") ||
    str_eq(n, "dl_open") || str_eq(n, "dl_sym") || str_eq(n, "dl_error") || str_eq(n, "dl_call")

// Backend preflight. A partial self-hosting package must still fail closed:
// find the first unsupported node before any C bytes are written.
ec_find_unsupported src:str toks:vec[Token] nodes:vec[int] kids:vec[int] types:vec[int] tp:vec[int] ni:i64 : i64 -> {
    found <- 0 - 1
    [(ni != 0 - 1)] {
        k = nd_get(nodes, ni, NF.Kind)
        k == AstKind.Spawn || k == AstKind.Chan ? { found <- ni; break }
        k == AstKind.Function ? { found <- ec_find_unsupported(src, toks, nodes, kids, types, tp, nd_get(nodes, ni, NF.A)); break }
        k == AstKind.Binary ? {
            found <- ec_find_unsupported(src, toks, nodes, kids, types, tp, nd_get(nodes, ni, NF.A))
            found == 0 - 1 ? { found <- ec_find_unsupported(src, toks, nodes, kids, types, tp, nd_get(nodes, ni, NF.B)) }
            break
        }
        k == AstKind.Unary || k == AstKind.Binding || k == AstKind.Defer || k == AstKind.FieldAccess ? {
            found <- ec_find_unsupported(src, toks, nodes, kids, types, tp, nd_get(nodes, ni, NF.A)); break
        }
        k == AstKind.Conditional ? {
            found <- ec_find_unsupported(src, toks, nodes, kids, types, tp, nd_get(nodes, ni, NF.A))
            found == 0 - 1 ? { found <- ec_find_unsupported(src, toks, nodes, kids, types, tp, nd_get(nodes, ni, NF.B)) }
            found == 0 - 1 ? { found <- ec_find_unsupported(src, toks, nodes, kids, types, tp, nd_get(nodes, ni, NF.C)) }
            break
        }
        k == AstKind.Assign || k == AstKind.ArrayFill || k == AstKind.MatchArm ? {
            found <- ec_find_unsupported(src, toks, nodes, kids, types, tp, nd_get(nodes, ni, NF.B))
            found == 0 - 1 ? { found <- ec_find_unsupported(src, toks, nodes, kids, types, tp, nd_get(nodes, ni, NF.A)) }
            break
        }
        k == AstKind.BracketLoop ? {
            found <- ec_find_unsupported(src, toks, nodes, kids, types, tp, nd_get(nodes, ni, NF.A))
            found == 0 - 1 ? {
                s = nd_get(nodes, ni, NF.L1s); n = nd_get(nodes, ni, NF.L1n); j <- 0
                [j < n && found == 0 - 1] { found <- ec_find_unsupported(src, toks, nodes, kids, types, tp, vec_get(kids, s + j)); j <- j + 1 }
            }
            found == 0 - 1 ? { found <- ec_find_unsupported(src, toks, nodes, kids, types, tp, nd_get(nodes, ni, NF.B)) }
            break
        }
        k == AstKind.Call || k == AstKind.Block || k == AstKind.Array || k == AstKind.RecordLit || k == AstKind.Match ? {
            k == AstKind.Call || k == AstKind.Match ? { found <- ec_find_unsupported(src, toks, nodes, kids, types, tp, nd_get(nodes, ni, NF.A)) }
            found == 0 - 1 ? {
                s = nd_get(nodes, ni, NF.L1s); n = nd_get(nodes, ni, NF.L1n); j <- 0
                [j < n && found == 0 - 1] { found <- ec_find_unsupported(src, toks, nodes, kids, types, tp, vec_get(kids, s + j)); j <- j + 1 }
            }
            found == 0 - 1 && k == AstKind.Block ? { found <- ec_find_unsupported(src, toks, nodes, kids, types, tp, nd_get(nodes, ni, NF.A)) }
            found == 0 - 1 && k == AstKind.Block ? {
                s = nd_get(nodes, ni, NF.L2s); n = nd_get(nodes, ni, NF.L2n); j <- 0
                [j < n && found == 0 - 1] { found <- ec_find_unsupported(src, toks, nodes, kids, types, tp, vec_get(kids, s + j)); j <- j + 1 }
            }
            break
        }
        break
    }
    found
}

ec_type tp:vec[int] tpn:vec[str] types:vec[int] ni:i64 : str -> {
    r <- "int64_t"
    t = vec_get(types, ni)
    [(t != 0 - 1)] {
        k = vec_get(tp, t * 8 + TF.Kind)
        k == TY.Float ? { r <- "double" }
        k == TY.Str ? { r <- "const char *" }
        k == TY.Bool ? { r <- "int64_t" }
        k == TY.I8 ? { r <- "int8_t" }
        k == TY.I16 ? { r <- "int16_t" }
        k == TY.I32 ? { r <- "int32_t" }
        k == TY.U8 ? { r <- "uint8_t" }
        k == TY.U16 ? { r <- "uint16_t" }
        k == TY.U32 ? { r <- "uint32_t" }
        k == TY.U64 ? { r <- "uint64_t" }
        k == TY.F32 ? { r <- "float" }
        k == TY.Struct ? { r <- vec_get(tpn, t) }
        k == TY.Slice ? { r <- "TiqSlice" }
        k == TY.StrView ? { r <- "TiqSlice" }
        k == TY.Option ? { r <- "TiqOption" }
        k == TY.Result ? { r <- "TiqResult" }
        k == TY.Vec ? { r <- "TiqVec *" }
        k == TY.Strbuf ? { r <- "TiqStrBuf *" }
        k == TY.Map ? { r <- "TiqMap *" }
        break
    }
    r
}

ec_owned_name n:str : bool ->
    str_eq(n, "fs_read") || str_eq(n, "json_encode_str") || str_eq(n, "json_get") ||
    str_eq(n, "json_arr_get") || str_eq(n, "net_fetch") || str_eq(n, "net_recv") ||
    str_eq(n, "http_method") || str_eq(n, "http_path") || str_eq(n, "json_set") ||
    str_eq(n, "json_del") || str_eq(n, "str_cat") || str_eq(n, "int_str") ||
    str_eq(n, "http_header") || str_eq(n, "str_sub") || str_eq(n, "fs_list") ||
    str_eq(n, "str_buf_to_str")

ec_name_in names:vec[str] name:str : bool -> {
    r <- false
    j <- 0
    [j < vec_len(names) && !r] { r <- str_eq(vec_get(names, j), name); j <- j + 1 }
    r
}

ec_owned_expr src:str toks:vec[Token] nodes:vec[int] fresh:vec[str] ni:i64 : bool -> {
    r <- false
    ni != 0 - 1 ? {
        k = nd_get(nodes, ni, NF.Kind)
        k == AstKind.Call && nd_get(nodes, ni, NF.F1) == 0 ? {
            ci = nd_get(nodes, ni, NF.A)
            ci != 0 - 1 && nd_get(nodes, ci, NF.Kind) == AstKind.Identifier ? {
                cn = tk_lex(src, toks, nd_get(nodes, ci, NF.Name))
                r <- ec_owned_name(cn) || ec_name_in(fresh, cn)
            }
        }
        k == AstKind.Conditional && nd_get(nodes, ni, NF.C) != 0 - 1 ? {
            r <- ec_owned_expr(src, toks, nodes, fresh, nd_get(nodes, ni, NF.B)) && ec_owned_expr(src, toks, nodes, fresh, nd_get(nodes, ni, NF.C))
        }
    }
    r
}

// M9.2-I: classify direct heap-producing str functions before emission. The
// classifier intentionally does not consult `fresh`, so declaration order and
// recursion cannot change the result.
ec_fn_fresh src:str toks:vec[Token] nodes:vec[int] kids:vec[int] types:vec[int] tp:vec[int] ni:i64 : bool -> {
    r <- false
    body = nd_get(nodes, ni, NF.A)
    ret <- body
    body != 0 - 1 && nd_get(nodes, body, NF.Kind) == AstKind.Block ? { ret <- nd_get(nodes, body, NF.C) }
    ret != 0 - 1 && ec_kind(types, tp, ni) == TY.Str ? {
        nd_get(nodes, ret, NF.Kind) == AstKind.Call ? {
            ci = nd_get(nodes, ret, NF.A)
            nd_get(nodes, ret, NF.F1) == 0 && ci != 0 - 1 && nd_get(nodes, ci, NF.Kind) == AstKind.Identifier ? {
                r <- ec_owned_name(tk_lex(src, toks, nd_get(nodes, ci, NF.Name)))
            }
        }
        !r && nd_get(nodes, ret, NF.Kind) == AstKind.Identifier && nd_get(nodes, body, NF.Kind) == AstKind.Block ? {
            want = tk_lex(src, toks, nd_get(nodes, ret, NF.Name))
            s = nd_get(nodes, body, NF.L1s); n = nd_get(nodes, body, NF.L1n); j <- 0
            [j < n && !r] {
                st = vec_get(kids, s + j)
                nd_get(nodes, st, NF.Kind) == AstKind.Binding && nd_get(nodes, st, NF.F1) == 0 && str_eq(tk_lex(src, toks, nd_get(nodes, st, NF.Name)), want) ? {
                    empty = vec_new()
                    r <- ec_owned_expr(src, toks, nodes, empty, nd_get(nodes, st, NF.A))
                }
                nd_get(nodes, st, NF.Kind) == AstKind.Assign && nd_get(nodes, st, NF.F1) == 1 && nd_get(nodes, st, NF.Op) == TokenKind.Eq && nd_get(nodes, st, NF.B) == 0 - 1 && str_eq(tk_lex(src, toks, nd_get(nodes, st, NF.Name)), want) ? {
                    empty = vec_new()
                    r <- ec_owned_expr(src, toks, nodes, empty, nd_get(nodes, st, NF.A))
                }
                j <- j + 1
            }
        }
    }
    r
}

ec_safe_name n:str : bool ->
    ec_runtime_builtin(n) || str_eq(n, "print") || str_eq(n, "len") ||
    str_eq(n, "vec_new") || str_eq(n, "vec_push") || str_eq(n, "vec_get") ||
    str_eq(n, "vec_set") || str_eq(n, "vec_len") || str_eq(n, "vec_pop") ||
    str_eq(n, "str_buf_new") || str_eq(n, "str_buf_append") || str_eq(n, "str_buf_to_str") || str_eq(n, "str_buf_len") ||
    str_eq(n, "map_new") || str_eq(n, "map_set") || str_eq(n, "map_get") || str_eq(n, "map_has") ||
    str_eq(n, "map_len") || str_eq(n, "map_key_at") || str_eq(n, "map_val_at")

ec_mut_ok src:str toks:vec[Token] nodes:vec[int] kids:vec[int] fresh:vec[str] ni:i64 name:str : bool -> {
    r <- true
    ni != 0 - 1 ? {
        k = nd_get(nodes, ni, NF.Kind)
        k == AstKind.Identifier ? { r <- str_eq(tk_lex(src, toks, nd_get(nodes, ni, NF.Name)), name) == false }
        k == AstKind.Binary || k == AstKind.Assign || k == AstKind.ArrayFill || k == AstKind.MatchArm ? {
            k == AstKind.Assign && str_eq(tk_lex(src, toks, nd_get(nodes, ni, NF.Name)), name) ? {
                r <- nd_get(nodes, ni, NF.F1) == 0 && nd_get(nodes, ni, NF.Op) == TokenKind.Larrow && nd_get(nodes, ni, NF.B) == 0 - 1 && ec_owned_expr(src, toks, nodes, fresh, nd_get(nodes, ni, NF.A))
            }
            k != AstKind.Assign || str_eq(tk_lex(src, toks, nd_get(nodes, ni, NF.Name)), name) == false ? {
                r <- ec_mut_ok(src, toks, nodes, kids, fresh, nd_get(nodes, ni, NF.A), name) && ec_mut_ok(src, toks, nodes, kids, fresh, nd_get(nodes, ni, NF.B), name)
            }
        }
        k == AstKind.Unary || k == AstKind.Defer || k == AstKind.FieldAccess || k == AstKind.Spawn ? { r <- ec_mut_ok(src, toks, nodes, kids, fresh, nd_get(nodes, ni, NF.A), name) }
        k == AstKind.Binding ? {
            r <- str_eq(tk_lex(src, toks, nd_get(nodes, ni, NF.Name)), name) == false && ec_mut_ok(src, toks, nodes, kids, fresh, nd_get(nodes, ni, NF.A), name)
        }
        k == AstKind.Conditional ? { r <- ec_mut_ok(src, toks, nodes, kids, fresh, nd_get(nodes, ni, NF.A), name) && ec_mut_ok(src, toks, nodes, kids, fresh, nd_get(nodes, ni, NF.B), name) && ec_mut_ok(src, toks, nodes, kids, fresh, nd_get(nodes, ni, NF.C), name) }
        k == AstKind.Call ? {
            ci = nd_get(nodes, ni, NF.A); safe <- false
            nd_get(nodes, ni, NF.F1) == 0 && ci != 0 - 1 && nd_get(nodes, ci, NF.Kind) == AstKind.Identifier ? { safe <- ec_safe_name(tk_lex(src, toks, nd_get(nodes, ci, NF.Name))) }
            safe == false ? { r <- ec_mut_ok(src, toks, nodes, kids, fresh, ci, name) }
            s = nd_get(nodes, ni, NF.L1s); n = nd_get(nodes, ni, NF.L1n); j <- 0
            [j < n && r] {
                ai = vec_get(kids, s + j)
                direct <- ai != 0 - 1 && nd_get(nodes, ai, NF.Kind) == AstKind.Identifier && str_eq(tk_lex(src, toks, nd_get(nodes, ai, NF.Name)), name)
                safe == false || direct == false ? { r <- ec_mut_ok(src, toks, nodes, kids, fresh, ai, name) }
                j <- j + 1
            }
        }
        k == AstKind.Block || k == AstKind.Array || k == AstKind.RecordLit ? {
            s = nd_get(nodes, ni, NF.L1s); n = nd_get(nodes, ni, NF.L1n); j <- 0
            [j < n && r] { r <- ec_mut_ok(src, toks, nodes, kids, fresh, vec_get(kids, s + j), name); j <- j + 1 }
            r && k == AstKind.Block ? { r <- ec_mut_ok(src, toks, nodes, kids, fresh, nd_get(nodes, ni, NF.C), name) }
            r && k == AstKind.Block ? { ds = nd_get(nodes, ni, NF.L2s); dn = nd_get(nodes, ni, NF.L2n); q <- 0; [q < dn && r] { r <- ec_mut_ok(src, toks, nodes, kids, fresh, vec_get(kids, ds + q), name); q <- q + 1 } }
        }
        k == AstKind.Function ? { r <- ec_mut_ok(src, toks, nodes, kids, fresh, nd_get(nodes, ni, NF.A), name) }
        k == AstKind.BracketLoop ? {
            nd_get(nodes, ni, NF.F1) == 1 && str_eq(tk_lex(src, toks, nd_get(nodes, ni, NF.Name)), name) ? { r <- false }
            nd_get(nodes, ni, NF.F1) == 0 && str_eq(name, "_tiq_i") ? { r <- false }
            r ? { r <- ec_mut_ok(src, toks, nodes, kids, fresh, nd_get(nodes, ni, NF.A), name) }
            s = nd_get(nodes, ni, NF.L1s); n = nd_get(nodes, ni, NF.L1n); j <- 0
            [j < n && r] { r <- ec_mut_ok(src, toks, nodes, kids, fresh, vec_get(kids, s + j), name); j <- j + 1 }
            r ? { r <- ec_mut_ok(src, toks, nodes, kids, fresh, nd_get(nodes, ni, NF.B), name) }
        }
        k == AstKind.StreamGen ? {
            s = nd_get(nodes, ni, NF.L1s); n = nd_get(nodes, ni, NF.L1n); j <- 0
            [j < n && r] { r <- ec_mut_ok(src, toks, nodes, kids, fresh, vec_get(kids, s + j), name); j <- j + 1 }
            r ? { r <- ec_mut_ok(src, toks, nodes, kids, fresh, nd_get(nodes, ni, NF.A), name) }
            r ? { r <- ec_mut_ok(src, toks, nodes, kids, fresh, nd_get(nodes, ni, NF.B), name) }
        }
        k == AstKind.Match ? {
            r <- ec_mut_ok(src, toks, nodes, kids, fresh, nd_get(nodes, ni, NF.A), name)
            s = nd_get(nodes, ni, NF.L1s); n = nd_get(nodes, ni, NF.L1n); j <- 0
            [j < n && r] { r <- ec_mut_ok(src, toks, nodes, kids, fresh, vec_get(kids, s + j), name); j <- j + 1 }
        }
    }
    r
}

ec_mut_qualifies src:str toks:vec[Token] nodes:vec[int] kids:vec[int] fresh:vec[str] scope:vec[int] s:i64 n:i64 at:i64 name:str : bool -> {
    r <- true
    j <- at + 1
    [j < n && r] { r <- ec_mut_ok(src, toks, nodes, kids, fresh, vec_get(scope, s + j), name); j <- j + 1 }
    r
}

ec_mut_active src:str toks:vec[Token] nodes:vec[int] kids:vec[int] fresh:vec[str] ss:vec[int] ns:vec[int] ms:vec[int] name:str : bool -> {
    r <- false
    z <- vec_len(ss)
    [z > 0 && !r] {
        z <- z - 1
        s = vec_get(ss, z); n = vec_get(ns, z); upto = vec_get(ms, z) % 1000000000
        j <- 0
        [j < upto && !r] {
            ni = vec_get(kids, s + j); same <- false; mut_decl <- false
            nd_get(nodes, ni, NF.Kind) == AstKind.Binding ? { same <- str_eq(tk_lex(src, toks, nd_get(nodes, ni, NF.Name)), name); mut_decl <- nd_get(nodes, ni, NF.F1) == 1 }
            nd_get(nodes, ni, NF.Kind) == AstKind.Assign && nd_get(nodes, ni, NF.F1) == 1 ? { same <- str_eq(tk_lex(src, toks, nd_get(nodes, ni, NF.Name)), name); mut_decl <- nd_get(nodes, ni, NF.Op) == TokenKind.Larrow }
            same && mut_decl && ec_owned_expr(src, toks, nodes, fresh, nd_get(nodes, ni, NF.A)) ? { r <- ec_mut_qualifies(src, toks, nodes, kids, fresh, kids, s, n, j, name) }
            j <- j + 1
        }
    }
    r
}

ec_emit_frees src:str toks:vec[Token] nodes:vec[int] kids:vec[int] fresh:vec[str] b:strbuf scope:vec[int] s:i64 n:i64 indent:i64 omit:str : i64 -> {
    j <- n
    [j > 0] {
        j <- j - 1
        ni = vec_get(scope, s + j)
        nd_get(nodes, ni, NF.Kind) == AstKind.Binding && nd_get(nodes, ni, NF.F1) == 0 && ec_owned_expr(src, toks, nodes, fresh, nd_get(nodes, ni, NF.A)) ? {
            nm = tk_lex(src, toks, nd_get(nodes, ni, NF.Name))
            str_eq(nm, omit) == false ? { ec_indent(b, indent); ec_put(b, "free((void *)"); ec_put(b, nm); ec_put(b, ");\n") }
        }
        nd_get(nodes, ni, NF.Kind) == AstKind.Assign && nd_get(nodes, ni, NF.F1) == 1 && nd_get(nodes, ni, NF.Op) == TokenKind.Eq && nd_get(nodes, ni, NF.B) == 0 - 1 && ec_owned_expr(src, toks, nodes, fresh, nd_get(nodes, ni, NF.A)) ? {
            nm = tk_lex(src, toks, nd_get(nodes, ni, NF.Name))
            str_eq(nm, omit) == false ? { ec_indent(b, indent); ec_put(b, "free((void *)"); ec_put(b, nm); ec_put(b, ");\n") }
        }
        mut_owner <- false
        nd_get(nodes, ni, NF.Kind) == AstKind.Binding && nd_get(nodes, ni, NF.F1) == 1 && ec_owned_expr(src, toks, nodes, fresh, nd_get(nodes, ni, NF.A)) ? { mut_owner <- true }
        nd_get(nodes, ni, NF.Kind) == AstKind.Assign && nd_get(nodes, ni, NF.F1) == 1 && nd_get(nodes, ni, NF.Op) == TokenKind.Larrow && nd_get(nodes, ni, NF.B) == 0 - 1 && ec_owned_expr(src, toks, nodes, fresh, nd_get(nodes, ni, NF.A)) ? { mut_owner <- true }
        mut_owner ? {
            nm = tk_lex(src, toks, nd_get(nodes, ni, NF.Name))
            str_eq(nm, omit) == false && ec_mut_qualifies(src, toks, nodes, kids, fresh, scope, s, n, j, nm) ? { ec_indent(b, indent); ec_put(b, "free((void *)"); ec_put(b, nm); ec_put(b, ");\n") }
        }
    }
    0
}

ec_emit_exit_frees src:str toks:vec[Token] nodes:vec[int] kids:vec[int] fresh:vec[str] b:strbuf ss:vec[int] ns:vec[int] ms:vec[int] indent:i64 : i64 -> {
    j <- vec_len(ss)
    stop <- false
    [j > 0 && !stop] {
        j <- j - 1
        mark = vec_get(ms, j)
        ec_emit_frees(src, toks, nodes, kids, fresh, b, kids, vec_get(ss, j), mark % 1000000000, indent, "")
        mark >= 1000000000 ? { stop <- true }
    }
    0
}

ec_emit_all_frees src:str toks:vec[Token] nodes:vec[int] kids:vec[int] fresh:vec[str] b:strbuf ss:vec[int] ms:vec[int] indent:i64 : i64 -> {
    j <- vec_len(ss)
    [j > 0] {
        j <- j - 1
        ec_emit_frees(src, toks, nodes, kids, fresh, b, kids, vec_get(ss, j), vec_get(ms, j) % 1000000000, indent, "")
    }
    0
}

ec_hoist_collect src:str toks:vec[Token] nodes:vec[int] kids:vec[int] fresh:vec[str] hs:vec[int] ni:i64 bound:i64 : i64 -> {
    ni != 0 - 1 ? {
        k = nd_get(nodes, ni, NF.Kind)
        k == AstKind.Conditional && bound == 0 && ec_owned_expr(src, toks, nodes, fresh, ni) ? { vec_push(hs, ni) }
        k == AstKind.Call && nd_get(nodes, ni, NF.F1) == 0 ? {
            ci = nd_get(nodes, ni, NF.A); safe <- false
            ci != 0 - 1 && nd_get(nodes, ci, NF.Kind) == AstKind.Identifier ? {
                cn = tk_lex(src, toks, nd_get(nodes, ci, NF.Name))
                safe <- ec_safe_name(cn) || ec_name_in(fresh, cn)
            }
            safe ? {
                s = nd_get(nodes, ni, NF.L1s); n = nd_get(nodes, ni, NF.L1n); j <- 0
                [j < n] { ec_hoist_collect(src, toks, nodes, kids, fresh, hs, vec_get(kids, s + j), 0); j <- j + 1 }
                bound == 0 && ec_owned_expr(src, toks, nodes, fresh, ni) ? { vec_push(hs, ni) }
            }
        }
    }
    0
}

ec_expr src:str toks:vec[Token] nodes:vec[int] kids:vec[int] hs:vec[int] his:vec[int] hem:vec[int] types:vec[int] tp:vec[int] tpn:vec[str] b:strbuf ni:i64 : i64 -> {
    k = nd_get(nodes, ni, NF.Kind)
    done <- 0
    jh <- 0
    [jh < vec_len(hs) && done == 0] {
        vec_get(hs, jh) == ni && (vec_len(hem) == 0 || vec_get(hem, vec_len(hem) - 1) != ni) ? {
            ec_put(b, "tiq_tmp"); ec_put(b, int_str(vec_get(his, jh))); done <- 1
        }
        jh <- jh + 1
    }
    done == 0 && k == AstKind.Literal ? {
        lk = nd_get(nodes, ni, NF.Op)
        x = tk_lex(src, toks, nd_get(nodes, ni, NF.Tok))
        // The lexer span includes both quotes. Validated Tiq escapes have the
        // same spelling in C11, so this initial slice can preserve it verbatim.
        lk == TokenKind.String ? { ec_put(b, x); done <- 1 }
        done == 0 && lk == TokenKind.Int ? { ec_put(b, x); ec_put(b, "LL"); done <- 1 }
        done == 0 && lk == TokenKind.True ? { ec_put(b, "1"); done <- 1 }
        done == 0 && lk == TokenKind.False ? { ec_put(b, "0"); done <- 1 }
        done == 0 && lk == TokenKind.None ? { ec_put(b, "((TiqOption){ .value = 0, .has_value = 0 })"); done <- 1 }
        done == 0 ? { ec_put(b, x) }
        done <- 1
    }
    done == 0 && k == AstKind.Identifier ? {
        nm = tk_lex(src, toks, nd_get(nodes, ni, NF.Name))
        ec_put(b, nm)
        done <- 1
    }
    done == 0 && k == AstKind.Binary ? {
        op = nd_get(nodes, ni, NF.Op)
        op == TokenKind.QuestionQuestion ? {
            li = nd_get(nodes, ni, NF.A); lk = ec_kind(types, tp, li)
            ec_put(b, "("); ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, li)
            ec_put(b, lk == TY.Result ? ".is_ok ? " : ".has_value ? ")
            ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, li); ec_put(b, ".value : ")
            ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, nd_get(nodes, ni, NF.B)); ec_put(b, ")")
        }
        op != TokenKind.QuestionQuestion ? {
            ec_put(b, "(")
            ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, nd_get(nodes, ni, NF.A))
            ec_put(b, " "); ec_put(b, ec_op(op)); ec_put(b, " ")
            ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, nd_get(nodes, ni, NF.B))
            ec_put(b, ")")
        }
        done <- 1
    }
    done == 0 && k == AstKind.Unary ? {
        op = nd_get(nodes, ni, NF.Op)
        op == TokenKind.Question ? { ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, nd_get(nodes, ni, NF.A)); ec_put(b, ".value") }
        op != TokenKind.Question ? {
            op != TokenKind.Move ? { ec_put(b, ec_op(op)); ec_put(b, "(") }
            ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, nd_get(nodes, ni, NF.A))
            op != TokenKind.Move ? { ec_put(b, ")") }
        }
        done <- 1
    }
    done == 0 && k == AstKind.Conditional ? {
        ec_put(b, "(")
        ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, nd_get(nodes, ni, NF.A))
        ec_put(b, " ? ")
        ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, nd_get(nodes, ni, NF.B))
        ec_put(b, " : ")
        ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, nd_get(nodes, ni, NF.C))
        ec_put(b, ")")
        done <- 1
    }
    done == 0 && k == AstKind.Call ? {
        callee = nd_get(nodes, ni, NF.A)
        cname <- ""
        nd_get(nodes, callee, NF.Kind) == AstKind.Identifier ? { cname <- tk_lex(src, toks, nd_get(nodes, callee, NF.Name)) }
        s = nd_get(nodes, ni, NF.L1s); n = nd_get(nodes, ni, NF.L1n)
        is_bracket = nd_get(nodes, ni, NF.F1)
        is_slice = nd_get(nodes, ni, NF.F2)
        is_bracket == 1 && is_slice == 0 && ec_kind(types, tp, callee) == TY.Stream ? {
            nd_get(nodes, callee, NF.Kind) == AstKind.Call ? {
                inner = nd_get(nodes, callee, NF.A)
                ec_put(b, "tiq_gen_"); ec_put(b, tk_lex(src, toks, nd_get(nodes, inner, NF.Name))); ec_put(b, "(")
                ps = nd_get(nodes, callee, NF.L1s); pc = nd_get(nodes, callee, NF.L1n); q <- 0
                [q < pc] { q > 0 ? { ec_put(b, ", ") }; ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, vec_get(kids, ps + q)); q <- q + 1 }
                pc > 0 ? { ec_put(b, ", ") }
            }
            nd_get(nodes, callee, NF.Kind) != AstKind.Call ? { ec_put(b, "tiq_gen_"); ec_put(b, cname); ec_put(b, "(") }
            ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, vec_get(kids, s)); ec_put(b, ")"); done <- 1
        }
        is_bracket == 0 && str_eq(cname, "some") && n == 1 ? {
            ec_put(b, "((TiqOption){ .value = (int64_t)("); ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, vec_get(kids, s)); ec_put(b, "), .has_value = 1 })"); done <- 1
        }
        done == 0 && is_bracket == 0 && str_eq(cname, "ok") && n == 1 ? {
            ec_put(b, "((TiqResult){ .value = (int64_t)("); ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, vec_get(kids, s)); ec_put(b, "), .error = 0, .is_ok = 1 })"); done <- 1
        }
        done == 0 && is_bracket == 0 && str_eq(cname, "err") && n == 1 ? {
            ec_put(b, "((TiqResult){ .value = 0, .error = (int64_t)("); ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, vec_get(kids, s)); ec_put(b, "), .is_ok = 0 })"); done <- 1
        }
        done == 0 && is_bracket == 0 && str_eq(cname, "vec_new") ? { ec_put(b, "tiq_vec_new() "); done <- 1 }
        done == 0 && is_bracket == 0 && str_eq(cname, "vec_len") ? {
            ec_put(b, "tiq_vec_len("); ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, vec_get(kids, s)); ec_put(b, ")"); done <- 1
        }
        done == 0 && is_bracket == 0 && (str_eq(cname, "vec_push") || str_eq(cname, "vec_set")) ? {
            vi = vec_get(kids, s); xi = vec_get(kids, s + n - 1); xk = ec_kind(types, tp, xi)
            xk == TY.Struct ? {
                ec_put(b, "(*("); ec_put(b, ec_type(tp, tpn, types, xi)); ec_put(b, "*)")
                ec_put(b, str_eq(cname, "vec_push") ? "tiq_vec_push_slot(" : "tiq_vec_slot(")
                ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, vi); ec_put(b, ", ")
                str_eq(cname, "vec_push") ? { ec_put(b, "sizeof("); ec_put(b, ec_type(tp, tpn, types, xi)); ec_put(b, ")") }
                str_eq(cname, "vec_set") ? { ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, vec_get(kids, s + 1)) }
                ec_put(b, ") = "); ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, xi); ec_put(b, ", tiq_vec_len("); ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, vi); ec_put(b, "))")
            }
            xk != TY.Struct ? {
                ec_put(b, str_eq(cname, "vec_push") ? "tiq_vec_push_" : "tiq_vec_set_")
                ec_put(b, xk == TY.Str ? "str(" : "i64(")
                ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, vi); ec_put(b, ", ")
                str_eq(cname, "vec_set") ? { ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, vec_get(kids, s + 1)); ec_put(b, ", ") }
                ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, xi); ec_put(b, ")")
            }
            done <- 1
        }
        done == 0 && is_bracket == 0 && (str_eq(cname, "vec_get") || str_eq(cname, "vec_pop")) ? {
            vi = vec_get(kids, s); rk = ec_kind(types, tp, ni)
            ec_put(b, "(*(")
            rk == TY.Str ? { ec_put(b, "const char **") }
            rk == TY.Struct ? { ec_put(b, ec_type(tp, tpn, types, ni)); ec_put(b, " *") }
            rk != TY.Str && rk != TY.Struct ? { ec_put(b, "int64_t *") }
            ec_put(b, ")")
            ec_put(b, str_eq(cname, "vec_get") ? "tiq_vec_slot(" : "tiq_vec_pop(")
            ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, vi)
            str_eq(cname, "vec_get") ? { ec_put(b, ", "); ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, vec_get(kids, s + 1)) }
            ec_put(b, "))"); done <- 1
        }
        done == 0 && is_bracket == 0 && str_eq(cname, "str_buf_new") ? { ec_put(b, "tiq_str_buf_new()"); done <- 1 }
        done == 0 && is_bracket == 0 && (str_eq(cname, "str_buf_append") || str_eq(cname, "str_buf_len") || str_eq(cname, "str_buf_to_str")) ? {
            ec_put(b, "tiq_"); ec_put(b, cname); ec_put(b, "("); j <- 0
            [j < n] { j > 0 ? { ec_put(b, ", ") }; ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, vec_get(kids, s + j)); j <- j + 1 }
            ec_put(b, ")"); done <- 1
        }
        done == 0 && is_bracket == 0 && str_eq(cname, "map_new") ? { ec_put(b, "tiq_map_new()"); done <- 1 }
        done == 0 && is_bracket == 0 && (str_eq(cname, "map_set") || str_eq(cname, "map_get") || str_eq(cname, "map_has") || str_eq(cname, "map_len") || str_eq(cname, "map_key_at") || str_eq(cname, "map_val_at")) ? {
            ec_put(b, "tiq_"); ec_put(b, cname); ec_put(b, "("); j <- 0
            [j < n] { j > 0 ? { ec_put(b, ", ") }; ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, vec_get(kids, s + j)); j <- j + 1 }
            ec_put(b, ")"); done <- 1
        }
        done == 0 && is_bracket == 0 && (str_eq(cname, "str_cat") || str_eq(cname, "str_sub") || str_eq(cname, "str_sub_code") || str_eq(cname, "str_eq") || str_eq(cname, "int_str") || str_eq(cname, "eprint") || str_eq(cname, "fs_read") || str_eq(cname, "fs_write") || str_eq(cname, "fs_exists") || str_eq(cname, "cli_arg") || str_eq(cname, "cli_arg_count") || str_eq(cname, "proc_exit")) ? {
            ec_put(b, "tiq_"); ec_put(b, cname); ec_put(b, "("); j <- 0
            [j < n] { j > 0 ? { ec_put(b, ", ") }; ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, vec_get(kids, s + j)); j <- j + 1 }
            ec_put(b, ")"); done <- 1
        }
        done == 0 && is_bracket == 0 && ec_runtime_builtin(cname) ? {
            ec_put(b, "tiq_"); ec_put(b, cname); ec_put(b, "("); j <- 0
            [j < n] { j > 0 ? { ec_put(b, ", ") }; ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, vec_get(kids, s + j)); j <- j + 1 }
            ec_put(b, ")"); done <- 1
        }
        done == 0 && is_bracket == 0 && n == 1 && (str_eq(cname, "i8") || str_eq(cname, "i16") || str_eq(cname, "i32") || str_eq(cname, "i64") || str_eq(cname, "u8") || str_eq(cname, "u16") || str_eq(cname, "u32") || str_eq(cname, "u64") || str_eq(cname, "f32") || str_eq(cname, "f64") || str_eq(cname, "bool") || str_eq(cname, "str")) ? {
