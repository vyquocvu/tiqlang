// M13.5-P0: first executable slice of the self-hosted C11 backend.
//
// This deliberately starts with the closed scalar core: literals, names,
// conventional operators, conditionals, calls/print, bindings, assignment,
// bracket loops, control flow, and scalar functions. Later M13.5 packages
// extend this same retained-type interface with aggregates, streams, owned
// strings, the full runtime prelude, modules, and byte-identical formatting.

import "semantic.tiq"

ec_put b:strbuf s:str -> i64 -> str_buf_append(b, s)

ec_indent b:strbuf n:i64 -> i64 -> {
    [i <- 0..n] { str_buf_append(b, "    ") }
    0
}

ec_op k:i64 -> str -> match k {
    TokenKind.Plus => "+",
    TokenKind.Minus => "-",
    TokenKind.Star => "*",
    TokenKind.Slash => "/",
    TokenKind.Percent => "%",
    TokenKind.EqEq => "==",
    TokenKind.BangEq => "!=",
    TokenKind.Lt => "<",
    TokenKind.Lte => "<=",
    TokenKind.Gt => ">",
    TokenKind.Gte => ">=",
    TokenKind.AndAnd => "&&",
    TokenKind.OrOr => "||",
    TokenKind.Amp => "&",
    TokenKind.Pipe => "|",
    TokenKind.Caret => "^",
    TokenKind.Lshift => "<<",
    TokenKind.Rshift => ">>",
    TokenKind.Bang => "!",
    _ => ""
}

ec_assign_op k:i64 -> str -> match k {
    TokenKind.PlusEq => "+=",
    TokenKind.MinusEq => "-=",
    TokenKind.StarEq => "*=",
    TokenKind.SlashEq => "/=",
    TokenKind.PercentEq => "%=",
    _ => "="
}

ec_kind types:vec[int] tp:vec[int] ni:i64 -> i64 -> {
    t = vec_get(types, ni)
    t == 0 - 1 ? TY.Unknown : vec_get(tp, t * 8 + TF.Kind)
}

ec_array_len types:vec[int] tp:vec[int] ni:i64 -> i64 -> {
    t = vec_get(types, ni)
    t == 0 - 1 ? 0 : vec_get(tp, t * 8 + TF.Len)
}

ec_kind_type k:i64 -> str -> match k {
    TY.Float => "double",
    TY.Str => "const char *",
    TY.I8 => "int8_t",
    TY.I16 => "int16_t",
    TY.I32 => "int32_t",
    TY.U8 => "uint8_t",
    TY.U16 => "uint16_t",
    TY.U32 => "uint32_t",
    TY.U64 => "uint64_t",
    TY.F32 => "float",
    _ => "int64_t"
}

// Backend preflight. A partial self-hosting package must still fail closed:
// find the first unsupported node before any C bytes are written. Slices on
// arrays/slices are now supported (P2); string-view slices remain unsupported.
ec_find_slice nodes:vec[int] kids:vec[int] types:vec[int] tp:vec[int] ni:i64 -> i64 -> {
    found <- 0 - 1
    [(ni != 0 - 1)] {
        k = nd_get(nodes, ni, NF.Kind)
        ?[k == AstKind.Call && nd_get(nodes, ni, NF.F2) == 1] {
            nk = ec_kind(types, tp, ni)
            ?[nk == TY.StrView] { found <- ni }
            break
        }
        ?[k == AstKind.Binary] {
            found <- ec_find_slice(nodes, kids, types, tp, nd_get(nodes, ni, NF.A))
            ?[found == 0 - 1] { found <- ec_find_slice(nodes, kids, types, tp, nd_get(nodes, ni, NF.B)) }
            break
        }
        ?[k == AstKind.Unary || k == AstKind.Binding || k == AstKind.Function || k == AstKind.Defer || k == AstKind.FieldAccess || k == AstKind.Spawn] {
            found <- ec_find_slice(nodes, kids, types, tp, nd_get(nodes, ni, NF.A)); break
        }
        ?[k == AstKind.Conditional] {
            found <- ec_find_slice(nodes, kids, types, tp, nd_get(nodes, ni, NF.A))
            ?[found == 0 - 1] { found <- ec_find_slice(nodes, kids, types, tp, nd_get(nodes, ni, NF.B)) }
            ?[found == 0 - 1] { found <- ec_find_slice(nodes, kids, types, tp, nd_get(nodes, ni, NF.C)) }
            break
        }
        ?[k == AstKind.Assign || k == AstKind.ArrayFill || k == AstKind.MatchArm] {
            found <- ec_find_slice(nodes, kids, types, tp, nd_get(nodes, ni, NF.B))
            ?[found == 0 - 1] { found <- ec_find_slice(nodes, kids, types, tp, nd_get(nodes, ni, NF.A)) }
            break
        }
        ?[k == AstKind.BracketLoop] {
            found <- ec_find_slice(nodes, kids, types, tp, nd_get(nodes, ni, NF.A))
            ?[found == 0 - 1] {
                s = nd_get(nodes, ni, NF.L1s); n = nd_get(nodes, ni, NF.L1n); j <- 0
                [j < n && found == 0 - 1] { found <- ec_find_slice(nodes, kids, types, tp, vec_get(kids, s + j)); j <- j + 1 }
            }
            ?[found == 0 - 1] { found <- ec_find_slice(nodes, kids, types, tp, nd_get(nodes, ni, NF.B)) }
            break
        }
        ?[k == AstKind.Call || k == AstKind.Block || k == AstKind.Array || k == AstKind.RecordLit || k == AstKind.Match] {
            ?[k == AstKind.Call || k == AstKind.Match] { found <- ec_find_slice(nodes, kids, types, tp, nd_get(nodes, ni, NF.A)) }
            ?[found == 0 - 1] {
                s = nd_get(nodes, ni, NF.L1s); n = nd_get(nodes, ni, NF.L1n); j <- 0
                [j < n && found == 0 - 1] { found <- ec_find_slice(nodes, kids, types, tp, vec_get(kids, s + j)); j <- j + 1 }
            }
            ?[found == 0 - 1 && k == AstKind.Block] { found <- ec_find_slice(nodes, kids, types, tp, nd_get(nodes, ni, NF.A)) }
            ?[found == 0 - 1 && k == AstKind.Block] {
                s = nd_get(nodes, ni, NF.L2s); n = nd_get(nodes, ni, NF.L2n); j <- 0
                [j < n && found == 0 - 1] { found <- ec_find_slice(nodes, kids, types, tp, vec_get(kids, s + j)); j <- j + 1 }
            }
            break
        }
        break
    }
    found
}

ec_type tp:vec[int] tpn:vec[str] types:vec[int] ni:i64 -> str -> {
    r <- "int64_t"
    t = vec_get(types, ni)
    [(t != 0 - 1)] {
        k = vec_get(tp, t * 8 + TF.Kind)
        ?[k == TY.Float] { r <- "double" }
        ?[k == TY.Str] { r <- "const char *" }
        ?[k == TY.Bool] { r <- "int64_t" }
        ?[k == TY.I8] { r <- "int8_t" }
        ?[k == TY.I16] { r <- "int16_t" }
        ?[k == TY.I32] { r <- "int32_t" }
        ?[k == TY.U8] { r <- "uint8_t" }
        ?[k == TY.U16] { r <- "uint16_t" }
        ?[k == TY.U32] { r <- "uint32_t" }
        ?[k == TY.U64] { r <- "uint64_t" }
        ?[k == TY.F32] { r <- "float" }
        ?[k == TY.Struct] { r <- vec_get(tpn, t) }
        ?[k == TY.Slice] { r <- "TiqSlice" }
        break
    }
    r
}

ec_expr src:str toks:vec[Token] nodes:vec[int] kids:vec[int] types:vec[int] tp:vec[int] tpn:vec[str] b:strbuf ni:i64 -> i64 -> {
    k = nd_get(nodes, ni, NF.Kind)
    done <- 0
    ?[k == AstKind.Literal] {
        lk = nd_get(nodes, ni, NF.Op)
        x = tk_lex(src, toks, nd_get(nodes, ni, NF.Tok))
        // The lexer span includes both quotes. Validated Tiq escapes have the
        // same spelling in C11, so this initial slice can preserve it verbatim.
        ?[lk == TokenKind.String] { ec_put(b, x); done <- 1 }
        ?[done == 0 && lk == TokenKind.Int] { ec_put(b, x); ec_put(b, "LL"); done <- 1 }
        ?[done == 0 && lk == TokenKind.True] { ec_put(b, "1"); done <- 1 }
        ?[done == 0 && lk == TokenKind.False] { ec_put(b, "0"); done <- 1 }
        ?[done == 0] { ec_put(b, x) }
        done <- 1
    }
    ?[done == 0 && k == AstKind.Identifier] {
        ec_put(b, tk_lex(src, toks, nd_get(nodes, ni, NF.Name)))
        done <- 1
    }
    ?[done == 0 && k == AstKind.Binary] {
        ec_put(b, "(")
        ec_expr(src, toks, nodes, kids, types, tp, tpn, b, nd_get(nodes, ni, NF.A))
        ec_put(b, " "); ec_put(b, ec_op(nd_get(nodes, ni, NF.Op))); ec_put(b, " ")
        ec_expr(src, toks, nodes, kids, types, tp, tpn, b, nd_get(nodes, ni, NF.B))
        ec_put(b, ")")
        done <- 1
    }
    ?[done == 0 && k == AstKind.Unary] {
        op = nd_get(nodes, ni, NF.Op)
        ?[op != TokenKind.Move] { ec_put(b, ec_op(op)); ec_put(b, "(") }
        ec_expr(src, toks, nodes, kids, types, tp, tpn, b, nd_get(nodes, ni, NF.A))
        ?[op != TokenKind.Move] { ec_put(b, ")") }
        done <- 1
    }
    ?[done == 0 && k == AstKind.Conditional] {
        ec_put(b, "(")
        ec_expr(src, toks, nodes, kids, types, tp, tpn, b, nd_get(nodes, ni, NF.A))
        ec_put(b, " ? ")
        ec_expr(src, toks, nodes, kids, types, tp, tpn, b, nd_get(nodes, ni, NF.B))
        ec_put(b, " : ")
        ec_expr(src, toks, nodes, kids, types, tp, tpn, b, nd_get(nodes, ni, NF.C))
        ec_put(b, ")")
        done <- 1
    }
    ?[done == 0 && k == AstKind.Call] {
        callee = nd_get(nodes, ni, NF.A)
        cname <- ""
        ?[nd_get(nodes, callee, NF.Kind) == AstKind.Identifier] { cname <- tk_lex(src, toks, nd_get(nodes, callee, NF.Name)) }
        s = nd_get(nodes, ni, NF.L1s); n = nd_get(nodes, ni, NF.L1n)
        is_bracket = nd_get(nodes, ni, NF.F1)
        is_slice = nd_get(nodes, ni, NF.F2)
        ?[is_bracket == 1 && is_slice == 0 && ec_kind(types, tp, callee) == TY.Array] {
            idx = vec_get(kids, s)
            alen = ec_array_len(types, tp, callee)
            ec_put(b, "((uint64_t)(")
            ec_expr(src, toks, nodes, kids, types, tp, tpn, b, idx)
            ec_put(b, ") < (uint64_t)("); ec_put(b, int_str(alen)); ec_put(b, ") ? ")
            ec_expr(src, toks, nodes, kids, types, tp, tpn, b, callee)
            ec_put(b, "["); ec_expr(src, toks, nodes, kids, types, tp, tpn, b, idx); ec_put(b, "] : (fprintf(stderr, \"tiq: index %lld out of bounds for array of length ")
            ec_put(b, int_str(alen)); ec_put(b, "\\n\", (long long)(")
            ec_expr(src, toks, nodes, kids, types, tp, tpn, b, idx)
            ec_put(b, ")), exit(1), ")
            ec_expr(src, toks, nodes, kids, types, tp, tpn, b, callee)
            ec_put(b, "["); ec_expr(src, toks, nodes, kids, types, tp, tpn, b, idx); ec_put(b, "]))")
            done <- 1
        }
        // Slice creation: xs[a..b], xs[a..], xs[..b]
        ?[done == 0 && is_bracket == 1 && is_slice == 1] {
            ck = ec_kind(types, tp, callee)
            arg0 = vec_get(kids, s)
            arg1 = n > 1 ? vec_get(kids, s + 1) : 0 - 1
            ?[ck == TY.Array] {
                alen = ec_array_len(types, tp, callee)
                ec_put(b, "((TiqSlice){ .ptr = (const char*)(")
                ec_expr(src, toks, nodes, kids, types, tp, tpn, b, callee)
                ec_put(b, ") + (")
                ?[arg0 != 0 - 1] { ec_expr(src, toks, nodes, kids, types, tp, tpn, b, arg0) }
                ?[arg0 == 0 - 1] { ec_put(b, "0") }
                ec_put(b, ") * sizeof(int64_t), .len = (")
                ?[arg1 != 0 - 1] { ec_expr(src, toks, nodes, kids, types, tp, tpn, b, arg1) }
                ?[arg1 == 0 - 1] { ec_put(b, int_str(alen)) }
                ec_put(b, ") - (")
                ?[arg0 != 0 - 1] { ec_expr(src, toks, nodes, kids, types, tp, tpn, b, arg0) }
                ?[arg0 == 0 - 1] { ec_put(b, "0") }
                ec_put(b, ") })")
                done <- 1
            }
            ?[done == 0 && ck == TY.Slice] {
                ec_put(b, "((TiqSlice){ .ptr = ((const char*)(")
                ec_expr(src, toks, nodes, kids, types, tp, tpn, b, callee)
                ec_put(b, ".ptr)) + (")
                ?[arg0 != 0 - 1] { ec_expr(src, toks, nodes, kids, types, tp, tpn, b, arg0) }
                ?[arg0 == 0 - 1] { ec_put(b, "0") }
                ec_put(b, ") * sizeof(int64_t), .len = (")
                ?[arg1 != 0 - 1] { ec_expr(src, toks, nodes, kids, types, tp, tpn, b, arg1) }
                ?[arg1 == 0 - 1] { ec_put(b, "("); ec_expr(src, toks, nodes, kids, types, tp, tpn, b, callee); ec_put(b, ".len)") }
                ec_put(b, ") - (")
                ?[arg0 != 0 - 1] { ec_expr(src, toks, nodes, kids, types, tp, tpn, b, arg0) }
                ?[arg0 == 0 - 1] { ec_put(b, "0") }
                ec_put(b, ") })")
                done <- 1
            }
        }
        // Slice indexed read: s[i]
        ?[done == 0 && is_bracket == 1 && is_slice == 0 && ec_kind(types, tp, callee) == TY.Slice] {
            idx = vec_get(kids, s)
            ec_put(b, "((uint64_t)(")
            ec_expr(src, toks, nodes, kids, types, tp, tpn, b, idx)
            ec_put(b, ") < (uint64_t)(")
            ec_expr(src, toks, nodes, kids, types, tp, tpn, b, callee)
            ec_put(b, ".len) ? ((const int64_t*)(")
            ec_expr(src, toks, nodes, kids, types, tp, tpn, b, callee)
            ec_put(b, ".ptr))[")
            ec_expr(src, toks, nodes, kids, types, tp, tpn, b, idx)
            ec_put(b, "] : (fprintf(stderr, \"tiq: index %lld out of bounds for slice of length %lld\\n\", (long long)(")
            ec_expr(src, toks, nodes, kids, types, tp, tpn, b, idx)
            ec_put(b, "), (long long)(")
            ec_expr(src, toks, nodes, kids, types, tp, tpn, b, callee)
            ec_put(b, ".len)), exit(1), (int64_t)0))")
            done <- 1
        }
        ?[done == 0 && is_bracket == 0 && str_eq(cname, "len") && n == 1] {
            ai = vec_get(kids, s)
            aik = ec_kind(types, tp, ai)
            ?[aik == TY.Array] { ec_put(b, int_str(ec_array_len(types, tp, ai))); done <- 1 }
            ?[done == 0 && aik == TY.Slice] { ec_put(b, "("); ec_expr(src, toks, nodes, kids, types, tp, tpn, b, ai); ec_put(b, ".len)"); done <- 1 }
        }
        is_print = str_eq(cname, "print")
        ?[done == 0 && is_print] {
            ai = vec_get(kids, s)
            at = vec_get(types, ai)
            ak = at == 0 - 1 ? TY.Int : vec_get(tp, at * 8 + TF.Kind)
            ?[ak == TY.Str] { ec_put(b, "printf(\"%s\\n\", ") }
            ?[ak == TY.Float || ak == TY.F32] { ec_put(b, "printf(\"%g\\n\", (double)(") }
            ?[ak == TY.Bool] { ec_put(b, "printf(\"%s\\n\", (") }
            ?[ak == TY.Slice || ak == TY.StrView] { ec_put(b, "printf(\"%.*s\\n\", (") }
            ?[ak != TY.Str && ak != TY.Float && ak != TY.F32 && ak != TY.Bool && ak != TY.Slice && ak != TY.StrView] { ec_put(b, "printf(\"%lld\\n\", (long long)(") }
            ec_expr(src, toks, nodes, kids, types, tp, tpn, b, ai)
            ?[ak == TY.Bool] { ec_put(b, ") ? \"true\" : \"false\"") }
            ?[ak == TY.Slice || ak == TY.StrView] { ec_put(b, ").len, (const char*)("); ec_expr(src, toks, nodes, kids, types, tp, tpn, b, ai); ec_put(b, ").ptr)") }
            ?[ak != TY.Str && ak != TY.Bool && ak != TY.Slice && ak != TY.StrView] { ec_put(b, ")") }
            ec_put(b, ")")
            done <- 1
        }
        ?[done == 0] {
            ec_expr(src, toks, nodes, kids, types, tp, tpn, b, callee)
            ec_put(b, "(")
            j <- 0
            [j < n] {
                ?[j > 0] { ec_put(b, ", ") }
                ec_expr(src, toks, nodes, kids, types, tp, tpn, b, vec_get(kids, s + j))
                j <- j + 1
            }
            ec_put(b, ")")
        }
        done <- 1
    }
    ?[done == 0 && k == AstKind.Array] {
        ec_put(b, "{")
        s = nd_get(nodes, ni, NF.L1s); n = nd_get(nodes, ni, NF.L1n)
        j <- 0
        [j < n] {
            ?[j > 0] { ec_put(b, ", ") }
            ec_expr(src, toks, nodes, kids, types, tp, tpn, b, vec_get(kids, s + j))
            j <- j + 1
        }
        ec_put(b, "}")
        done <- 1
    }
    ?[done == 0 && k == AstKind.ArrayFill] {
        ec_put(b, "{")
        n = ec_array_len(types, tp, ni)
        j <- 0
        [j < n] {
            ?[j > 0] { ec_put(b, ", ") }
            ec_expr(src, toks, nodes, kids, types, tp, tpn, b, nd_get(nodes, ni, NF.A))
            j <- j + 1
        }
        ec_put(b, "}")
        done <- 1
    }
    ?[done == 0] { ec_put(b, "0") }
    0
}

ec_stmt src:str toks:vec[Token] nodes:vec[int] kids:vec[int] types:vec[int] tp:vec[int] tpn:vec[str] b:strbuf ni:i64 indent:i64 -> i64 -> {
    k = nd_get(nodes, ni, NF.Kind)
    ec_indent(b, indent)
    done <- 0
    ?[k == AstKind.Binding] {
        nk = ec_kind(types, tp, ni)
        ?[nk == TY.Array] {
            t = vec_get(types, ni); et = vec_get(tp, t * 8 + TF.Elem)
            ek = et == 0 - 1 ? TY.Int : vec_get(tp, et * 8 + TF.Kind)
            ec_put(b, ec_kind_type(ek)); ec_put(b, " ")
            ec_put(b, tk_lex(src, toks, nd_get(nodes, ni, NF.Name))); ec_put(b, "[")
            ec_put(b, int_str(vec_get(tp, t * 8 + TF.Len))); ec_put(b, "] = ")
        }
        ?[nk != TY.Array] {
            ec_put(b, ec_type(tp, tpn, types, ni)); ec_put(b, " ")
            ec_put(b, tk_lex(src, toks, nd_get(nodes, ni, NF.Name))); ec_put(b, " = ")
        }
        ec_expr(src, toks, nodes, kids, types, tp, tpn, b, nd_get(nodes, ni, NF.A))
        ec_put(b, ";\n"); done <- 1
    }
    ?[done == 0 && k == AstKind.Assign] {
        is_def = nd_get(nodes, ni, NF.F1)
        idx = nd_get(nodes, ni, NF.B)
        ?[idx != 0 - 1] {
            nk = ec_kind(types, tp, ni)
            ?[nk == TY.Slice] {
                ec_put(b, "if ((uint64_t)(")
                ec_expr(src, toks, nodes, kids, types, tp, tpn, b, idx)
                ec_put(b, ") >= (uint64_t)(")
                ec_put(b, tk_lex(src, toks, nd_get(nodes, ni, NF.Name)))
                ec_put(b, ".len)) { fprintf(stderr, \"tiq: index out of bounds for slice of length %lld\\n\", (long long)(")
                ec_put(b, tk_lex(src, toks, nd_get(nodes, ni, NF.Name)))
                ec_put(b, ".len)); exit(1); }\n")
                ec_indent(b, indent)
                ec_put(b, "((int64_t*)(")
                ec_put(b, tk_lex(src, toks, nd_get(nodes, ni, NF.Name)))
                ec_put(b, ".ptr))[")
                ec_expr(src, toks, nodes, kids, types, tp, tpn, b, idx)
                ec_put(b, "] ")
                ec_put(b, ec_assign_op(nd_get(nodes, ni, NF.Op))); ec_put(b, " ")
                ec_expr(src, toks, nodes, kids, types, tp, tpn, b, nd_get(nodes, ni, NF.A))
                ec_put(b, ";\n"); done <- 1
            }
            ?[done == 0] {
                alen = ec_array_len(types, tp, ni)
                ec_put(b, "if ((uint64_t)(")
                ec_expr(src, toks, nodes, kids, types, tp, tpn, b, idx)
                ec_put(b, ") >= (uint64_t)("); ec_put(b, int_str(alen)); ec_put(b, ")) { fprintf(stderr, \"tiq: index out of bounds for array of length ")
                ec_put(b, int_str(alen)); ec_put(b, "\\n\"); exit(1); }\n")
                ec_indent(b, indent)
                ec_put(b, tk_lex(src, toks, nd_get(nodes, ni, NF.Name)))
                ec_put(b, "["); ec_expr(src, toks, nodes, kids, types, tp, tpn, b, idx); ec_put(b, "] ")
                ec_put(b, ec_assign_op(nd_get(nodes, ni, NF.Op))); ec_put(b, " ")
                ec_expr(src, toks, nodes, kids, types, tp, tpn, b, nd_get(nodes, ni, NF.A))
                ec_put(b, ";\n"); done <- 1
            }
        }
        ?[done == 0] {
            ?[is_def == 1] { ec_put(b, ec_type(tp, tpn, types, ni)); ec_put(b, " ") }
            ec_put(b, tk_lex(src, toks, nd_get(nodes, ni, NF.Name))); ec_put(b, " ")
            ec_put(b, is_def == 1 ? "=" : ec_assign_op(nd_get(nodes, ni, NF.Op))); ec_put(b, " ")
            ec_expr(src, toks, nodes, kids, types, tp, tpn, b, nd_get(nodes, ni, NF.A))
            ec_put(b, ";\n"); done <- 1
        }
    }
    ?[done == 0 && k == AstKind.Break] { ec_put(b, "break;\n"); done <- 1 }
    ?[done == 0 && k == AstKind.Skip] { ec_put(b, "continue;\n"); done <- 1 }
    ?[done == 0 && k == AstKind.BracketLoop] {
        dom = nd_get(nodes, ni, NF.A)
        dk = nd_get(nodes, dom, NF.Kind)
        is_range = dk == AstKind.Binary && nd_get(nodes, dom, NF.Op) == TokenKind.DotDot
        ?[is_range] {
            vn <- "i"
            ?[nd_get(nodes, ni, NF.F1) == 1] { vn <- tk_lex(src, toks, nd_get(nodes, ni, NF.Name)) }
            ec_put(b, "for (int64_t "); ec_put(b, vn); ec_put(b, " = ")
            ec_expr(src, toks, nodes, kids, types, tp, tpn, b, nd_get(nodes, dom, NF.A))
            ec_put(b, "; "); ec_put(b, vn); ec_put(b, " < ")
            ec_expr(src, toks, nodes, kids, types, tp, tpn, b, nd_get(nodes, dom, NF.B))
            ec_put(b, "; "); ec_put(b, vn); ec_put(b, "++) {\n")
        }
        ?[is_range == false] {
            ec_put(b, "while ("); ec_expr(src, toks, nodes, kids, types, tp, tpn, b, dom); ec_put(b, ") {\n")
        }
        s = nd_get(nodes, ni, NF.L1s); n = nd_get(nodes, ni, NF.L1n)
        j <- 0; [j < n] { ec_stmt(src, toks, nodes, kids, types, tp, tpn, b, vec_get(kids, s + j), indent + 1); j <- j + 1 }
        ?[nd_get(nodes, ni, NF.B) != 0 - 1] { ec_stmt(src, toks, nodes, kids, types, tp, tpn, b, nd_get(nodes, ni, NF.B), indent + 1) }
        ec_indent(b, indent); ec_put(b, "}\n"); done <- 1
    }
    ?[done == 0] {
        ec_expr(src, toks, nodes, kids, types, tp, tpn, b, ni)
        ec_put(b, ";\n")
    }
    0
}

ec_function src:str toks:vec[Token] nodes:vec[int] kids:vec[int] types:vec[int] tp:vec[int] tpn:vec[str] b:strbuf ni:i64 body_only:i64 -> i64 -> {
    name = tk_lex(src, toks, nd_get(nodes, ni, NF.Name))
    ?[body_only == 0] {
        ec_put(b, ec_type(tp, tpn, types, ni)); ec_put(b, " "); ec_put(b, name); ec_put(b, "(")
        s = nd_get(nodes, ni, NF.L1s); n = nd_get(nodes, ni, NF.L1n)
        j <- 0; [j < n] { ?[j > 0] { ec_put(b, ", ") }; ec_put(b, "int64_t "); ec_put(b, tk_lex(src, toks, vec_get(kids, s + j))); j <- j + 1 }
        ec_put(b, ");\n")
    }
    ?[body_only == 1] {
        ec_put(b, ec_type(tp, tpn, types, ni)); ec_put(b, "\n"); ec_put(b, name); ec_put(b, "(")
        s = nd_get(nodes, ni, NF.L1s); n = nd_get(nodes, ni, NF.L1n)
        j <- 0; [j < n] { ?[j > 0] { ec_put(b, ", ") }; ec_put(b, "int64_t "); ec_put(b, tk_lex(src, toks, vec_get(kids, s + j))); j <- j + 1 }
        ec_put(b, ") {\n")
        body = nd_get(nodes, ni, NF.A)
        ?[nd_get(nodes, body, NF.Kind) == AstKind.Block] {
            bs = nd_get(nodes, body, NF.L1s); bn = nd_get(nodes, body, NF.L1n)
            q <- 0; [q < bn] { ec_stmt(src, toks, nodes, kids, types, tp, tpn, b, vec_get(kids, bs + q), 1); q <- q + 1 }
            ec_indent(b, 1); ec_put(b, "return ")
            ?[nd_get(nodes, body, NF.A) != 0 - 1] { ec_expr(src, toks, nodes, kids, types, tp, tpn, b, nd_get(nodes, body, NF.A)) }
            ?[nd_get(nodes, body, NF.A) == 0 - 1] { ec_put(b, "0") }
            ec_put(b, ";\n")
        }
        ?[nd_get(nodes, body, NF.Kind) != AstKind.Block] {
            ec_indent(b, 1); ec_put(b, "return "); ec_expr(src, toks, nodes, kids, types, tp, tpn, b, body); ec_put(b, ";\n")
        }
        ec_put(b, "}\n\n")
    }
    0
}

emit_c_program src:str toks:vec[Token] nodes:vec[int] kids:vec[int] tops:vec[int] types:vec[int] tp:vec[int] tpn:vec[str] -> str -> {
    b = str_buf_new()
    ec_put(b, "#include <stdint.h>\n#include <stdio.h>\n#include <stdbool.h>\n#include <stdlib.h>\n\ntypedef struct { const void *ptr; int len; } TiqSlice;\n\n")
    n = vec_len(tops)
    j <- 0; [j < n] { ni = vec_get(tops, j); ?[nd_get(nodes, ni, NF.Kind) == AstKind.Function] { ec_function(src, toks, nodes, kids, types, tp, tpn, b, ni, 0) }; j <- j + 1 }
    ec_put(b, "\nint main(void) {\n")
    j <- 0
    [j < n] {
        ni = vec_get(tops, j); k = nd_get(nodes, ni, NF.Kind)
        ?[k != AstKind.Function && k != AstKind.StructDef && k != AstKind.EnumDef && k != AstKind.Import] { ec_stmt(src, toks, nodes, kids, types, tp, tpn, b, ni, 1) }
        j <- j + 1
    }
    ec_put(b, "    return 0;\n}\n\n")
    j <- 0; [j < n] { ni = vec_get(tops, j); ?[nd_get(nodes, ni, NF.Kind) == AstKind.Function] { ec_function(src, toks, nodes, kids, types, tp, tpn, b, ni, 1) }; j <- j + 1 }
    str_buf_to_str(b)
}
