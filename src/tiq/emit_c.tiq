                ec_put(b, ") + (")
                arg0 != 0 - 1 ? { ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, arg0) }
                arg0 == 0 - 1 ? { ec_put(b, "0") }
                ec_put(b, ") * sizeof(int64_t), .len = (")
                arg1 != 0 - 1 ? { ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, arg1) }
                arg1 == 0 - 1 ? { ec_put(b, int_str(alen)) }
                ec_put(b, ") - (")
                arg0 != 0 - 1 ? { ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, arg0) }
                arg0 == 0 - 1 ? { ec_put(b, "0") }
                ec_put(b, ") })")
                done <- 1
            }
            done == 0 && ck == TY.Slice ? {
                ec_put(b, "((TiqSlice){ .ptr = ((const char*)(")
                ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, callee)
                ec_put(b, ".ptr)) + (")
                arg0 != 0 - 1 ? { ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, arg0) }
                arg0 == 0 - 1 ? { ec_put(b, "0") }
                ec_put(b, ") * sizeof(int64_t), .len = (")
                arg1 != 0 - 1 ? { ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, arg1) }
                arg1 == 0 - 1 ? { ec_put(b, "("); ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, callee); ec_put(b, ".len)") }
                ec_put(b, ") - (")
                arg0 != 0 - 1 ? { ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, arg0) }
                arg0 == 0 - 1 ? { ec_put(b, "0") }
                ec_put(b, ") })")
                done <- 1
            }
            done == 0 && (ck == TY.Str || ck == TY.StrView) ? {
