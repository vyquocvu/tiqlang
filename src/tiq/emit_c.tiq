                ck == TY.Str ? { ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, callee) }
                ck == TY.StrView ? { ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, callee); ec_put(b, ".ptr") }
                ec_put(b, ") + (")
                arg0 != 0 - 1 ? { ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, arg0) }
                arg0 == 0 - 1 ? { ec_put(b, "0") }
                ec_put(b, "), .len = (")
                arg1 != 0 - 1 ? { ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, arg1) }
                arg1 == 0 - 1 && ck == TY.Str ? { ec_put(b, "(int)strlen("); ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, callee); ec_put(b, ")") }
                arg1 == 0 - 1 && ck == TY.StrView ? { ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, callee); ec_put(b, ".len") }
                ec_put(b, ") - (")
                arg0 != 0 - 1 ? { ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, arg0) }
                arg0 == 0 - 1 ? { ec_put(b, "0") }
                ec_put(b, ") })"); done <- 1
            }
        }
        // Slice indexed read: s[i]
        done == 0 && is_bracket == 1 && is_slice == 0 && ec_kind(types, tp, callee) == TY.Slice ? {
            idx = vec_get(kids, s)
            ec_put(b, "((uint64_t)(")
            ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, idx)
            ec_put(b, ") < (uint64_t)(")
            ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, callee)
            ec_put(b, ".len) ? ((const int64_t*)(")
            ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, callee)
            ec_put(b, ".ptr))[")
            ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, idx)
            ec_put(b, "] : (fprintf(stderr, \"tiq: index %lld out of bounds for slice of length %lld\\n\", (long long)(")
            ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, idx)
            ec_put(b, "), (long long)(")
            ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, callee)
            ec_put(b, ".len)), exit(1), (int64_t)0))")
            done <- 1
        }
        done == 0 && is_bracket == 1 && is_slice == 0 && (ec_kind(types, tp, callee) == TY.Str || ec_kind(types, tp, callee) == TY.StrView) ? {
            idx = vec_get(kids, s); ck = ec_kind(types, tp, callee)
            ec_put(b, "((uint64_t)("); ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, idx); ec_put(b, ") < (uint64_t)(")
            ck == TY.Str ? { ec_put(b, "strlen("); ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, callee); ec_put(b, ")") }
            ck == TY.StrView ? { ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, callee); ec_put(b, ".len") }
            ec_put(b, ") ? ")
            ck == TY.Str ? { ec_put(b, "(int64_t)(unsigned char)("); ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, callee); ec_put(b, ")[") }
            ck == TY.StrView ? { ec_put(b, "(int64_t)((const unsigned char*)("); ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, callee); ec_put(b, ".ptr))[") }
            ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, idx)
            ec_put(b, "] : (fprintf(stderr, \"tiq: index %lld out of bounds for string of length %lld\\n\", (long long)(")
            ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, idx); ec_put(b, "), (long long)(")
            ck == TY.Str ? { ec_put(b, "strlen("); ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, callee); ec_put(b, ")") }
            ck == TY.StrView ? { ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, callee); ec_put(b, ".len") }
            ec_put(b, ")), exit(1), (int64_t)0))"); done <- 1
        }
        done == 0 && is_bracket == 0 && str_eq(cname, "len") && n == 1 ? {
            ai = vec_get(kids, s)
            aik = ec_kind(types, tp, ai)
            aik == TY.Array ? { ec_put(b, int_str(ec_array_len(types, tp, ai))); done <- 1 }
            done == 0 && aik == TY.Slice ? { ec_put(b, "("); ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, ai); ec_put(b, ".len)"); done <- 1 }
            done == 0 && aik == TY.Str ? { ec_put(b, "((int64_t)strlen("); ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, ai); ec_put(b, "))"); done <- 1 }
            done == 0 && aik == TY.StrView ? { ec_put(b, "("); ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, ai); ec_put(b, ".len)"); done <- 1 }
        }
        is_print = str_eq(cname, "print")
        done == 0 && is_print ? {
            ai = vec_get(kids, s)
            at = vec_get(types, ai)
            ak = at == 0 - 1 ? TY.Int : vec_get(tp, at * 8 + TF.Kind)
            ak == TY.Str ? { ec_put(b, "printf(\"%s\\n\", ") }
            ak == TY.Float || ak == TY.F32 ? { ec_put(b, "printf(\"%g\\n\", (double)(") }
            ak == TY.Bool ? { ec_put(b, "printf(\"%s\\n\", (") }
            ak == TY.Slice || ak == TY.StrView ? { ec_put(b, "printf(\"%.*s\\n\", (") }
            ak != TY.Str && ak != TY.Float && ak != TY.F32 && ak != TY.Bool && ak != TY.Slice && ak != TY.StrView ? { ec_put(b, "printf(\"%lld\\n\", (long long)(") }
            ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, ai)
            ak == TY.Bool ? { ec_put(b, ") ? \"true\" : \"false\"") }
            ak == TY.Slice || ak == TY.StrView ? { ec_put(b, ").len, (const char*)("); ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, ai); ec_put(b, ").ptr") }
            ak != TY.Str && ak != TY.Bool && ak != TY.Slice && ak != TY.StrView ? { ec_put(b, ")") }
            ec_put(b, ")")
            done <- 1
        }
        done == 0 ? {
            ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, callee)
            ec_put(b, "(")
            j <- 0
            [j < n] {
                j > 0 ? { ec_put(b, ", ") }
                ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, vec_get(kids, s + j))
                j <- j + 1
            }
            ec_put(b, ")")
        }
        done <- 1
    }
    done == 0 && k == AstKind.Array ? {
        ec_put(b, "{")
        s = nd_get(nodes, ni, NF.L1s); n = nd_get(nodes, ni, NF.L1n)
        j <- 0
        [j < n] {
            j > 0 ? { ec_put(b, ", ") }
            ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, vec_get(kids, s + j))
            j <- j + 1
        }
        ec_put(b, "}")
        done <- 1
    }
    done == 0 && k == AstKind.ArrayFill ? {
        ec_put(b, "{")
        n = ec_array_len(types, tp, ni)
        j <- 0
        [j < n] {
            j > 0 ? { ec_put(b, ", ") }
            ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, nd_get(nodes, ni, NF.A))
            j <- j + 1
        }
        ec_put(b, "}")
        done <- 1
    }
    done == 0 && k == AstKind.FieldAccess ? {
        target = nd_get(nodes, ni, NF.A); fld = tk_lex(src, toks, nd_get(nodes, ni, NF.Name))
        ec_kind(types, tp, target) == TY.Struct ? { ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, target); ec_put(b, "."); ec_put(b, fld) }
        ec_kind(types, tp, target) != TY.Struct ? { ec_put(b, "tiq_enum_"); ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, target); ec_put(b, "_"); ec_put(b, fld) }
        done <- 1
    }
    done == 0 && k == AstKind.RecordLit ? {
        t = vec_get(types, ni)
        ec_put(b, "("); ec_put(b, vec_get(tpn, t)); ec_put(b, "){ ")
        vs = nd_get(nodes, ni, NF.L1s); ns = nd_get(nodes, ni, NF.L2s); n = nd_get(nodes, ni, NF.L1n); j <- 0
        [j < n] {
            j > 0 ? { ec_put(b, ", ") }
            ec_put(b, "."); ec_put(b, tk_lex(src, toks, vec_get(kids, ns + j))); ec_put(b, " = ")
            ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, vec_get(kids, vs + j)); j <- j + 1
        }
        ec_put(b, " }"); done <- 1
    }
    done == 0 && k == AstKind.Match ? {
        // Statement expression: __extension__({ type _t = expr; type _r; if (...) { _r = body; } ... _r; })
        scrutinee <- nd_get(nodes, ni, NF.A)
        scrutinee_type <- ec_type(tp, tpn, types, scrutinee)
        result_type <- ec_type(tp, tpn, types, ni)
        ec_put(b, "__extension__({ ")
        ec_put(b, scrutinee_type); ec_put(b, " _t = ")
        ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, scrutinee)
        ec_put(b, "; "); ec_put(b, result_type); ec_put(b, " _r;\n")
        
        s = nd_get(nodes, ni, NF.L1s); n = nd_get(nodes, ni, NF.L1n); j <- 0; first <- 1
        [j < n] {
            arm = vec_get(kids, s + j)
            pat_kind <- nd_get(nodes, arm, NF.F1)
            
            // Emit condition
            first == 0 ? { ec_put(b, "else ") }
            first <- 0
            
            pat_kind == 0 ? {
                // Wildcard: unconditional
                ec_put(b, "{ ")
            }
            pat_kind == 1 ? {
                // Literal pattern
                pat_data <- nd_get(nodes, arm, NF.A)
                pat_data != -1 ? {
                    lt <- nd_get(nodes, pat_data, NF.Op)
                    lt == TokenKind.None ? {
                        // Check scrutinee type to determine Option vs Result
                        scr_t <- vec_get(types, scrutinee)
                        scr_k <- scr_t != 0 - 1 ? vec_get(tp, scr_t * 8 + TF.Kind) : 0 - 1
                        scr_k == TY.Option ? { ec_put(b, "if (!(_t.has_value)) { ") }
                        scr_k == TY.Result ? { ec_put(b, "if (!(_t.is_ok)) { ") }
                    }
                    lt != TokenKind.None ? {
                        ec_put(b, "if (_t == ")
                        ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, pat_data)
                        ec_put(b, ") { ")
                    }
                }
            }
            pat_kind == 2 ? {
                // Binding: unconditional with binding
                nm <- tk_lex(src, toks, nd_get(nodes, arm, NF.Name))
                binding_type <- scrutinee_type
                ec_put(b, "{ "); ec_put(b, binding_type); ec_put(b, " "); ec_put(b, nm); ec_put(b, " = _t; ")
            }
            pat_kind == 3 ? {
                // Constructor: some/ok/err
                cname <- tk_lex(src, toks, nd_get(nodes, arm, NF.Name))
                str_eq(cname, "some") ? { ec_put(b, "if (_t.has_value) { ") }
                str_eq(cname, "ok") ? { ec_put(b, "if (_t.is_ok) { ") }
                str_eq(cname, "err") ? { ec_put(b, "if (!(_t.is_ok)) { ") }
                // Emit sub-pattern bindings
                sub_s <- nd_get(nodes, arm, NF.L1s); sub_n <- nd_get(nodes, arm, NF.L1n)
                sub_j <- 0
                [sub_j < sub_n] {
                    sub_pat <- vec_get(kids, sub_s + sub_j)
                    sub_pat != -1 ? {
                        sub_kind <- nd_get(nodes, sub_pat, NF.F1)
                        sub_kind == 2 ? {
                            // Binding sub-pattern
                            sub_nm <- tk_lex(src, toks, nd_get(nodes, sub_pat, NF.Name))
                            str_eq(cname, "some") ? {
                                inner_t <- scrutinee_type
                                ec_put(b, inner_t); ec_put(b, " "); ec_put(b, sub_nm); ec_put(b, " = _t.value; ")
                            }
                            str_eq(cname, "ok") ? {
                                inner_t <- scrutinee_type
                                ec_put(b, inner_t); ec_put(b, " "); ec_put(b, sub_nm); ec_put(b, " = _t.value; ")
                            }
                            str_eq(cname, "err") ? {
                                ec_put(b, "int64_t "); ec_put(b, sub_nm); ec_put(b, " = _t.error; ")
                            }
                        }
                    }
                    sub_j <- sub_j + 1
                }
            }
            pat_kind == 4 ? {
                // Enum variant
                tn <- tk_lex(src, toks, nd_get(nodes, arm, NF.Name))
                vn <- tk_lex(src, toks, nd_get(nodes, arm, NF.F2))
                ec_put(b, "if (_t == tiq_enum_"); ec_put(b, tn); ec_put(b, "_"); ec_put(b, vn); ec_put(b, ") { ")
            }
            
            // Emit body
            ec_put(b, "_r = ")
            ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, nd_get(nodes, arm, NF.B))
            ec_put(b, "; }\n")
            
            j <- j + 1
        }
        ec_put(b, "_r; })")
        done <- 1
    }
    // Exhaustive preflight rejects unsupported AST families before output.
    // Keep an invalid C sentinel here so any future traversal omission cannot
    // silently acquire the old numeric-placeholder semantics.
    done == 0 ? { ec_put(b, "TIQ_UNSUPPORTED_AST") }
    0
}

ec_stmt src:str toks:vec[Token] nodes:vec[int] kids:vec[int] fresh:vec[str] hs:vec[int] his:vec[int] hem:vec[int] hnext:vec[int] types:vec[int] tp:vec[int] tpn:vec[str] b:strbuf ni:i64 indent:i64 oss:vec[int] ons:vec[int] oms:vec[int] : i64 -> {
    k = nd_get(nodes, ni, NF.Kind)
    hstart = vec_len(hs)
    k == AstKind.Binding || k == AstKind.Assign ? { ec_hoist_collect(src, toks, nodes, kids, fresh, hs, nd_get(nodes, ni, NF.A), 1) }
    k == AstKind.Call ? {
        hci = nd_get(nodes, ni, NF.A); hcn <- ""
        hci != 0 - 1 && nd_get(nodes, hci, NF.Kind) == AstKind.Identifier ? { hcn <- tk_lex(src, toks, nd_get(nodes, hci, NF.Name)) }
        str_eq(hcn, "proc_exit") == false ? { ec_hoist_collect(src, toks, nodes, kids, fresh, hs, ni, 0) }
    }
    k == AstKind.Conditional && nd_get(nodes, ni, NF.C) != 0 - 1 ? { ec_hoist_collect(src, toks, nodes, kids, fresh, hs, ni, 0) }
    hj <- hstart
    [hj < vec_len(hs)] {
        hid = vec_get(hnext, 0); vec_set(hnext, 0, hid + 1); vec_push(his, hid)
        ec_indent(b, indent); ec_put(b, "const char *tiq_tmp"); ec_put(b, int_str(hid)); ec_put(b, " = ")
        vec_push(hem, vec_get(hs, hj))
        ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, vec_get(hs, hj))
        hp = vec_pop(hem)
        ec_put(b, ";\n")
        hj <- hj + 1
    }
    ec_indent(b, indent)
    done <- 0
    k == AstKind.Conditional && nd_get(nodes, ni, NF.C) == 0 - 1 ? {
        ec_put(b, "if (1 && "); ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, nd_get(nodes, ni, NF.A)); ec_put(b, ") {\n")
        bi = nd_get(nodes, ni, NF.B)
        nd_get(nodes, bi, NF.Kind) == AstKind.Block ? {
            s = nd_get(nodes, bi, NF.L1s); n = nd_get(nodes, bi, NF.L1n); j <- 0
            vec_push(oss, s); vec_push(ons, n); vec_push(oms, 0)
            [j < n] { vec_set(oms, vec_len(oms) - 1, j); ec_stmt(src, toks, nodes, kids, fresh, hs, his, hem, hnext, types, tp, tpn, b, vec_get(kids, s + j), indent + 1, oss, ons, oms); j <- j + 1 }
            nd_get(nodes, bi, NF.C) != 0 - 1 ? { ec_stmt(src, toks, nodes, kids, fresh, hs, his, hem, hnext, types, tp, tpn, b, nd_get(nodes, bi, NF.C), indent + 1, oss, ons, oms) }
            ds = nd_get(nodes, bi, NF.L2s); dn = nd_get(nodes, bi, NF.L2n); j <- 0
            [j < dn] { ec_stmt(src, toks, nodes, kids, fresh, hs, his, hem, hnext, types, tp, tpn, b, vec_get(kids, ds + j), indent + 1, oss, ons, oms); j <- j + 1 }
            ec_emit_frees(src, toks, nodes, kids, fresh, b, kids, s, n, indent + 1, "")
            pop1 = vec_pop(oss); pop2 = vec_pop(ons); pop3 = vec_pop(oms)
        }
        nd_get(nodes, bi, NF.Kind) != AstKind.Block ? { ec_stmt(src, toks, nodes, kids, fresh, hs, his, hem, hnext, types, tp, tpn, b, bi, indent + 1, oss, ons, oms) }
        ec_indent(b, indent); ec_put(b, "}\n"); done <- 1
    }
    done == 0 && k == AstKind.Block ? {
        ec_put(b, "{\n")
        s = nd_get(nodes, ni, NF.L1s); n = nd_get(nodes, ni, NF.L1n); j <- 0
        vec_push(oss, s); vec_push(ons, n); vec_push(oms, 0)
        [j < n] { vec_set(oms, vec_len(oms) - 1, j); ec_stmt(src, toks, nodes, kids, fresh, hs, his, hem, hnext, types, tp, tpn, b, vec_get(kids, s + j), indent + 1, oss, ons, oms); j <- j + 1 }
        nd_get(nodes, ni, NF.C) != 0 - 1 ? { ec_stmt(src, toks, nodes, kids, fresh, hs, his, hem, hnext, types, tp, tpn, b, nd_get(nodes, ni, NF.C), indent + 1, oss, ons, oms) }
        ds = nd_get(nodes, ni, NF.L2s); dn = nd_get(nodes, ni, NF.L2n); j <- 0
        [j < dn] { ec_stmt(src, toks, nodes, kids, fresh, hs, his, hem, hnext, types, tp, tpn, b, vec_get(kids, ds + j), indent + 1, oss, ons, oms); j <- j + 1 }
        ec_emit_frees(src, toks, nodes, kids, fresh, b, kids, s, n, indent + 1, "")
        pop4 = vec_pop(oss); pop5 = vec_pop(ons); pop6 = vec_pop(oms)
        ec_indent(b, indent); ec_put(b, "}\n"); done <- 1
    }
    k == AstKind.Binding ? {
        nk = ec_kind(types, tp, ni)
        nk == TY.Array ? {
            t = vec_get(types, ni); et = vec_get(tp, t * 8 + TF.Elem)
            ek = et == 0 - 1 ? TY.Int : vec_get(tp, et * 8 + TF.Kind)
            ec_put(b, ec_kind_type(ek)); ec_put(b, " ")
            ec_put(b, tk_lex(src, toks, nd_get(nodes, ni, NF.Name))); ec_put(b, "[")
            ec_put(b, int_str(vec_get(tp, t * 8 + TF.Len))); ec_put(b, "] = ")
        }
        nk != TY.Array ? {
            ec_put(b, ec_type(tp, tpn, types, ni)); ec_put(b, " ")
            ec_put(b, tk_lex(src, toks, nd_get(nodes, ni, NF.Name))); ec_put(b, " = ")
        }
        ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, nd_get(nodes, ni, NF.A))
        ec_put(b, ";\n"); ec_indent(b, indent); ec_put(b, "(void)"); ec_put(b, tk_lex(src, toks, nd_get(nodes, ni, NF.Name))); ec_put(b, ";\n"); done <- 1
    }
    done == 0 && k == AstKind.Assign ? {
        is_def = nd_get(nodes, ni, NF.F1)
        idx = nd_get(nodes, ni, NF.B)
        idx != 0 - 1 ? {
            nk = ec_kind(types, tp, ni)
            nk == TY.Slice ? {
                ec_put(b, "if ((uint64_t)(")
                ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, idx)
                ec_put(b, ") >= (uint64_t)(")
                ec_put(b, tk_lex(src, toks, nd_get(nodes, ni, NF.Name)))
                ec_put(b, ".len)) { fprintf(stderr, \"tiq: index out of bounds for slice of length %lld\\n\", (long long)(")
                ec_put(b, tk_lex(src, toks, nd_get(nodes, ni, NF.Name)))
                ec_put(b, ".len)); exit(1); }\n")
                ec_indent(b, indent)
                ec_put(b, "((int64_t*)(")
                ec_put(b, tk_lex(src, toks, nd_get(nodes, ni, NF.Name)))
                ec_put(b, ".ptr))[")
                ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, idx)
                ec_put(b, "] ")
                ec_put(b, ec_assign_op(nd_get(nodes, ni, NF.Op))); ec_put(b, " ")
                ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, nd_get(nodes, ni, NF.A))
                ec_put(b, ";\n"); done <- 1
            }
            done == 0 ? {
                alen = ec_array_len(types, tp, ni)
                ec_put(b, "if ((uint64_t)(")
                ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, idx)
                ec_put(b, ") >= (uint64_t)("); ec_put(b, int_str(alen)); ec_put(b, ")) { fprintf(stderr, \"tiq: index out of bounds for array of length ")
                ec_put(b, int_str(alen)); ec_put(b, "\\n\"); exit(1); }\n")
                ec_indent(b, indent)
                ec_put(b, tk_lex(src, toks, nd_get(nodes, ni, NF.Name)))
                ec_put(b, "["); ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, idx); ec_put(b, "] ")
                ec_put(b, ec_assign_op(nd_get(nodes, ni, NF.Op))); ec_put(b, " ")
                ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, nd_get(nodes, ni, NF.A))
                ec_put(b, ";\n"); done <- 1
            }
        }
        owns_reassign <- false
        done == 0 && is_def == 0 && idx == 0 - 1 && nd_get(nodes, ni, NF.Op) == TokenKind.Larrow && ec_owned_expr(src, toks, nodes, fresh, nd_get(nodes, ni, NF.A)) ? {
            owns_reassign <- ec_mut_active(src, toks, nodes, kids, fresh, oss, ons, oms, tk_lex(src, toks, nd_get(nodes, ni, NF.Name)))
        }
        done == 0 && owns_reassign ? {
            nm = tk_lex(src, toks, nd_get(nodes, ni, NF.Name))
            ec_put(b, "{ const char *tiq_old = "); ec_put(b, nm); ec_put(b, "; "); ec_put(b, nm); ec_put(b, " = ")
            ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, nd_get(nodes, ni, NF.A)); ec_put(b, "; free((void *)tiq_old); }\n"); done <- 1
        }
        done == 0 ? {
            is_def == 1 ? { ec_put(b, ec_type(tp, tpn, types, ni)); ec_put(b, " ") }
            ec_put(b, tk_lex(src, toks, nd_get(nodes, ni, NF.Name))); ec_put(b, " ")
            ec_put(b, is_def == 1 ? "=" : ec_assign_op(nd_get(nodes, ni, NF.Op))); ec_put(b, " ")
            ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, nd_get(nodes, ni, NF.A))
            ec_put(b, ";\n")
            is_def == 1 ? { ec_indent(b, indent); ec_put(b, "(void)"); ec_put(b, tk_lex(src, toks, nd_get(nodes, ni, NF.Name))); ec_put(b, ";\n") }
            done <- 1
        }
    }
    done == 0 && k == AstKind.Break ? { ec_emit_exit_frees(src, toks, nodes, kids, fresh, b, oss, ons, oms, indent); ec_indent(b, indent); ec_put(b, "break;\n"); done <- 1 }
    done == 0 && k == AstKind.Skip ? { ec_emit_exit_frees(src, toks, nodes, kids, fresh, b, oss, ons, oms, indent); ec_indent(b, indent); ec_put(b, "continue;\n"); done <- 1 }
    done == 0 && k == AstKind.Defer ? {
        ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, nd_get(nodes, ni, NF.A)); ec_put(b, ";\n"); done <- 1
    }
    done == 0 && k == AstKind.Call ? {
        ci = nd_get(nodes, ni, NF.A); cname <- ""
        ci != 0 - 1 && nd_get(nodes, ci, NF.Kind) == AstKind.Identifier ? { cname <- tk_lex(src, toks, nd_get(nodes, ci, NF.Name)) }
        str_eq(cname, "proc_exit") && nd_get(nodes, ni, NF.L1n) == 1 ? {
            ec_put(b, "{ int64_t tiq_exit_code = "); ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, vec_get(kids, nd_get(nodes, ni, NF.L1s))); ec_put(b, ";\n")
            ec_emit_all_frees(src, toks, nodes, kids, fresh, b, oss, oms, indent + 1)
            ec_indent(b, indent + 1); ec_put(b, "tiq_proc_exit(tiq_exit_code);\n"); ec_indent(b, indent); ec_put(b, "}\n"); done <- 1
        }
    }
    done == 0 && k == AstKind.BracketLoop ? {
        dom = nd_get(nodes, ni, NF.A)
        dk = nd_get(nodes, dom, NF.Kind)
        is_range = dk == AstKind.Binary && nd_get(nodes, dom, NF.Op) == TokenKind.DotDot
        is_range ? {
            vn <- "_tiq_i"
            nd_get(nodes, ni, NF.F1) == 1 ? { vn <- tk_lex(src, toks, nd_get(nodes, ni, NF.Name)) }
            ec_put(b, "for (int64_t "); ec_put(b, vn); ec_put(b, " = ")
            ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, nd_get(nodes, dom, NF.A))
            ec_put(b, "; "); ec_put(b, vn); ec_put(b, " < ")
            ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, nd_get(nodes, dom, NF.B))
            ec_put(b, "; "); ec_put(b, vn); ec_put(b, "++) {\n")
        }
        is_range == false ? {
            ec_put(b, "while (1 && "); ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, dom); ec_put(b, ") {\n")
        }
        s = nd_get(nodes, ni, NF.L1s); n = nd_get(nodes, ni, NF.L1n)
        vec_push(oss, s); vec_push(ons, n); vec_push(oms, 1000000000)
        j <- 0; [j < n] { vec_set(oms, vec_len(oms) - 1, 1000000000 + j); ec_stmt(src, toks, nodes, kids, fresh, hs, his, hem, hnext, types, tp, tpn, b, vec_get(kids, s + j), indent + 1, oss, ons, oms); j <- j + 1 }
        nd_get(nodes, ni, NF.B) != 0 - 1 ? { ec_stmt(src, toks, nodes, kids, fresh, hs, his, hem, hnext, types, tp, tpn, b, nd_get(nodes, ni, NF.B), indent + 1, oss, ons, oms) }
        ec_emit_frees(src, toks, nodes, kids, fresh, b, kids, s, n, indent + 1, "")
        pop7 = vec_pop(oss); pop8 = vec_pop(ons); pop9 = vec_pop(oms)
        ec_indent(b, indent); ec_put(b, "}\n"); done <- 1
    }
    done == 0 ? {
        hv <- 0; hj <- hstart
        [hj < vec_len(hs)] { vec_get(hs, hj) == ni ? { hv <- 1 }; hj <- hj + 1 }
        hv == 1 ? { ec_put(b, "(void)") }
        ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, ni)
        ec_put(b, ";\n")
    }
    hj <- vec_len(hs)
    [hj > hstart] {
        hj <- hj - 1
        ec_indent(b, indent); ec_put(b, "free((void *)tiq_tmp"); ec_put(b, int_str(vec_get(his, hj))); ec_put(b, ");\n")
    }
    [vec_len(hs) > hstart] { hp1 = vec_pop(hs); hp2 = vec_pop(his) }
    0
}

ec_stream_def src:str toks:vec[Token] nodes:vec[int] kids:vec[int] hs:vec[int] his:vec[int] hem:vec[int] types:vec[int] tp:vec[int] tpn:vec[str] b:strbuf name:str gen:i64 owner:i64 : i64 -> {
    s = nd_get(nodes, gen, NF.L1s); n = nd_get(nodes, gen, NF.L1n)
    ec_put(b, "int64_t tiq_gen_"); ec_put(b, name); ec_put(b, "(")
    owner != 0 - 1 ? {
        ps = nd_get(nodes, owner, NF.L1s); pc = nd_get(nodes, owner, NF.L1n); q <- 0
        [q < pc] { q > 0 ? { ec_put(b, ", ") }; ec_put(b, "int64_t "); ec_put(b, tk_lex(src, toks, vec_get(kids, ps + q))); q <- q + 1 }
        pc > 0 ? { ec_put(b, ", ") }
    }
    ec_put(b, "int64_t n) {\n    if (n < 0) return 0;\n")
    n == 1 ? {
        ec_put(b, "    int64_t x = "); ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, vec_get(kids, s)); ec_put(b, ";\n    if (n == 0) return x;\n    for (int64_t i = 1; i <= n; i++) {\n        x = (")
        ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, nd_get(nodes, gen, NF.A)); ec_put(b, ");\n    }\n    return x;\n}\n\n")
    }
    n >= 2 ? {
        ec_put(b, "    if (n == 0) return "); ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, vec_get(kids, s)); ec_put(b, ";\n    if (n == 1) return ")
        ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, vec_get(kids, s + 1)); ec_put(b, ";\n    int64_t a = ")
        ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, vec_get(kids, s + 1)); ec_put(b, ";\n    int64_t b = ")
        ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, vec_get(kids, s)); ec_put(b, ";\n    for (int64_t i = 2; i <= n; i++) {\n        int64_t t = (")
        ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, nd_get(nodes, gen, NF.A)); ec_put(b, ");\n        b = a;\n        a = t;\n    }\n    return a;\n}\n\n")
    }
    0
}

ec_function src:str toks:vec[Token] nodes:vec[int] kids:vec[int] fresh:vec[str] hs:vec[int] his:vec[int] hem:vec[int] hnext:vec[int] types:vec[int] tp:vec[int] tpn:vec[str] b:strbuf ni:i64 body_only:i64 : i64 -> {
    name = tk_lex(src, toks, nd_get(nodes, ni, NF.Name))
    body_only == 0 ? {
        ec_put(b, ec_type(tp, tpn, types, ni)); ec_put(b, " "); ec_put(b, name); ec_put(b, "(")
        s = nd_get(nodes, ni, NF.L1s); s2 = nd_get(nodes, ni, NF.L2s); n = nd_get(nodes, ni, NF.L1n)
        j <- 0
        [j < n] {
            j > 0 ? { ec_put(b, ", ") }
            ann = vec_get(kids, s2 + j * 3); rk = vec_get(kids, s2 + j * 3 + 2); pn = tk_lex(src, toks, vec_get(kids, s + j))
            rk == 1 ? { ec_put(b, "const ") }
            ec_put(b, ann == 0 - 1 ? "int64_t" : ec_annot_type(src, toks, ann))
            rk != 0 ? { ec_put(b, " *tiq_ref_") }
            rk == 0 ? { ec_put(b, " ") }
            ec_put(b, pn); j <- j + 1
        }
        ec_put(b, ");\n")
    }
    body_only == 1 ? {
        oss = vec_new(); ons = vec_new(); oms = vec_new()
        ec_put(b, ec_type(tp, tpn, types, ni)); ec_put(b, "\n"); ec_put(b, name); ec_put(b, "(")
        s = nd_get(nodes, ni, NF.L1s); s2 = nd_get(nodes, ni, NF.L2s); n = nd_get(nodes, ni, NF.L1n)
        j <- 0
        [j < n] {
            j > 0 ? { ec_put(b, ", ") }
            ann = vec_get(kids, s2 + j * 3); rk = vec_get(kids, s2 + j * 3 + 2); pn = tk_lex(src, toks, vec_get(kids, s + j))
            rk == 1 ? { ec_put(b, "const ") }
            ec_put(b, ann == 0 - 1 ? "int64_t" : ec_annot_type(src, toks, ann))
            rk != 0 ? { ec_put(b, " *tiq_ref_") }
            rk == 0 ? { ec_put(b, " ") }
            ec_put(b, pn); j <- j + 1
        }
        ec_put(b, ") {\n")
        // Borrowed parameters read like values inside Tiq. Mutable borrows are
        // copied back immediately before the single generated return.
        j <- 0
        [j < n] {
            ann = vec_get(kids, s2 + j * 3); rk = vec_get(kids, s2 + j * 3 + 2); pn = tk_lex(src, toks, vec_get(kids, s + j))
            rk != 0 ? {
                ec_put(b, "    "); ec_put(b, ann == 0 - 1 ? "int64_t" : ec_annot_type(src, toks, ann)); ec_put(b, " "); ec_put(b, pn)
                ec_put(b, " = *tiq_ref_"); ec_put(b, pn); ec_put(b, ";\n")
            }
            j <- j + 1
        }
        j <- 0
        [j < n] { pn = tk_lex(src, toks, vec_get(kids, s + j)); ec_put(b, "    (void)"); ec_put(b, pn); ec_put(b, ";\n"); j <- j + 1 }
        body = nd_get(nodes, ni, NF.A)
        nd_get(nodes, body, NF.Kind) == AstKind.Block ? {
            bs = nd_get(nodes, body, NF.L1s); bn = nd_get(nodes, body, NF.L1n)
            vec_push(oss, bs); vec_push(ons, bn); vec_push(oms, 0)
            q <- 0; [q < bn] { vec_set(oms, vec_len(oms) - 1, q); ec_stmt(src, toks, nodes, kids, fresh, hs, his, hem, hnext, types, tp, tpn, b, vec_get(kids, bs + q), 1, oss, ons, oms); q <- q + 1 }
            // The C parser stores defers in execution order; the Tiq parser's
            // L2 span is already normalized to that same order.
            ds = nd_get(nodes, body, NF.L2s); dn = nd_get(nodes, body, NF.L2n); q <- 0
            [q < dn] { ec_stmt(src, toks, nodes, kids, fresh, hs, his, hem, hnext, types, tp, tpn, b, vec_get(kids, ds + q), 1, oss, ons, oms); q <- q + 1 }
            j <- 0
            [j < n] {
                rk = vec_get(kids, s2 + j * 3 + 2); pn = tk_lex(src, toks, vec_get(kids, s + j))
                rk == 2 ? { ec_put(b, "    *tiq_ref_"); ec_put(b, pn); ec_put(b, " = "); ec_put(b, pn); ec_put(b, ";\n") }
                j <- j + 1
            }
            ret = nd_get(nodes, body, NF.C)
            ec_indent(b, 1); ec_put(b, ec_type(tp, tpn, types, ni)); ec_put(b, " tiq_result = ")
            ret != 0 - 1 ? { ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, ret) }
            ret == 0 - 1 ? { ec_put(b, "0") }
            ec_put(b, ";\n")
            omit <- ""
            ret != 0 - 1 && nd_get(nodes, ret, NF.Kind) == AstKind.Identifier ? { omit <- tk_lex(src, toks, nd_get(nodes, ret, NF.Name)) }
            rkret = ec_kind(types, tp, ni)
            rkret != TY.Str || (ret != 0 - 1 && (ec_owned_expr(src, toks, nodes, fresh, ret) || !str_eq(omit, ""))) ? { ec_emit_frees(src, toks, nodes, kids, fresh, b, kids, bs, bn, 1, omit) }
            ec_put(b, "    return tiq_result;\n")
            pop10 = vec_pop(oss); pop11 = vec_pop(ons); pop12 = vec_pop(oms)
        }
        nd_get(nodes, body, NF.Kind) != AstKind.Block ? {
            j <- 0
            [j < n] {
                rk = vec_get(kids, s2 + j * 3 + 2); pn = tk_lex(src, toks, vec_get(kids, s + j))
                rk == 2 ? { ec_put(b, "    *tiq_ref_"); ec_put(b, pn); ec_put(b, " = "); ec_put(b, pn); ec_put(b, ";\n") }
                j <- j + 1
            }
            ec_indent(b, 1); ec_put(b, "return "); ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, body); ec_put(b, ";\n")
        }
        ec_put(b, "}\n\n")
    }
    0
}

// M16.3: last path component with the .tiq suffix removed; never empty.
// Mirrors C's emit_c_header byte-for-byte (selfhost byte-compare).
ec_path_base path:str : str -> {
    pn = len(path)
    s <- 0
    j <- 0
    [j < pn] {
        str_eq(str_sub(path, j, j + 1), "/") ? { s <- j + 1 }
        j <- j + 1
    }
    base <- str_sub(path, s, pn)
    bl = len(base)
    bl > 4 && str_eq(str_sub(base, bl - 4, bl), ".tiq") ? { base <- str_sub(base, 0, bl - 4) }
    str_eq(base, "") ? { base <- "lib" }
    base
}

// M16.3: include-guard body — uppercased, non-alphanumerics mapped to '_'.
// Uppercasing uses paired alphabet tables (there is no code-to-str builtin).
ec_header_guard base:str : str -> {
    lc = "abcdefghijklmnopqrstuvwxyz"
    uc = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    gb = str_buf_new()
    j <- 0
    [j < len(base)] {
        ch = str_sub(base, j, j + 1)
        cc <- str_sub_code(base, j)
        done <- 0
        m <- 0
        [m < 26 && done == 0] {
            str_eq(str_sub(lc, m, m + 1), ch) ? { str_buf_append(gb, str_sub(uc, m, m + 1)); done <- 1 }
            m <- m + 1
        }
        done == 0 ? {
            is_ok = (cc >= 65 && cc <= 90) || (cc >= 48 && cc <= 57)
            is_ok ? { str_buf_append(gb, ch) }
            is_ok == false ? { str_buf_append(gb, "_") }
        }
        j <- j + 1
    }
    str_buf_to_str(gb)
}

// M16.3: FFI-safe parameter annotation names (the M16.2 scalar table plus
// top-level struct typedefs). Everything else keeps the function internal.
ec_ffi_safe_annot src:str toks:vec[Token] nodes:vec[int] tops:vec[int] ti:i64 : bool -> {
    n = tk_lex(src, toks, ti)
    r <- str_eq(n, "i8") || str_eq(n, "i16") || str_eq(n, "i32") || str_eq(n, "i64") || str_eq(n, "int") ||
         str_eq(n, "u8") || str_eq(n, "u16") || str_eq(n, "u32") || str_eq(n, "u64") ||
         str_eq(n, "f32") || str_eq(n, "f64") || str_eq(n, "float") || str_eq(n, "bool") || str_eq(n, "str")
    r == false ? {
        j <- 0
        [j < vec_len(tops) && r == false] {
            ni = vec_get(tops, j)
            nd_get(nodes, ni, NF.Kind) == AstKind.StructDef && str_eq(tk_lex(src, toks, nd_get(nodes, ni, NF.Name)), n) ? { r <- true }
            j <- j + 1
        }
    }
    r
}

// M16.3: header export filter — mirrors C's function_exportable. Borrows,
// container annotations, stream-gen bodies, and non-FFI-safe returns keep
// the function callable from Tiq but out of the header. Unannotated
// parameters stay int64_t per the emitted-C convention.
ec_exportable src:str toks:vec[Token] nodes:vec[int] kids:vec[int] tops:vec[int] types:vec[int] tp:vec[int] tpn:vec[str] ni:i64 : bool -> {
    valid <- true
    nd_get(nodes, ni, NF.Kind) != AstKind.Function ? { valid <- false }
    valid && nd_get(nodes, nd_get(nodes, ni, NF.A), NF.Kind) == AstKind.StreamGen ? { valid <- false }
    valid ? {
        s2 = nd_get(nodes, ni, NF.L2s); pc = nd_get(nodes, ni, NF.L1n); j <- 0
        [j < pc && valid] {
            ann = vec_get(kids, s2 + j * 3); rk = vec_get(kids, s2 + j * 3 + 2)
            rk != 0 ? { valid <- false }
            valid && ann != 0 - 1 && ec_ffi_safe_annot(src, toks, nodes, tops, ann) == false ? { valid <- false }
            j <- j + 1
        }
    }
    valid ? {
        rk = ec_kind(types, tp, ni)
        valid <- rk == TY.Unknown || rk == TY.Int || rk == TY.Float || rk == TY.Str || rk == TY.Bool ||
              rk == TY.I8 || rk == TY.I16 || rk == TY.I32 || rk == TY.U8 || rk == TY.U16 ||
              rk == TY.U32 || rk == TY.U64 || rk == TY.F32 ||
              (rk == TY.Struct && str_eq(vec_get(tpn, vec_get(types, ni)), "") == false)
    }
    valid
}

// M16.3: deterministic C header for a definitions-only library. Struct
// typedefs come first (by-value parameter support), then the exported
// prototypes spelled exactly like the --lib forward declarations.
ec_header b:strbuf path:str src:str toks:vec[Token] nodes:vec[int] kids:vec[int] tops:vec[int] types:vec[int] tp:vec[int] tpn:vec[str] : i64 -> {
    base = ec_path_base(path)
    guard = ec_header_guard(base)
    ec_put(b, "/* Generated by tiq emit-header from "); ec_put(b, base); ec_put(b, ". Do not edit. */\n")
    ec_put(b, "/* Returned str values are Tiq-owned: callers must not free them (leak, never dangle). */\n")
    ec_put(b, "#ifndef TIQ_"); ec_put(b, guard); ec_put(b, "_H\n")
    ec_put(b, "#define TIQ_"); ec_put(b, guard); ec_put(b, "_H\n\n")
    ec_put(b, "#include <stdint.h>\n\n")
    ec_put(b, "#ifdef __cplusplus\nextern \"C\" {\n#endif\n\n")
    n = vec_len(tops)
    j <- 0
    [j < n] {
        ni = vec_get(tops, j)
        nd_get(nodes, ni, NF.Kind) == AstKind.StructDef ? {
            ec_put(b, "typedef struct {\n")
            ns = nd_get(nodes, ni, NF.L1s); ts = nd_get(nodes, ni, NF.L2s); fc = nd_get(nodes, ni, NF.L1n); q <- 0
            [q < fc] {
                ec_put(b, "    "); ec_put(b, ec_annot_type(src, toks, vec_get(kids, ts + q))); ec_put(b, " ")
                ec_put(b, tk_lex(src, toks, vec_get(kids, ns + q))); ec_put(b, ";\n"); q <- q + 1
            }
            ec_put(b, "} "); ec_put(b, tk_lex(src, toks, nd_get(nodes, ni, NF.Name))); ec_put(b, ";\n\n")
        }
        j <- j + 1
    }
    j <- 0
    [j < n] {
        ni = vec_get(tops, j)
        ec_exportable(src, toks, nodes, kids, tops, types, tp, tpn, ni) ? {
            // Prototype spelling mirrors C's emit_c_header: return via the
            // semantic type, params via the M16.2 FFI table + struct lookup,
            // unannotated params follow the int64_t convention.
            ec_put(b, ec_type(tp, tpn, types, ni)); ec_put(b, " ")
            ec_put(b, tk_lex(src, toks, nd_get(nodes, ni, NF.Name))); ec_put(b, "(")
            s = nd_get(nodes, ni, NF.L1s); s2 = nd_get(nodes, ni, NF.L2s); pc = nd_get(nodes, ni, NF.L1n)
            pc == 0 ? { ec_put(b, "void);\n") }
            pc > 0 ? {
                q <- 0
                [q < pc] {
                    q > 0 ? { ec_put(b, ", ") }
                    ann = vec_get(kids, s2 + q * 3)
                    ec_put(b, ann == 0 - 1 ? "int64_t" : ec_ffi_param_type(src, toks, nodes, tops, ann))
                    ec_put(b, " "); ec_put(b, tk_lex(src, toks, vec_get(kids, s + q)))
                    q <- q + 1
                }
                ec_put(b, ");\n")
            }
        }
        j <- j + 1
    }
    ec_put(b, "\n#ifdef __cplusplus\n}\n#endif\n\n#endif")
    0
}

// M16.3: program/lib emission body. mode 0 emits the full executable;
// mode 1 (lib) omits the entry point so the definitions link into a host
// program. Header mode is handled by emit_c_program before this runs.
ec_program_body src:str toks:vec[Token] nodes:vec[int] kids:vec[int] tops:vec[int] types:vec[int] tp:vec[int] tpn:vec[str] b:strbuf mode:i64 : i64 -> {
    oss = vec_new(); ons = vec_new(); oms = vec_new()
    hs = vec_new(); his = vec_new(); hem = vec_new(); hnext = vec_new(); vec_push(hnext, 0)
    ec_runtime(b)
    n = vec_len(tops)
    fresh = vec_new()
    fj <- 0
    [fj < n] {
        fni = vec_get(tops, fj)
        nd_get(nodes, fni, NF.Kind) == AstKind.Function && ec_fn_fresh(src, toks, nodes, kids, types, tp, fni) ? {
            vec_push(fresh, tk_lex(src, toks, nd_get(nodes, fni, NF.Name)))
        }
        fj <- fj + 1
    }
    j <- 0
    [j < n] {
        ni = vec_get(tops, j); k = nd_get(nodes, ni, NF.Kind)
        k == AstKind.StructDef ? {
            ec_put(b, "typedef struct {\n")
            ns = nd_get(nodes, ni, NF.L1s); ts = nd_get(nodes, ni, NF.L2s); fc = nd_get(nodes, ni, NF.L1n); q <- 0
            [q < fc] {
                ec_put(b, "    "); ec_put(b, ec_annot_type(src, toks, vec_get(kids, ts + q))); ec_put(b, " ")
                ec_put(b, tk_lex(src, toks, vec_get(kids, ns + q))); ec_put(b, ";\n"); q <- q + 1
            }
            ec_put(b, "} "); ec_put(b, tk_lex(src, toks, nd_get(nodes, ni, NF.Name))); ec_put(b, ";\n\n")
        }
        k == AstKind.EnumDef && nd_get(nodes, ni, NF.L1n) > 0 ? {
            ec_put(b, "enum {\n")
            vs = nd_get(nodes, ni, NF.L1s); vc = nd_get(nodes, ni, NF.L1n); q <- 0
            [q < vc] {
                ec_put(b, "    tiq_enum_"); ec_put(b, tk_lex(src, toks, nd_get(nodes, ni, NF.Name))); ec_put(b, "_")
                ec_put(b, tk_lex(src, toks, vec_get(kids, vs + q))); ec_put(b, " = "); ec_put(b, int_str(q))
                q + 1 < vc ? { ec_put(b, ",") }
                ec_put(b, "\n"); q <- q + 1
            }
            ec_put(b, "};\n\n")
        }
        j <- j + 1
    }
    // M16.2: extern "C" prototypes in declaration order, immediately
    // after the enum constants (M13_DETERMINISM.md §1 pass sequence),
    // before the stream-gen forward declarations. Programs without extern
    // decls emit nothing here, so legacy output stays byte-identical.
    // Names shadowed by the preamble's system headers (ec_ffi_shadow) are
    // skipped: their fixed-width redeclaration would conflict with the
    // header prototype, and the header already declares the symbol.
    j <- 0
    [j < n] {
        ni = vec_get(tops, j)
        nd_get(nodes, ni, NF.Kind) == AstKind.Extern ? {
            en = tk_lex(src, toks, nd_get(nodes, ni, NF.Name))
            ec_ffi_shadow(en) == false ? {
                ec_put(b, "extern "); ec_put(b, ec_type(tp, tpn, types, ni)); ec_put(b, " "); ec_put(b, en); ec_put(b, "(")
                ps = nd_get(nodes, ni, NF.L1s); s2 = nd_get(nodes, ni, NF.L2s); pc = nd_get(nodes, ni, NF.L1n)
                pc == 0 ? { ec_put(b, "void);\n") }
                pc > 0 ? {
                    q <- 0
                    [q < pc] {
                        q > 0 ? { ec_put(b, ", ") }
                        ec_put(b, ec_ffi_param_type(src, toks, nodes, tops, vec_get(kids, s2 + q * 3))); ec_put(b, " ")
                        ec_put(b, tk_lex(src, toks, vec_get(kids, ps + q))); q <- q + 1
                    }
                    ec_put(b, ");\n")
                }
            }
        }
        j <- j + 1
    }
    j <- 0
    [j < n] {
        ni = vec_get(tops, j)
        nd_get(nodes, ni, NF.Kind) == AstKind.Binding && nd_get(nodes, nd_get(nodes, ni, NF.A), NF.Kind) == AstKind.StreamGen ? {
            ec_put(b, "int64_t tiq_gen_"); ec_put(b, tk_lex(src, toks, nd_get(nodes, ni, NF.Name))); ec_put(b, "(int64_t n);\n")
        }
        nd_get(nodes, ni, NF.Kind) == AstKind.Function && nd_get(nodes, nd_get(nodes, ni, NF.A), NF.Kind) == AstKind.StreamGen ? {
            ec_put(b, "int64_t tiq_gen_"); ec_put(b, tk_lex(src, toks, nd_get(nodes, ni, NF.Name))); ec_put(b, "(")
            ps = nd_get(nodes, ni, NF.L1s); pc = nd_get(nodes, ni, NF.L1n); q <- 0
            [q < pc] { q > 0 ? { ec_put(b, ", ") }; ec_put(b, "int64_t "); ec_put(b, tk_lex(src, toks, vec_get(kids, ps + q))); q <- q + 1 }
            pc > 0 ? { ec_put(b, ", ") }; ec_put(b, "int64_t n);\n")
        }
        j <- j + 1
    }
    j <- 0; [j < n] { ni = vec_get(tops, j); nd_get(nodes, ni, NF.Kind) == AstKind.Function && nd_get(nodes, nd_get(nodes, ni, NF.A), NF.Kind) != AstKind.StreamGen ? { ec_function(src, toks, nodes, kids, fresh, hs, his, hem, hnext, types, tp, tpn, b, ni, 0) }; j <- j + 1 }
    mode == 0 ? {
        ec_put(b, "\nint main(int argc, char **argv) {\n    tiq_argc = argc; tiq_argv = argv;\n")
        topbase = vec_len(kids); j <- 0; [j < n] { vec_push(kids, vec_get(tops, j)); j <- j + 1 }
        vec_push(oss, topbase); vec_push(ons, n); vec_push(oms, 0)
        j <- 0
        [j < n] {
            vec_set(oms, vec_len(oms) - 1, j)
            ni = vec_get(tops, j); k = nd_get(nodes, ni, NF.Kind)
            is_stream <- 0
            k == AstKind.Binding && nd_get(nodes, nd_get(nodes, ni, NF.A), NF.Kind) == AstKind.StreamGen ? { is_stream <- 1 }
            k != AstKind.Function && k != AstKind.StructDef && k != AstKind.EnumDef && k != AstKind.Import && k != AstKind.Extern && is_stream == 0 ? { ec_stmt(src, toks, nodes, kids, fresh, hs, his, hem, hnext, types, tp, tpn, b, ni, 1, oss, ons, oms) }
            j <- j + 1
        }
        ec_emit_frees(src, toks, nodes, kids, fresh, b, tops, 0, n, 1, "")
        pop13 = vec_pop(oss); pop14 = vec_pop(ons); pop15 = vec_pop(oms)
        ec_put(b, "    return 0;\n}\n\n")
    }
    j <- 0
    [j < n] {
        ni = vec_get(tops, j)
        nd_get(nodes, ni, NF.Kind) == AstKind.Binding && nd_get(nodes, nd_get(nodes, ni, NF.A), NF.Kind) == AstKind.StreamGen ? {
            ec_stream_def(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, tk_lex(src, toks, nd_get(nodes, ni, NF.Name)), nd_get(nodes, ni, NF.A), 0 - 1)
        }
        nd_get(nodes, ni, NF.Kind) == AstKind.Function && nd_get(nodes, nd_get(nodes, ni, NF.A), NF.Kind) == AstKind.StreamGen ? {
            ec_stream_def(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, tk_lex(src, toks, nd_get(nodes, ni, NF.Name)), nd_get(nodes, ni, NF.A), ni)
        }
        j <- j + 1
    }
    j <- 0; [j < n] { ni = vec_get(tops, j); nd_get(nodes, ni, NF.Kind) == AstKind.Function && nd_get(nodes, nd_get(nodes, ni, NF.A), NF.Kind) != AstKind.StreamGen ? { ec_function(src, toks, nodes, kids, fresh, hs, his, hem, hnext, types, tp, tpn, b, ni, 1) }; j <- j + 1 }
    0
}

// M16.3: mode 0 = program, 1 = lib (no entry point), 2 = C header.
// path seeds the header guard; it never reaches program/lib output.
emit_c_program path:str src:str toks:vec[Token] nodes:vec[int] kids:vec[int] tops:vec[int] types:vec[int] tp:vec[int] tpn:vec[str] mode:i64 : str -> {
    b = str_buf_new()
    mode == 2 ? { ec_header(b, path, src, toks, nodes, kids, tops, types, tp, tpn) }
    mode != 2 ? { ec_program_body(src, toks, nodes, kids, tops, types, tp, tpn, b, mode) }
    str_buf_to_str(b)
}
