            idx = vec_get(kids, s)
            alen = ec_array_len(types, tp, callee)
            ec_put(b, "((uint64_t)(")
            ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, idx)
            ec_put(b, ") < (uint64_t)("); ec_put(b, int_str(alen)); ec_put(b, ") ? ")
            ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, callee)
            ec_put(b, "["); ec_expr(src, toks, nodes, kids, hs, his, hem, types, tp, tpn, b, idx); ec_put(b, "] : (fprintf(stderr, \"tiq: index %lld out of bounds for array of length ")
            ec_put(b, int_str(alen)); ec_put(b, "\\n\", (long long)(")
