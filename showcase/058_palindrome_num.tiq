// 058: Palindrome number check
reverse_num n: i64 : i64 -> {
    rev <- 0
    x <- n
    [i <- 0..20] {
        x > 0 ? {
            rev <- rev * 10 + (x % 10)
            x <- x / 10
        } : 0
    }
    rev
}
is_palindrome n: i64 : bool -> n == reverse_num(n)
print(is_palindrome(12321))
print(is_palindrome(12345))
print(is_palindrome(1001))
