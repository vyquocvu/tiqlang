// 052: Collatz sequence length
collatz_steps n: i64 : i64 -> {
    steps = 0
    x <- n
    x > 1 ? {
        [i <- 0..1000] {
            x > 1 ? {
                x % 2 == 0 ? x <- x / 2 : x <- 3 * x + 1
                steps <- steps + 1
            } : 0
        }
    } : 0
    steps
}
print(collatz_steps(1))
print(collatz_steps(6))
print(collatz_steps(27))
